-- GENERATED by infra/github (local_file.expansions_seed) from
-- local.expansions. DO NOT EDIT BY HAND — run `terraform apply` in infra/github
-- after editing infra/github/expansions.tf, then commit the regenerated file.
--
-- The server applies this from SEED_DIR every boot (apps/novaworld_server/main.cpp
-- apply_seed). UPSERT keeps catalogue metadata in sync with Terraform while
-- preserving `version` (owned by the release pipeline: set_expansion_version on
-- POST /api/admin/expansions/<slug>/release). Idempotent across boots.
%{ for slug, e in expansions ~}

INSERT INTO expansions
    (game_id, slug, display_name, summary, version, package_type, install_subdir, featured, github_repo)
SELECT g.id, '${slug}', '${replace(e.display_name, "'", "''")}',
       '${replace(e.summary, "'", "''")}', '${e.version}', '${e.package_type}',
       '${e.install_subdir}', ${e.featured ? 1 : 0}, '${e.github_repo}'
FROM games g WHERE g.slug = '${e.game_slug}'
ON CONFLICT(slug) DO UPDATE SET
    display_name   = excluded.display_name,
    summary        = excluded.summary,
    package_type   = excluded.package_type,
    install_subdir = excluded.install_subdir,
    featured       = excluded.featured,
    github_repo    = excluded.github_repo,
    updated_at     = CURRENT_TIMESTAMP;
%{ endfor ~}
