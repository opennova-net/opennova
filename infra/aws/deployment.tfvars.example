# A deployment's Terraform variables: the NON-SECRET knobs.
#
# The toolbox passes infra/aws/<deployment>.tfvars to every `infra` run of that
# deployment (prod.tfvars for --deployment prod, staging.tfvars for
# --deployment staging; it takes no other deployment), with the deployment's
# name (TF_VAR_deployment). This file names every knob those two may set.
# It holds no secret, so committing it keeps every operator on the same knobs.
# No account id, ARN, bucket name or other account resource id goes here: the
# toolbox fills those and the region from the deployment's vault item,
# aws-<deployment> (TF_VAR_aws_account_id, TF_VAR_region, prod's
# TF_VAR_service_eip_allocation_id), and the provider refuses any other
# account's credentials.
# Never name it terraform.tfvars: Terraform would load that one into EVERY
# deployment's run (staging would then adopt prod's Elastic IP), so the
# toolbox refuses to run while one exists.
#
# The secrets come from the vault as TF_VAR_* at run time
# (deploy/env/terraform.env.tpl): cloudflare_api_token, cloudflare_zone_id,
# cloudflare_domain and the rest. Leave them out of this file (a value here
# would override the vault's).

# The service's programs (programs.tf): each task's size (cpu units, memory
# MiB: a Fargate pair) and its service's task counts; a field left out keeps
# its default. Web and worker scale on their CPU between min and max; data runs
# one fixed count (min = max = desired); max (with a deployment's extra tasks)
# sizes the database's max_connections.
# gate   = { cpu = 256, memory = 512, min = 1, max = 1, desired = 1 }
# lobby  = { cpu = 256, memory = 512, min = 1, max = 1, desired = 1 }
# web    = { cpu = 512, memory = 1024, min = 1, max = 1, desired = 1 }
# fleet  = { cpu = 256, memory = 512, min = 1, max = 1, desired = 1 }
# worker = { cpu = 512, memory = 1024, min = 1, max = 1, desired = 1 }
# data   = { cpu = 256, memory = 1024, min = 1, max = 1, desired = 1 }
# image_registry = "ghcr.io/opennova-net" # where the images are published (public packages)
# health_port    = 8081                   # every program's /livez (ONNET_HEALTH_PORT)

# Prod's gate address (service_eip_allocation_id, the Elastic IP retail clients
# use, in the prod account) is no knob here: the toolbox fills it from prod's
# vault item. Terraform adopts it and never manages it: it is the load
# balancer's zone-a address. Staging names none and gets an address of its own.

# The two availability zones, pinned once the stack exists so a change in the
# region's list never moves a subnet (./deploy/run.sh --deployment <deployment>
# infra output public_subnet_ids, then aws ec2 describe-subnets).
# azs = ["us-east-1a", "us-east-1b"]

# The database (database.tf): PostgreSQL 17 on RDS. Its master password comes
# from the vault (item rds-<deployment>); bump the version to send
# a changed one to RDS.
# db_instance_class          = "db.t4g.micro" # burstable, unlimited mode
# db_multi_az                = false          # true: a standby in the other zone
# db_pool_max                = 7              # connections per service process (6..64)
# db_service_processes       = 10             # processes max_connections is sized for
# cache_node_count           = 1              # 2..6: Valkey replicas that fail over on their own
# db_master_password_version = 1

# allowed_cidrs = ["0.0.0.0/0"] # the retail ports and the game machines' slots

# Cloudflare: domain + zone id come from the vault, NOT this file. Only the
# proxied toggle lives here.
cloudflare_web_proxied = true

# Outbound mail through Amazon SES (mail.tf): the local part the service sends
# as, through the deployment's own identity (support@<domain> on prod,
# support@staging.<domain> on staging); empty, the default, sends nothing.
# mail_sender = "support"

# Hosted game servers (fleet.tf, programs.tf; DEPLOY.md "Hosted game servers").
# hosted_enabled turns them on: the machines' templates and roles, the game
# data's store (the deployment's operations bucket under data/, which admins
# fill from the site's Game data page) and web's store policy. Before the apply
# that turns it on, the role boundary with the store's S3 actions is applied
# through the org stack (infra/aws/iam/README.md). The update service's
# listeners and record are there whether or not hosting is on.
# hosted_enabled         = false
# shared_instance_type   = "t3a.medium"  # unlimited CPU credits; x86_64, no t2
# own_instance_type      = "c7a.medium"
# shared_slots           = 6             # K servers per shared machine (1..32)
# fleet_max_shared       = 2
# fleet_max_own          = 2
# fleet_max_addresses    = 0             # static addresses sold; above 0 makes the play zone (raise the EIP quota first)
# fleet_idle_minutes     = 30
# machine_root_volume_gb = 40            # the OS, docker, the images and the data trees
# fleet_ami              = "al2023-ami-ecs-hvm-2023.0.20261009-kernel-6.1-x86_64" # the exact ECS-optimized AL2023 image name, required with hosting
# update_ports           = [20044, 20556, 21068, 21580] # retail UPDATE.EXE's, fixed

# Alarms and budgets (observability.tf), the deployment's account's. The alert
# address comes from the vault (item alerts, field email).
# budget_monthly_usd         = 250
# budget_egress_gb           = 1500
# cost_anomaly_monitor       = true      # false if the account has one already
# cost_anomaly_threshold_usd = 20
# log_retention_days         = 30
