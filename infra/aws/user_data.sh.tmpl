#!/bin/bash
set -euxo pipefail

# The target host's ONLY dependency is docker (deploys drive it remotely over
# DOCKER_HOST=ssh://). No git, no rsync, no python.
export DEBIAN_FRONTEND=noninteractive
apt-get update
apt-get install -y --no-install-recommends docker.io
if ! apt-get install -y docker-compose-plugin; then
  apt-get install -y docker-compose
fi

systemctl enable --now docker

# ensure ubuntu user can run docker (DOCKER_HOST=ssh://ubuntu@... deploys)
usermod -aG docker ubuntu
