{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Alarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:DescribeAlarmHistory"
      ],
      "Resource": "arn:aws:cloudwatch:${region}:${account_id}:alarm:opennova-*"
    },
    {
      "Sid": "MetricsRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DescribeAlarmsForMetric",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:GetDataProtectionPolicy",
        "sns:Subscribe",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:${region}:${account_id}:opennova-*"
    },
    {
      "Sid": "AlertsSubscriptionsHaveNoResourceScope",
      "Effect": "Allow",
      "Action": [
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:Unsubscribe"
      ],
      "Resource": "*"
    },
    {
      "Sid": "HealthChecks",
      "Effect": "Allow",
      "Action": [
        "route53:GetHealthCheck",
        "route53:UpdateHealthCheck",
        "route53:DeleteHealthCheck",
        "route53:GetHealthCheckStatus",
        "route53:GetHealthCheckLastFailureReason",
        "route53:ChangeTagsForResource",
        "route53:ListTagsForResource",
        "route53:ListTagsForResources"
      ],
      "Resource": "arn:aws:route53:::healthcheck/*"
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:ViewBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::${account_id}:budget/opennova-*"
    },
    {
      "Sid": "AnomalyDetectionCreateTagged",
      "Effect": "Allow",
      "Action": [
        "ce:CreateAnomalyMonitor",
        "ce:CreateAnomalySubscription"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "AnomalyDetectionManageTagged",
      "Effect": "Allow",
      "Action": [
        "ce:UpdateAnomalyMonitor",
        "ce:DeleteAnomalyMonitor",
        "ce:UpdateAnomalySubscription",
        "ce:DeleteAnomalySubscription",
        "ce:TagResource",
        "ce:UntagResource"
      ],
      "Resource": [
        "arn:aws:ce::${account_id}:anomalymonitor/*",
        "arn:aws:ce::${account_id}:anomalysubscription/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "CreateHealthCheckAndZoneNoResourceScope",
      "Effect": "Allow",
      "Action": [
        "route53:CreateHealthCheck",
        "route53:CreateHostedZone"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CostQuotaAndDiagnosticsRead",
      "Effect": "Allow",
      "Action": [
        "route53:ListHealthChecks",
        "route53:ListHostedZonesByName",
        "route53:ListHostedZones",
        "budgets:ViewBudget",
        "ce:Get*",
        "ce:List*",
        "ce:Describe*",
        "servicequotas:Get*",
        "servicequotas:List*",
        "sts:DecodeAuthorizationMessage"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PrivateZones",
      "Effect": "Allow",
      "Action": [
        "route53:GetHostedZone",
        "route53:DeleteHostedZone",
        "route53:UpdateHostedZoneComment",
        "route53:ListResourceRecordSets",
        "route53:ChangeResourceRecordSets",
        "route53:AssociateVPCWithHostedZone",
        "route53:DisassociateVPCFromHostedZone",
        "route53:ChangeTagsForResource",
        "route53:ListTagsForResource",
        "route53:GetChange"
      ],
      "Resource": [
        "arn:aws:route53:::hostedzone/*",
        "arn:aws:route53:::change/*"
      ]
    },
    {
      "Sid": "MailIdentities",
      "Effect": "Allow",
      "Action": [
        "ses:CreateEmailIdentity",
        "ses:GetEmailIdentity",
        "ses:DeleteEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes",
        "ses:PutEmailIdentityDkimSigningAttributes",
        "ses:TagResource",
        "ses:UntagResource",
        "ses:ListTagsForResource"
      ],
      "Resource": "arn:aws:ses:${region}:${account_id}:identity/*"
    }
  ]
}
