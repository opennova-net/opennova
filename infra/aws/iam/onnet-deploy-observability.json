{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Alarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DeleteAlarms",
        "cloudwatch:TagResource",
        "cloudwatch:UntagResource",
        "cloudwatch:ListTagsForResource",
        "cloudwatch:DescribeAlarmHistory"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:310045376545:alarm:opennova-*"
    },
    {
      "Sid": "MetricsRead",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DescribeAlarmsForMetric",
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AlertsTopic",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:DeleteTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:GetDataProtectionPolicy",
        "sns:Subscribe",
        "sns:Unsubscribe",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes",
        "sns:ListSubscriptionsByTopic",
        "sns:TagResource",
        "sns:UntagResource",
        "sns:ListTagsForResource"
      ],
      "Resource": "arn:aws:sns:us-east-1:310045376545:opennova-*"
    },
    {
      "Sid": "HealthChecks",
      "Effect": "Allow",
      "Action": [
        "route53:GetHealthCheck",
        "route53:UpdateHealthCheck",
        "route53:DeleteHealthCheck",
        "route53:GetHealthCheckStatus",
        "route53:GetHealthCheckLastFailureReason",
        "route53:ChangeTagsForResource",
        "route53:ListTagsForResource",
        "route53:ListTagsForResources"
      ],
      "Resource": "arn:aws:route53:::healthcheck/*"
    },
    {
      "Sid": "Budgets",
      "Effect": "Allow",
      "Action": [
        "budgets:ModifyBudget",
        "budgets:ViewBudget",
        "budgets:TagResource",
        "budgets:UntagResource",
        "budgets:ListTagsForResource"
      ],
      "Resource": "arn:aws:budgets::310045376545:budget/opennova-*"
    },
    {
      "Sid": "AnomalyDetectionCreateTagged",
      "Effect": "Allow",
      "Action": [
        "ce:CreateAnomalyMonitor",
        "ce:CreateAnomalySubscription"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "AnomalyDetectionManageTagged",
      "Effect": "Allow",
      "Action": [
        "ce:UpdateAnomalyMonitor",
        "ce:DeleteAnomalyMonitor",
        "ce:UpdateAnomalySubscription",
        "ce:DeleteAnomalySubscription",
        "ce:TagResource",
        "ce:UntagResource"
      ],
      "Resource": [
        "arn:aws:ce::310045376545:anomalymonitor/*",
        "arn:aws:ce::310045376545:anomalysubscription/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "CreateHealthCheckNoResourceScope",
      "Effect": "Allow",
      "Action": "route53:CreateHealthCheck",
      "Resource": "*"
    },
    {
      "Sid": "CostQuotaAndDiagnosticsRead",
      "Effect": "Allow",
      "Action": [
        "route53:ListHealthChecks",
        "budgets:ViewBudget",
        "ce:Get*",
        "ce:List*",
        "ce:Describe*",
        "servicequotas:Get*",
        "servicequotas:List*",
        "sts:DecodeAuthorizationMessage"
      ],
      "Resource": "*"
    }
  ]
}
