{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SessionChannels",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation",
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DeploymentParameters",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath",
        "ssm:PutParameter"
      ],
      "Resource": "arn:aws:ssm:${region}:${account_id}:parameter/opennova/*"
    },
    {
      "Sid": "OpsBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::opennova-*"
    },
    {
      "Sid": "OpsBucketObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:AbortMultipartUpload"
      ],
      "Resource": "arn:aws:s3:::opennova-*/*"
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:${region}:${account_id}:log-group:/opennova/*",
        "arn:aws:logs:${region}:${account_id}:log-group:/opennova/*:log-stream:*"
      ]
    },
    {
      "Sid": "AwsManagedKeysThroughSsmAndEbs",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:ReEncrypt*",
        "kms:CreateGrant",
        "kms:DescribeKey"
      ],
      "Resource": "arn:aws:kms:${region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": [
            "ssm.${region}.amazonaws.com",
            "ec2.${region}.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "LaunchMachinesTagged",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": "arn:aws:ec2:${region}:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/opennova:hosted": "1"
        },
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "LaunchMachineParts",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:${region}:${account_id}:volume/*",
        "arn:aws:ec2:${region}:${account_id}:network-interface/*",
        "arn:aws:ec2:${region}::image/*"
      ]
    },
    {
      "Sid": "LaunchFromOpenNovaNetworkTemplatesSnapshots",
      "Effect": "Allow",
      "Action": "ec2:RunInstances",
      "Resource": [
        "arn:aws:ec2:${region}:${account_id}:subnet/*",
        "arn:aws:ec2:${region}:${account_id}:security-group/*",
        "arn:aws:ec2:${region}:${account_id}:launch-template/*",
        "arn:aws:ec2:${region}::snapshot/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "TagMachinesAtLaunch",
      "Effect": "Allow",
      "Action": "ec2:CreateTags",
      "Resource": [
        "arn:aws:ec2:${region}:${account_id}:instance/*",
        "arn:aws:ec2:${region}:${account_id}:volume/*"
      ],
      "Condition": {
        "StringEquals": {
          "ec2:CreateAction": "RunInstances"
        }
      }
    },
    {
      "Sid": "EndMachines",
      "Effect": "Allow",
      "Action": "ec2:TerminateInstances",
      "Resource": "arn:aws:ec2:${region}:${account_id}:instance/*",
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/opennova:hosted": "1"
        },
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "DescribeMachines",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances",
        "ec2:DescribeLaunchTemplates",
        "ec2:DescribeLaunchTemplateVersions"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassMachineRoleToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/opennova-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    },
    {
      "Sid": "SendMail",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": "arn:aws:ses:${region}:${account_id}:identity/*"
    },
    {
      "Sid": "ListParameterNames",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "RunOpenNovaTasks",
      "Effect": "Allow",
      "Action": "ecs:RunTask",
      "Resource": [
        "arn:aws:ecs:${region}:${account_id}:task-definition/opennova-*",
        "arn:aws:ecs:${region}:${account_id}:task-definition/opennova-*:*"
      ],
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:${region}:${account_id}:cluster/opennova-*"
        }
      }
    },
    {
      "Sid": "DeployRevisions",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTaskDefinition",
        "ecs:RegisterTaskDefinition"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PointOpenNovaServicesAndTagTasks",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeServices",
        "ecs:UpdateService",
        "ecs:TagResource"
      ],
      "Resource": [
        "arn:aws:ecs:${region}:${account_id}:service/opennova-*/*",
        "arn:aws:ecs:${region}:${account_id}:task/opennova-*/*",
        "arn:aws:ecs:${region}:${account_id}:task-definition/opennova-*"
      ]
    },
    {
      "Sid": "ListOpenNovaTasks",
      "Effect": "Allow",
      "Action": "ecs:ListTasks",
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "ecs:cluster": "arn:aws:ecs:${region}:${account_id}:cluster/opennova-*"
        }
      }
    },
    {
      "Sid": "ReadOpenNovaTasksDatabaseCache",
      "Effect": "Allow",
      "Action": [
        "ecs:DescribeTasks",
        "rds:DescribeDBInstances",
        "elasticache:DescribeReplicationGroups"
      ],
      "Resource": [
        "arn:aws:ecs:${region}:${account_id}:task/opennova-*/*",
        "arn:aws:rds:${region}:${account_id}:db:opennova-*",
        "arn:aws:elasticache:${region}:${account_id}:replicationgroup:opennova-*"
      ]
    },
    {
      "Sid": "ReadTargetHealth",
      "Effect": "Allow",
      "Action": "elasticloadbalancing:DescribeTargetHealth",
      "Resource": "*"
    },
    {
      "Sid": "PassOpenNovaRolesToEcsTasksAndScheduler",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::${account_id}:role/opennova-*",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "ecs-tasks.amazonaws.com",
            "scheduler.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "PointBackupSchedule",
      "Effect": "Allow",
      "Action": [
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule"
      ],
      "Resource": "arn:aws:scheduler:${region}:${account_id}:schedule/default/opennova-*"
    }
  ]
}
