{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateVpcGatewayAddressTemplateTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:CreateInternetGateway",
        "ec2:AllocateAddress",
        "ec2:CreateLaunchTemplate"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:310045376545:vpc/*",
        "arn:aws:ec2:us-east-1:310045376545:internet-gateway/*",
        "arn:aws:ec2:us-east-1:310045376545:elastic-ip/*",
        "arn:aws:ec2:us-east-1:310045376545:launch-template/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "CreateInVpcTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:310045376545:subnet/*",
        "arn:aws:ec2:us-east-1:310045376545:route-table/*",
        "arn:aws:ec2:us-east-1:310045376545:security-group/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "CreateInterfaceAndRulesTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNetworkInterface",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:310045376545:network-interface/*",
        "arn:aws:ec2:us-east-1:310045376545:security-group-rule/*"
      ],
      "Condition": {
        "StringLike": {
          "aws:RequestTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "ManageTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:ModifyVpcAttribute",
        "ec2:DeleteVpc",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:DeleteInternetGateway",
        "ec2:CreateSubnet",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:CreateRouteTable",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:RunInstances"
      ],
      "Resource": "*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        }
      }
    },
    {
      "Sid": "ReleaseAddressesExceptProds",
      "Effect": "Allow",
      "Action": "ec2:ReleaseAddress",
      "Resource": "arn:aws:ec2:us-east-1:310045376545:elastic-ip/*",
      "Condition": {
        "StringLike": {
          "aws:ResourceTag/opennova:deployment": "opennova-*"
        },
        "StringNotEquals": {
          "aws:ResourceTag/opennova:deployment": "opennova-server"
        }
      }
    },
    {
      "Sid": "ManageInProdVpc",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:ModifySubnetAttribute",
        "ec2:DeleteSubnet",
        "ec2:DeleteRouteTable",
        "ec2:CreateRoute",
        "ec2:ReplaceRoute",
        "ec2:DeleteRoute",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "ec2:CreateNetworkInterface",
        "ec2:DeleteNetworkInterface",
        "ec2:ModifyNetworkInterfaceAttribute",
        "ec2:AssignPrivateIpAddresses",
        "ec2:UnassignPrivateIpAddresses",
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:RunInstances"
      ],
      "Resource": "*",
      "Condition": {
        "ArnEquals": {
          "ec2:Vpc": "arn:aws:ec2:us-east-1:310045376545:vpc/vpc-039f64354e9a338de"
        }
      }
    },
    {
      "Sid": "ProdVpcAndGatewayUntilTagged",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags",
        "ec2:ModifyVpcAttribute",
        "ec2:AttachInternetGateway",
        "ec2:DetachInternetGateway",
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:AssociateRouteTable",
        "ec2:DisassociateRouteTable",
        "ec2:ReplaceRouteTableAssociation"
      ],
      "Resource": [
        "arn:aws:ec2:us-east-1:310045376545:vpc/vpc-039f64354e9a338de",
        "arn:aws:ec2:us-east-1:310045376545:internet-gateway/igw-04b9394fa71df326a"
      ]
    },
    {
      "Sid": "ProdElasticIpAssociationAndTag",
      "Effect": "Allow",
      "Action": [
        "ec2:AssociateAddress",
        "ec2:DisassociateAddress",
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:aws:ec2:us-east-1:310045376545:elastic-ip/eipalloc-05d28b7cdb8ae7c0a"
    }
  ]
}
