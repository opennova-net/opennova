override_resource {
  target          = aws_sesv2_email_identity.domain
  override_during = plan
  values = {
    dkim_signing_attributes = { tokens = ["tok1", "tok2", "tok3"] }
  }
}

variables {
  deployment         = "staging"
  aws_account_id     = "123456789012"
  region             = "us-east-1"
  db_master_password = "0123456789abcdef0123456789abcdef"
  cache_auth_token   = "fedcba9876543210fedcba9876543210"
  cloudflare_zone_id = "0123456789abcdef0123456789abcdef"
  cloudflare_domain  = "example.com"
  email_forward_to   = "maintainer@mail.example.org"
  mail_sender        = "support"
}

run "mail_identities_are_stagings_own" {
  command = plan

  assert {
    condition = (
      aws_sesv2_email_identity.domain[0].email_identity == "staging.example.com" &&
      aws_sesv2_email_identity_mail_from_attributes.domain[0].mail_from_domain == "bounce.staging.example.com" &&
      aws_sesv2_email_identity.forward_to[0].email_identity == "maintainer@mail.example.org"
    )
    error_message = "staging's account verifies staging.<domain> (MAIL FROM bounce.staging.<domain>) and its sandbox's recipient, its own identities"
  }
  assert {
    condition = (
      cloudflare_record.mail_from_mx[0].name == "bounce.staging" && cloudflare_record.mail_from_spf[0].name == "bounce.staging" &&
      length(cloudflare_record.mail_dkim) == 3 &&
      alltrue([for i, r in cloudflare_record.mail_dkim : r.name == "tok${i + 1}._domainkey.staging" && r.content == "tok${i + 1}.dkim.amazonses.com"])
    )
    error_message = "staging's DKIM and MAIL FROM records sit under staging in the zone, apart from prod's"
  }
  assert {
    condition = (
      one([for st in data.aws_iam_policy_document.mail[0].statement :
        toset(st.resources) == toset(["arn:aws:ses:us-east-1:123456789012:identity/*"]) && length([for c in st.condition : c if c.variable == "ses:FromAddress" && length(c.values) == 1 && contains(c.values, "support@staging.example.com")]) == 1
      ]) &&
      { for e in jsondecode(aws_ecs_task_definition.program["worker"].container_definitions)[0].environment : e.name => e.value }["ONNET_MAIL_FROM"] == "support@staging.example.com" &&
      { for e in jsondecode(aws_ecs_task_definition.program["worker"].container_definitions)[0].environment : e.name => e.value }["ONNET_SITE_URL"] == "https://staging.example.com"
    )
    error_message = "staging's worker sends as support@staging.<domain> through staging's identities alone, its links to staging's site"
  }
}
