<!-- OpenNova's armory, authored from scratch: the WEAPON screen the game opens
     in a mission (the use key inside an armory's volume, docs/mnu/menu-re.md
     "In-game armory"). The game fills its controls by name: the class spin
     (PLAYER_CLASS, live only in a network session), the weapon lists by
     category (PRIMARY, SECONDARY, ACCESSORY, each with its clip-count, round-type
     and second-ammo combos), the grenade counts (GRENADE_AMMO1..3), the picked
     weapons' loadout_menu_icon pictures over the blank *_ICON windows, and the
     weight line (STATIC_TOTAL_WEIGHT); ACCEPT applies the kit, CANCEL leaves
     it. Every control the game registers is here, so it finds each one it
     reads. Literal strings, hex colors and opennova.fnt, as sp.mnu. -->
<SCREEN>
	<NAME>WEAPON</NAME>
	<WINDOW type="window" name="MAIN">
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<FONT>
			<NAME>opennova.fnt</NAME>
			<DEFAULT_FG>FFD8DEE4</DEFAULT_FG>
			<MOUSEOVER_FG>FFFFC040</MOUSEOVER_FG>
			<SELECTED_FG>FFFF8000</SELECTED_FG>
			<DISABLED_FG>FF545252</DISABLED_FG>
		</FONT>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<WINDOW type="window" name="WEAPON_FRAME">
			<APPEARANCE type="color" state="default">FF0B1015</APPEARANCE>
			<APPEARANCE type="outline" state="default">FF3A4550</APPEARANCE>
			<POSITION>
				<LEFT>140</LEFT>
				<TOP>50</TOP>
				<RIGHT>660</RIGHT>
				<BOTTOM>550</BOTTOM>
			</POSITION>
			<WINDOW type="static" name="TITLE">
				<FONT>
					<NAME>opennova.fnt</NAME>
					<DEFAULT_FG>FFFFC040</DEFAULT_FG>
				</FONT>
				<POSITION>
					<LEFT>0</LEFT>
					<TOP>10</TOP>
					<RIGHT>520</RIGHT>
					<BOTTOM>30</BOTTOM>
				</POSITION>
				<STRING justify="CENTER" vjustify="CENTER">ARMORY</STRING>
			</WINDOW>
			<WINDOW type="static" name="STATIC_PLAYER_CLASS">
				<POSITION>
					<LEFT>20</LEFT>
					<TOP>42</TOP>
					<RIGHT>160</RIGHT>
					<BOTTOM>64</BOTTOM>
				</POSITION>
				<STRING justify="LEFT" vjustify="CENTER">CLASS</STRING>
			</WINDOW>
			<WINDOW type="spinlist" name="PLAYER_CLASS">
				<APPEARANCE type="outline" state="default">FF3A4550</APPEARANCE>
				<APPEARANCE type="outline" state="mouseover">FFFFC040</APPEARANCE>
				<POSITION>
					<LEFT>290</LEFT>
					<TOP>42</TOP>
					<RIGHT>480</RIGHT>
					<BOTTOM>64</BOTTOM>
				</POSITION>
				<ITEMS justify="CENTER" vjustify="CENTER"></ITEMS>
				<SPINUP>
					<APPEARANCE type="outline" state="default">FF3A4550</APPEARANCE>
					<APPEARANCE type="outline" state="mouseover">FFFFC040</APPEARANCE>
