//////////////////////////////////////////////////////////////////////
//
// Character Def File
//
// Attributes: AutoScope KnifeBonus Medic  WaterGirl
//
// Notes: Cammo IDs are listed in itemsid.h
//
// HPBONUS is added to standard 8 hitpoints
// 1.0 generally denotes an unmodified rate.  higher is more exagerated, generally
// NL Cheat to change chars: setchar n    (n = 1-5)
//////////////////////////////////////////////////////////////////////
//

//	CHAR_TYPE_DELTASP				(1)		// generic single player DELTA character
//	CHAR_TYPE_RANGERSP				(2)		// generic single player RANGER character
//	CHAR_TYPE_TENTHMTNSP			(3)		// generic single player TENTHMTN character
//	CHAR_TYPE_DELTAMP				(4)		// multiplayer basic (unclassed) DELTA
//	CHAR_TYPE_DELTAMP_MEDIC			(5)		// multiplayer medic
//	CHAR_TYPE_DELTAMP_SNIPER		(6)		// multiplayer sniper
//	CHAR_TYPE_DELTAMP_GUNNER		(7)		// multiplayer gunner
//	CHAR_TYPE_DELTAMP_RIFLEMAN		(8)		// multiplayer rifleman
//	CHAR_TYPE_DELTAMP_ENGINEER		(9)		// multiplayer engineer
//	CHAR_TYPE_DELTAMP_PILOT			(?)		// multiplayer pilot
//	CHAR_TYPE_DELTAMP_CQB			(?)		// multiplayer cqb
//
//	1-3  will be used for single player missions, where the mission dictates what role you are playing
//
//	 4   was a placeholder for multiplayer games, no longer used
//
//	5-9  are our multiplayer character 'personas', to allow character selection ala DFLW 



