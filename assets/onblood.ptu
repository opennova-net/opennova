	gravity_mask	= 1.000, 1.000, 1.000;
	drag	= 0.000;
	spread	= 14.000;
	spread_skip	= 0.000;
	orbitalspeed	= 0.000;
	orbitalspeed_adj	= 0.000;
	orbital_axis	= 0.000, 1.000, 0.000;
	graphic1 =	onfxdrp1.tga, blend;
	g1_flip_frames	= 1;
	g1_flip_rate	= 8;
	g1_color1	= 128, 6, 6;
	g1_color2	= 108, 0, 0;
