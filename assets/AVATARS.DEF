nationality  N00  AV_NAT_UNITEDSTATES
{
	alignment	good

	division  D00  AV_DIV_SEAL skipdemo
	{
		combo   001     JO_HEAD_SEAL            JO_BODY_SEAL_1      JO_ARMS_US_1
		combo   002     JO_HEAD_SEAL_CAMO_1     JO_BODY_SEAL_1      JO_ARMS_US_1
		combo   003     JO_HEAD_SEAL_CAMO_2     JO_BODY_SEAL_2      JO_ARMS_US_1
		combo   004     JO_HEAD_SEAL_CAMO_2     JO_BODY_DELTA_3     JO_ARMS_GREEN_1
	}

	division  D01  AV_DIV_DELTAFORCE skipdemo
	{
		combo   001     JO_HEAD_DELTA_3         JO_BODY_DELTA_1     JO_ARMS_BLACK
		combo   002     JO_HEAD_DELTA_3         JO_BODY_SEAL_2      JO_ARMS_US_1
		combo   003     JO_HEAD_DELTA_3         JO_BODY_DELTA_3     JO_ARMS_GREEN_1
		combo   004     JO_HEAD_DELTA_1         JO_BODY_DELTA_1     JO_ARMS_BLACK
		combo   005     JO_HEAD_DELTA_2         JO_BODY_DELTA_2     JO_ARMS_US_2
