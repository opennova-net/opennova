// voice (attached to heads)
//		1   BM1	=	US Male
//		2	BM2	=	UK Male
//		3	BM3	=	German Male
//		4	BM4	=	Russian Male
//		5	BM5	=	French Male
//		6	BM6	=	Indonesian Male
//		7	BF1	=	US Female
//		8	BF2	=	UK Female
//		9	BM6	=	Indonesian Male	// DO NOT USE - Duplicate of 6, so use 6 instead
//		10	RM2	=	Indonesian Male 2
//		11	RF1	=	Indonesian Female


