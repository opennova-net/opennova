


begin "default"		 default

	medloopfadeinstart   	20 	
	medloopfadeinend    	30 	
	medloopfadeoutstart  	60 	
	medloopfadeoutend    	90 	

	medlooppitchstart   	20 	
	medlooppitchstartp  	20	
	medlooppitchend     	80 	
	medlooppitchendp    	150	

	crsloopfadeinstart   	60 
	crsloopfadeinend     	80 
	crslooppitchstartp   	78 
	crslooppitchendp     	100

end 



begin "SP_Apache1"		 Flyable APACHE
