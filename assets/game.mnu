<SCREEN>
  <NAME>INGAME</NAME>
  <MUSICVAR>4</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="CUSTOM" state="DEFAULT"></APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="window" name="MAIN_WRAPPER">
      <POSITION>
        <LEFT>290</LEFT>
        <TOP>180</TOP>
        <RIGHT>510</RIGHT>
        <BOTTOM>420</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="static" name="STATIC_PAUSED">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>8</TOP>
          <RIGHT>220</RIGHT>
          <BOTTOM>52</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <FONT>
          <NAME>%IMPACT_FONTNAME%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">PAUSED</STRING>
      </WINDOW>
      <WINDOW type="button" name="HIDDEN_BACK">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>66</TOP>
          <RIGHT>200</RIGHT>
          <BOTTOM>98</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">RESUME</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="OPTIONS">
        <ACTION type="WINDOW" state="SHOW">OPTIONS_WRAPPER</ACTION>
        <ACTION type="WINDOW" state="HIDE">MAIN_WRAPPER</ACTION>
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>106</TOP>
          <RIGHT>200</RIGHT>
          <BOTTOM>138</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">OPTIONS</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="RESTART">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>146</TOP>
          <RIGHT>200</RIGHT>
          <BOTTOM>178</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">RESTART</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="ABORT">
        <ACTION type="WINDOW" state="SHOW">CONFIRM_EXIT</ACTION>
        <ACTION type="WINDOW" state="HIDE">MAIN_WRAPPER</ACTION>
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>186</TOP>
          <RIGHT>200</RIGHT>
          <BOTTOM>218</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">LEAVE MISSION</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="CONFIRM_EXIT" HIDDEN MODAL>
      <POSITION>
        <LEFT>250</LEFT>
        <TOP>240</TOP>
        <RIGHT>550</RIGHT>
        <BOTTOM>360</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="static" name="STATIC_CONFIRM">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>14</TOP>
          <RIGHT>300</RIGHT>
          <BOTTOM>44</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">Leave the mission?</STRING>
      </WINDOW>
      <WINDOW type="button" name="CONFIRM_YES">
        <HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
        <ACTION type="WINDOW" state="SHOW">MAIN_WRAPPER</ACTION>
        <ACTION type="WINDOW" state="HIDE">CONFIRM_EXIT</ACTION>
        <POSITION>
          <LEFT>30</LEFT>
          <TOP>70</TOP>
          <RIGHT>140</RIGHT>
          <BOTTOM>100</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">YES</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="CONFIRM_NO">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <ACTION type="WINDOW" state="SHOW">MAIN_WRAPPER</ACTION>
        <ACTION type="WINDOW" state="HIDE">CONFIRM_EXIT</ACTION>
        <POSITION>
          <LEFT>160</LEFT>
          <TOP>70</TOP>
          <RIGHT>270</RIGHT>
          <BOTTOM>100</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">NO</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="OPTIONS_WRAPPER" HIDDEN>
      <POSITION>
        <LEFT>30</LEFT>
        <TOP>40</TOP>
        <RIGHT>770</RIGHT>
        <BOTTOM>560</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="radio" name="RADIO_TAB_VIDEO" CHECKED>
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="SHOW">TAB_VIDEO</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_AUDIO</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_CONTROLS</ACTION>
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>16</TOP>
          <RIGHT>136</RIGHT>
          <BOTTOM>44</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">VIDEO</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="radio" name="RADIO_TAB_AUDIO">
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="HIDE">TAB_VIDEO</ACTION>
        <ACTION type="WINDOW" state="SHOW">TAB_AUDIO</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_CONTROLS</ACTION>
        <POSITION>
          <LEFT>144</LEFT>
          <TOP>16</TOP>
          <RIGHT>260</RIGHT>
          <BOTTOM>44</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">AUDIO</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="radio" name="RADIO_TAB_CONTROLS">
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="HIDE">TAB_VIDEO</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_AUDIO</ACTION>
        <ACTION type="WINDOW" state="SHOW">TAB_CONTROLS</ACTION>
        <POSITION>
          <LEFT>268</LEFT>
          <TOP>16</TOP>
          <RIGHT>384</RIGHT>
          <BOTTOM>44</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">CONTROLS</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="window" name="TAB_VIDEO">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>50</TOP>
          <RIGHT>720</RIGHT>
          <BOTTOM>446</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <WINDOW type="static" name="STATIC_RESOLUTION">
          <POSITION>
            <LEFT>24</LEFT>
            <TOP>16</TOP>
            <RIGHT>224</RIGHT>
            <BOTTOM>40</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">RESOLUTION</STRING>
        </WINDOW>
        <WINDOW type="combobox" name="RESOLUTION">
          <POSITION>
            <LEFT>230</LEFT>
            <TOP>16</TOP>
            <RIGHT>420</RIGHT>
            <BOTTOM>40</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER" edge="8"></STRING>
          <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
          <LIST_BOX>
            <POSITION>
              <LEFT>0</LEFT>
              <TOP>24</TOP>
              <RIGHT>190</RIGHT>
              <BOTTOM>136</BOTTOM>
            </POSITION>
            <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
            <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
            <ITEMS justify="LEFT" vjustify="CENTER">
              <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
              <ITEM value="4">640 X 480</ITEM>
              <ITEM value="5">800 X 600</ITEM>
              <ITEM value="6">1024 X 768</ITEM>
              <ITEM value="7">1280 X 1024</ITEM>
              <ITEM value="8">1600 X 1200</ITEM>
            </ITEMS>
            <MIN_ITEM_HEIGHT>22</MIN_ITEM_HEIGHT>
          </LIST_BOX>
        </WINDOW>
        <WINDOW type="static" name="STATIC_GAMMA">
          <POSITION>
            <LEFT>24</LEFT>
            <TOP>50</TOP>
            <RIGHT>224</RIGHT>
            <BOTTOM>74</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">BRIGHTNESS</STRING>
        </WINDOW>
        <WINDOW type="scroll" name="GAMMA">
          <POSITION>
            <LEFT>230</LEFT>
            <TOP>54</TOP>
            <RIGHT>420</RIGHT>
            <BOTTOM>70</BOTTOM>
          </POSITION>
          <WIDTH>14</WIDTH>
          <ORIENTATION>HORIZONTAL</ORIENTATION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%DEF_TEXT_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="DISABLED">%TRIM_COLOR%</SHUTTLE>
          <SCROLLUP type="COLOR" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SCROLLUP>
          <SCROLLDOWN type="COLOR" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </WINDOW>
        <WINDOW type="static" name="STATIC_OBJECTDETAIL">
          <POSITION>
            <LEFT>24</LEFT>
            <TOP>84</TOP>
            <RIGHT>224</RIGHT>
            <BOTTOM>108</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">OBJECT DETAIL</STRING>
        </WINDOW>
        <WINDOW type="combobox" name="OBJECTDETAIL">
          <POSITION>
            <LEFT>230</LEFT>
            <TOP>84</TOP>
            <RIGHT>420</RIGHT>
            <BOTTOM>108</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER" edge="8"></STRING>
          <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
