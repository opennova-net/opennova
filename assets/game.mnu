            <RIGHT>200</RIGHT>
            <BOTTOM>346</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">MOUSE SENSITIVITY</STRING>
        </WINDOW>
        <WINDOW type="scroll" name="MOUSE_SENSITIVITY">
          <POSITION>
            <LEFT>16</LEFT>
            <TOP>350</TOP>
            <RIGHT>200</RIGHT>
            <BOTTOM>366</BOTTOM>
          </POSITION>
          <WIDTH>14</WIDTH>
          <ORIENTATION>HORIZONTAL</ORIENTATION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%DEF_TEXT_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="DISABLED">%TRIM_COLOR%</SHUTTLE>
          <SCROLLUP type="COLOR" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SCROLLUP>
          <SCROLLDOWN type="COLOR" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </WINDOW>
        <WINDOW type="table" name="CONTROL_MAPPING">
          <POSITION>
            <LEFT>216</LEFT>
            <TOP>64</TOP>
            <RIGHT>684</RIGHT>
            <BOTTOM>382</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
          <ITEMS>
            <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
            <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          </ITEMS>
          <COLUMN count="3" spacing="0">
            <HEADER justify="CENTER" vjustify="CENTER" column="0" sort="A" width="110">CATEGORY</HEADER>
            <HEADER justify="CENTER" vjustify="CENTER" column="1" sort="A" width="190">ACTION</HEADER>
            <HEADER justify="CENTER" vjustify="CENTER" column="2" sort="A" width="140">CONTROL</HEADER>
            <BODY justify="LEFT" vjustify="CENTER" column="0"></BODY>
            <BODY justify="LEFT" vjustify="CENTER" column="1"></BODY>
            <BODY justify="LEFT" vjustify="CENTER" column="2"></BODY>
          </COLUMN>
          <MIN_ITEM_HEIGHT>22</MIN_ITEM_HEIGHT>
          <SCROLLBAR>
            <POSITION>
              <LEFT>452</LEFT>
              <TOP>0</TOP>
              <RIGHT>468</RIGHT>
              <BOTTOM>318</BOTTOM>
            </POSITION>
            <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
            <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
            <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
            <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
            <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
            <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
            <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
            <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
            <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
            <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
          </SCROLLBAR>
        </WINDOW>
      </WINDOW>
      <WINDOW type="window" name="QUERY_WINDOW" HIDDEN MODAL>
        <POSITION>
          <LEFT>250</LEFT>
          <TOP>230</TOP>
          <RIGHT>550</RIGHT>
          <BOTTOM>350</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <WINDOW type="static" name="STATIC_QUESTION">
          <POSITION>
            <LEFT>0</LEFT>
            <TOP>12</TOP>
            <RIGHT>300</RIGHT>
            <BOTTOM>40</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">Restore the default controls?</STRING>
        </WINDOW>
        <WINDOW type="button" name="QUERY_YES">
          <ACTION type="WINDOW" state="HIDE">QUERY_WINDOW</ACTION>
          <POSITION>
            <LEFT>30</LEFT>
            <TOP>66</TOP>
            <RIGHT>140</RIGHT>
            <BOTTOM>96</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">YES</STRING>
          <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
          <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
        </WINDOW>
        <WINDOW type="button" name="QUERY_NO">
          <ACTION type="WINDOW" state="HIDE">QUERY_WINDOW</ACTION>
          <POSITION>
            <LEFT>160</LEFT>
            <TOP>66</TOP>
            <RIGHT>270</RIGHT>
            <BOTTOM>96</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">NO</STRING>
          <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
          <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
        </WINDOW>
      </WINDOW>
      <WINDOW type="button" name="OPT_ACCEPT">
        <POSITION>
          <LEFT>530</LEFT>
          <TOP>462</TOP>
          <RIGHT>720</RIGHT>
          <BOTTOM>496</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">ACCEPT</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="OPT_CANCEL">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <ACTION type="WINDOW" state="SHOW">MAIN_WRAPPER</ACTION>
        <ACTION type="WINDOW" state="HIDE">OPTIONS_WRAPPER</ACTION>
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>462</TOP>
          <RIGHT>210</RIGHT>
          <BOTTOM>496</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">CANCEL</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
  </WINDOW>
</SCREEN>
