<SCREEN>
  <NAME>STARTUP</NAME>
  <MUSICVAR>1</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">onmnbg.tga</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="static" name="TITLE">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>52</TOP>
        <RIGHT>400</RIGHT>
        <BOTTOM>104</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%IMPACT_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">OPENNOVA</STRING>
    </WINDOW>
    <WINDOW type="static" name="TAGLINE">
      <POSITION>
        <LEFT>42</LEFT>
        <TOP>112</TOP>
        <RIGHT>400</RIGHT>
        <BOTTOM>136</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <STRING justify="LEFT" vjustify="CENTER">A small game of our own. Pre-1.0, experimental.</STRING>
    </WINDOW>
    <WINDOW type="window" name="BUTTONS">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>196</TOP>
        <RIGHT>270</RIGHT>
        <BOTTOM>560</BOTTOM>
      </POSITION>
      <FONT>
        <NAME>%DEF_FONTNAME_LG%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
        <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
        <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
        <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
      </FONT>
      <WINDOW type="button" name="SINGLE_PLAYER">
        <ACTION type="SCREEN" file="sp.mnu">SINGLE_PLAYER</ACTION>
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>0</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>34</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">SINGLE PLAYER</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="LAN_MULTI_PLAYER">
        <ACTION type="SCREEN" file="mp.mnu">LAN_MULTI_PLAYER</ACTION>
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>40</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>74</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">MULTIPLAYER</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="PLAYER_INFO">
        <ACTION type="SCREEN" file="player.mnu">PLAYER_INFO</ACTION>
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>80</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>114</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">PLAYER</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="OPTIONS">
        <ACTION type="SCREEN" file="options.mnu">OPTIONS</ACTION>
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>120</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>154</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">OPTIONS</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="PLAY_RETAIL">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>184</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>218</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">PLAY RETAIL</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="CHANGE_FOLDER">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>224</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>258</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">CHANGE FOLDER</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="EXIT">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>288</TOP>
          <RIGHT>230</RIGHT>
          <BOTTOM>322</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <APPEARANCE state="MOUSEOVER"></APPEARANCE>
        <APPEARANCE state="SELECTED"></APPEARANCE>
        <APPEARANCE state="DISABLED"></APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">EXIT</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="static" name="RETAIL_NOTE">
      <POSITION>
        <LEFT>42</LEFT>
        <TOP>560</TOP>
        <RIGHT>500</RIGHT>
        <BOTTOM>584</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%DEF_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_DISABLED_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">PLAY RETAIL plays Joint Operations from your own install.</STRING>
    </WINDOW>
  </WINDOW>
</SCREEN>
