<SCREEN>
  <NAME>PRE_GAME_MENU</NAME>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">%DEF_IMAGE_DEFAULT_BG%</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="static" name="TITLE">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>16</TOP>
        <RIGHT>600</RIGHT>
        <BOTTOM>72</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%IMPACT_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">JOINING A GAME</STRING>
    </WINDOW>
    <WINDOW type="window" name="PRE_PANEL">
      <POSITION>
        <LEFT>180</LEFT>
        <TOP>100</TOP>
        <RIGHT>620</RIGHT>
        <BOTTOM>500</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
    </WINDOW>
    <WINDOW type="window" name="GAME_PASSWORD_WRAPPER" HIDDEN>
      <WINDOW type="multiline_edit" name="STATIC_GAME_PASSWORD_NOTE" READONLY>
        <POSITION>
          <LEFT>200</LEFT>
          <TOP>120</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>228</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="TOP" edge="8">This game asks for a password.</STRING>
        <SCROLLBAR>
          <POSITION>
            <LEFT>384</LEFT>
            <TOP>0</TOP>
            <RIGHT>400</RIGHT>
            <BOTTOM>108</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
          <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SCROLLBAR>
      </WINDOW>
      <WINDOW type="static" name="STATIC_GAME_PASSWORD">
        <POSITION>
          <LEFT>200</LEFT>
          <TOP>244</TOP>
          <RIGHT>370</RIGHT>
          <BOTTOM>270</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">PASSWORD</STRING>
      </WINDOW>
      <WINDOW type="edit" name="GAME_PASSWORD" PASSWORD>
        <POSITION>
          <LEFT>380</LEFT>
          <TOP>244</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>270</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER" edge="6"></STRING>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="SPECTATE_WRAPPER" HIDDEN>
      <WINDOW type="multiline_edit" name="STATIC_SPECTATE_NOTE" READONLY>
        <POSITION>
          <LEFT>200</LEFT>
          <TOP>120</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>228</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="TOP" edge="8">This game takes spectators. Join it to play, or to watch.</STRING>
        <SCROLLBAR>
          <POSITION>
            <LEFT>384</LEFT>
            <TOP>0</TOP>
            <RIGHT>400</RIGHT>
            <BOTTOM>108</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
          <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SCROLLBAR>
      </WINDOW>
      <WINDOW type="radio" name="SPECTATE">
        <GROUP>1</GROUP>
        <POSITION>
          <LEFT>300</LEFT>
          <TOP>244</TOP>
          <RIGHT>326</RIGHT>
          <BOTTOM>270</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER"></STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="static" name="STATIC_SPECTATE">
        <POSITION>
          <LEFT>336</LEFT>
          <TOP>244</TOP>
          <RIGHT>560</RIGHT>
          <BOTTOM>270</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">WATCH</STRING>
      </WINDOW>
      <WINDOW type="radio" name="PLAY" CHECKED>
        <GROUP>1</GROUP>
        <POSITION>
          <LEFT>300</LEFT>
          <TOP>280</TOP>
          <RIGHT>326</RIGHT>
          <BOTTOM>306</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER"></STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="static" name="STATIC_PLAY">
        <POSITION>
          <LEFT>336</LEFT>
          <TOP>280</TOP>
          <RIGHT>560</RIGHT>
          <BOTTOM>306</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">PLAY</STRING>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="TEAM_PASSWORD_WRAPPER" HIDDEN>
      <WINDOW type="window" name="TEAM_STATIC_WRAPPER" HIDDEN>
        <WINDOW type="multiline_edit" name="STATIC_TEAM_NOTE" READONLY>
          <POSITION>
            <LEFT>200</LEFT>
            <TOP>120</TOP>
            <RIGHT>600</RIGHT>
            <BOTTOM>228</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="LEFT" vjustify="TOP" edge="8">Your team asks for a password.</STRING>
          <SCROLLBAR>
            <POSITION>
              <LEFT>384</LEFT>
              <TOP>0</TOP>
              <RIGHT>400</RIGHT>
              <BOTTOM>108</BOTTOM>
            </POSITION>
            <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
            <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
            <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
            <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
            <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
            <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
            <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
            <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
            <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
            <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
          </SCROLLBAR>
        </WINDOW>
        <WINDOW type="static" name="STATIC_TEAM_PASSWORD">
          <POSITION>
            <LEFT>200</LEFT>
            <TOP>244</TOP>
            <RIGHT>370</RIGHT>
            <BOTTOM>270</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">TEAM PASSWORD</STRING>
        </WINDOW>
      </WINDOW>
      <WINDOW type="window" name="SPECTATOR_STATIC_WRAPPER" HIDDEN>
        <WINDOW type="multiline_edit" name="STATIC_SPECTATOR_NOTE" READONLY>
          <POSITION>
            <LEFT>200</LEFT>
            <TOP>120</TOP>
            <RIGHT>600</RIGHT>
            <BOTTOM>228</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <STRING justify="LEFT" vjustify="TOP" edge="8">Spectators need a password to watch this game.</STRING>
          <SCROLLBAR>
            <POSITION>
              <LEFT>384</LEFT>
              <TOP>0</TOP>
              <RIGHT>400</RIGHT>
              <BOTTOM>108</BOTTOM>
            </POSITION>
            <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
            <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
            <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
            <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
            <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
            <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
            <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
            <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
            <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
            <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
          </SCROLLBAR>
        </WINDOW>
        <WINDOW type="static" name="STATIC_SPECTATOR_PASSWORD">
          <POSITION>
            <LEFT>200</LEFT>
            <TOP>244</TOP>
            <RIGHT>370</RIGHT>
            <BOTTOM>270</BOTTOM>
          </POSITION>
          <APPEARANCE state="DEFAULT"></APPEARANCE>
          <STRING justify="LEFT" vjustify="CENTER">SPECTATOR PASSWORD</STRING>
        </WINDOW>
      </WINDOW>
      <WINDOW type="edit" name="TEAM_PASSWORD" PASSWORD>
        <POSITION>
          <LEFT>380</LEFT>
          <TOP>244</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>270</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER" edge="6"></STRING>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="ERROR_WRAPPER" HIDDEN>
      <WINDOW type="multiline_edit" name="MESSAGES" READONLY>
        <POSITION>
          <LEFT>200</LEFT>
          <TOP>120</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>420</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="TOP" edge="8"></STRING>
        <SCROLLBAR>
          <POSITION>
            <LEFT>384</LEFT>
            <TOP>0</TOP>
            <RIGHT>400</RIGHT>
            <BOTTOM>300</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
          <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SCROLLBAR>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="ABORT_WRAPPER" HIDDEN>
      <WINDOW type="button" name="ABORT_CANCEL">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <POSITION>
          <LEFT>310</LEFT>
          <TOP>440</TOP>
          <RIGHT>490</RIGHT>
          <BOTTOM>474</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">CANCEL</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="window" name="ABORTRETRY_WRAPPER" HIDDEN>
      <WINDOW type="button" name="BACK">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <ACTION type="POP_SCREEN"></ACTION>
        <POSITION>
          <LEFT>30</LEFT>
          <TOP>548</TOP>
          <RIGHT>220</RIGHT>
          <BOTTOM>582</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">BACK</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="ACCEPT">
        <HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
        <POSITION>
          <LEFT>580</LEFT>
          <TOP>548</TOP>
          <RIGHT>770</RIGHT>
          <BOTTOM>582</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">ACCEPT</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
  </WINDOW>
</SCREEN>
