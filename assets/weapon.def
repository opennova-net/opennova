	hudclipgfx 0 0 h_onclip.tga
	hudrndgfx 7 0 8 0 1 h_onrnd.tga
	scope_max_mag 2 0
	weapon_class secondary
	charfilter rifleman
	charfilter medic
	charfilter engineer
	charfilter sniper
	charfilter gunner
	teamfilter blue
	teamfilter red
	flags Sighted
	flags WhileSwimming
	flags NoCardSwitch
	error 0.05 0.2 0.25 0.05 0.1 0.15
	weaponweight 2.5
	clipweight 1
	pos -4.332 -3.84 -115.511 0 0 0
	tpos -32.708 16.642 -102.353 359.74 1.654 359.935
	action "idle"
		anim anim_wpn_idle
		delayend 125
		function wpn_std_idle
	end
	action "emptyidle"
		anim anim_wpn_idle
		delayend auto
