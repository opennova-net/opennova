// Weapon definitions

ammoclass_max_carry CLASS_ON556 1000
ammoclass_max_carry CLASS_ON9MM 1000
weapon "WPN_ON_AR15"
	clipsize 30
	startrounds 300
	targetyawrange 120
	targetpitchmax 22
	targetpitchmin 50
	statid 300
	maxclips 10
	ammobucket 1
	loadout_selectable 1
	round_type AMMO_ON_556
	loadout_menu_textid WEAP_SHORT_ON_AR15
	loadout_menu_ttdesc WEAP_DESC_ON_AR15
	loadout_menu_icon m_onar15.tga
	animadm on_ar15
	launchuserpoint bullet
	hudicon h_onar15.tga
	gfx1 on_ar15
	gfx3 onar15_3
	category 3
	ammoclass CLASS_ON556 1
	crosshair onxhair.tga
	hudclipgfx 0 0 h_onclip.tga
	hudrndgfx 6 0 4 0 1 h_onrnd.tga
	scope_max_mag 2 0
	weapon_class primary
	charfilter rifleman
	charfilter medic
	charfilter engineer
	charfilter sniper
	charfilter gunner
	teamfilter blue
	teamfilter red
	flags Sighted
	flags Auto
	flags WhileSwimming
	flags NoCardSwitch
	error 0.0165 0.2 0.25 0.0165 0.032 0.047
	weaponweight 5.5
	clipweight 1.5
	pos 25.188 -5.494 -144.952 0 0 0
	tpos 0.791 11.839 -135.622 0.018 0 8.973
	action "idle"
		anim anim_wpn_idle
		delayend 125
		function wpn_std_idle
	end
	action "emptyidle"
		anim anim_wpn_idle
		delayend auto
		function wpn_std_idle
	end
	action "fire"
		anim anim_wpn_fire
		soundsetend GS_ONAR15
		delayend 4
		function wpn_std_fire
		particle Effect_ONAR15MF
		particleuserpoint mflash01
	end
	action "recoil"
		function wpn_std_recoil
		particle Effect_ONAR15Cas
		particleuserpoint bcasing
	end
	action "reload"
		anim anim_wpn_reload
		soundset GF_ONAR15_RL
		delaystart 164
		function wpn_std_reload
	end
	action "empty"
		anim anim_wpn_empty
		soundset DRY_ONAR15
		delaystart 71
		function wpn_std_empty
	end
	action "switchto"
		anim anim_wpn_switchto
		soundset GF_ONAR15_ST
		delaystart 98
		function wpn_std_idle
	end
	action "switchfrom"
		anim anim_wpn_switchfrom
		soundset GF_ONAR15_SF
		delayend 2
		function wpn_std_switchfrom
	end
	action "switchrank"
		anim anim_wpn_switchrank
		delaystart 59
		function wpn_std_switchrank
	end
end

weapon "WPN_ON_PISTOL"
	clipsize 15
