		function wpn_std_empty
	end
	action "switchto"
		anim anim_wpn_switchto
		soundset GF_ONPIST_ST
		delaystart 53
		function wpn_std_idle
	end
	action "switchfrom"
		anim anim_wpn_switchfrom
		soundset GF_ONPIST_SF
		delayend 2
		function wpn_std_switchfrom
	end
	action "switchrank"
		delaystart 1
		delayend 1
		function wpn_std_switchrank
	end
end

