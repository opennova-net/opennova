// The minimal game's item catalogue: only what the mission places or the engine
// spawns by fixed id. Model-bearing entries the map does not place are not here --
// an entry is added when its model exists and a mission uses it, never ahead of that.
// Ids the engine addresses BY NUMBER are reserved; ids that merely also exist in
// retail's catalogue are free (our own content goes at 108001+).

begin "Player #1, Single player"
  id 105310
  type person
  unit_type 9
  graphic US01
  graphicenemy Indo01
  sid player1_sp
  anim_def US01
  attrib: aidata fo pfoil
  hp 150
  armor 0 0
  radarsig 300
  mana 0
  phrase_set 0
  sound_profile SP_JO_SP_PlayerM1
  sound_profileFemale SP_JO_SP_PlayerF1
  ai_function plyr
  disk_function PLAYER
  move_function org2
  input_function troop
end

// The multiplayer twin. Retail declares BOTH player rows and hosts spawn the
// MP one; our runtime's player template id is 0x14B9 (105305 - 100000), so a
// set that omits this row leaves every hosted/joined player with no graphic and
// no anim_def. Identical to the SP row apart from the phrase set and the sound
// profiles, exactly as retail authors it.
begin "Player #1, Multiplayer"
  id 105305
  type person
  unit_type 9
  graphic US01
  graphicenemy Indo01
  sid player1_mp
  anim_def US01
  attrib: aidata fo pfoil
  hp 150
  armor 0 0
  radarsig 300
  mana 0
  phrase_set 7
  sound_profile SP_JO_MP_PlayerM1
  sound_profileFemale SP_JO_MP_PlayerF1
  ai_function plyr
  disk_function PLAYER
  move_function org2
  input_function troop
end

// --- The canonical marker family -------------------------------------------
// Mesh-less items the engine addresses by FIXED id rather than by placement, so
// a map that wants a player start has to use these exact numbers. Taken from
// the retail items.def, and confirmed against retail 00TRa.bms: it places
// exactly one 106001 and 53 x 106005, and places NO player entity at all --
// the engine spawns "Player #1 (Singleplayer)" 105310 by its own id and reads
// 106001 to learn where. BMS records store these as type_id = id - 100000.
begin "Null"
  id 100000
  type marker
end

begin "start, player"
  id 106001
  type marker
end

begin "start, dmatch"
  id 106002
  type marker
end

begin "start, Blue Team"
  id 106003
  type marker
end

begin "start, Red Team"
  id 106004
  type marker
end

begin "waypoint"
  id 106005
  type marker
end

// Our own content (108001+): the synth house, the set's first authored model
// (assets/house.3di, the fixtures/threedi/synth `house` recipe), placed in
// mnml.bms as a building. No anim_def or husk: it has neither.
begin "House"
  id 108001
  type building
  graphic house
  sid house
  hp 5000
end
