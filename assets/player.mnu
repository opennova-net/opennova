<SCREEN>
  <NAME>PLAYER_INFO</NAME>
  <MUSICVAR>10</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">%DEF_IMAGE_DEFAULT_BG%</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="static" name="TITLE">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>16</TOP>
        <RIGHT>600</RIGHT>
        <BOTTOM>72</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%IMPACT_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">PLAYER</STRING>
    </WINDOW>
    <WINDOW type="window" name="PROFILE_PANEL">
      <POSITION>
        <LEFT>30</LEFT>
        <TOP>84</TOP>
        <RIGHT>440</RIGHT>
        <BOTTOM>534</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="static" name="STATIC_PLAYERPROFILE">
        <POSITION>
          <LEFT>16</LEFT>
          <TOP>12</TOP>
          <RIGHT>106</RIGHT>
          <BOTTOM>36</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">PROFILE</STRING>
      </WINDOW>
      <WINDOW type="combobox" name="PLAYER">
        <POSITION>
          <LEFT>110</LEFT>
          <TOP>12</TOP>
          <RIGHT>310</RIGHT>
          <BOTTOM>36</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER" edge="8"></STRING>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        <LIST_BOX>
          <POSITION>
            <LEFT>0</LEFT>
            <TOP>24</TOP>
            <RIGHT>200</RIGHT>
            <BOTTOM>48</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <ITEMS justify="LEFT" vjustify="CENTER">
            <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          </ITEMS>
          <MIN_ITEM_HEIGHT>22</MIN_ITEM_HEIGHT>
        </LIST_BOX>
      </WINDOW>
      <WINDOW type="button" name="RESET_PLAYER">
        <ACTION type="WINDOW" state="SHOW">QUERY_WINDOW</ACTION>
        <POSITION>
          <LEFT>318</LEFT>
          <TOP>12</TOP>
          <RIGHT>394</RIGHT>
          <BOTTOM>36</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">RESET</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="static" name="STATIC_PLAYERNAME">
        <POSITION>
          <LEFT>16</LEFT>
          <TOP>44</TOP>
          <RIGHT>106</RIGHT>
          <BOTTOM>68</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">NAME</STRING>
      </WINDOW>
      <WINDOW type="edit" name="PLAYERNAME" MAXCHAR="15">
        <POSITION>
          <LEFT>110</LEFT>
          <TOP>44</TOP>
          <RIGHT>394</RIGHT>
          <BOTTOM>68</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%COLOR_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER" edge="6"></STRING>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="static" name="STATIC_PLAYERCLASS">
        <POSITION>
          <LEFT>16</LEFT>
          <TOP>76</TOP>
          <RIGHT>106</RIGHT>
          <BOTTOM>100</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">CLASS</STRING>
      </WINDOW>
      <WINDOW type="combobox" name="PLAYERCLASS">
        <POSITION>
          <LEFT>110</LEFT>
          <TOP>76</TOP>
          <RIGHT>394</RIGHT>
          <BOTTOM>100</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER" edge="8"></STRING>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        <LIST_BOX>
          <POSITION>
            <LEFT>0</LEFT>
            <TOP>24</TOP>
            <RIGHT>284</RIGHT>
            <BOTTOM>136</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <ITEMS justify="LEFT" vjustify="CENTER">
            <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
            <ITEM value="5">MEDIC</ITEM>
            <ITEM value="6">SNIPER</ITEM>
            <ITEM value="7">GUNNER</ITEM>
            <ITEM value="8">RIFLEMAN</ITEM>
            <ITEM value="9">ENGINEER</ITEM>
          </ITEMS>
          <MIN_ITEM_HEIGHT>22</MIN_ITEM_HEIGHT>
        </LIST_BOX>
      </WINDOW>
      <WINDOW type="checkbox" name="OPTIONS_AUTORELOAD" AS_BUTTON>
        <POSITION>
          <LEFT>16</LEFT>
          <TOP>110</TOP>
          <RIGHT>202</RIGHT>
          <BOTTOM>136</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">AUTO RELOAD</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="checkbox" name="OPTIONS_AUTOMEDIC" AS_BUTTON>
