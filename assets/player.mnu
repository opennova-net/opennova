      <WINDOW type="window" name="AVATARS">
        <POSITION>
          <LEFT>16</LEFT>
          <TOP>184</TOP>
          <RIGHT>394</RIGHT>
          <BOTTOM>440</BOTTOM>
        </POSITION>
