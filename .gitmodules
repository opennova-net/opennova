[submodule "third_party/godot-cpp"]
	path = third_party/godot-cpp
	url = https://github.com/godotengine/godot-cpp.git
[submodule "third_party/gut"]
	path = third_party/gut
	url = https://github.com/bitwes/Gut.git
[submodule "docs"]
	path = docs
	url = ../docs.git
	update = none
	branch = master
[submodule "third_party/sdl3"]
	path = third_party/sdl3
	url = https://github.com/libsdl-org/SDL.git
	shallow = true
