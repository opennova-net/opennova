[node name="JumpRow" type="HBoxContainer" parent="Split/Left"]
layout_mode = 2

[node name="JumpLabel" type="Label" parent="Split/Left/JumpRow"]
layout_mode = 2
text = "Jump to:"

[node name="JumpSection" type="OptionButton" parent="Split/Left/JumpRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
disabled = true
tooltip_text = "Jump the running script straight to any section, including the win/lose stings the script's variable branches never reach on their own. Enabled while the music is playing."

[node name="VolumeMeter" parent="Split/Left" instance=ExtResource("3_vol")]
unique_name_in_owner = true
layout_mode = 2

[node name="AudioHint" type="Label" parent="Split/Left"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.55, 0.55, 1)
text = "Sounds play on your default audio device. If you hear nothing, the editor may have fallen back to a silent driver (the volume meter above still moves)."
autowrap_mode = 2

[node name="Sep" type="HSeparator" parent="Split/Left"]
layout_mode = 2

[node name="SectionGraphHeader" type="Label" parent="Split/Left"]
layout_mode = 2
text = "Section transitions"
tooltip_text = "Each row is a section in the loaded script and the sections it can jump to. While the VM runs, click a section to jump to it; the current section is highlighted in orange."

[node name="HostHint" type="Label" parent="Split/Left"]
layout_mode = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
text = "This script waits for the game. It loops in place until a variable changes (Variables tab) or you Jump to a section."
autowrap_mode = 2

