[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://modtools/music/ui/live_mode.gd" id="1_live"]
[ext_resource type="PackedScene" path="res://modtools/music/ui/var_inspector.tscn" id="2_var"]
[ext_resource type="PackedScene" path="res://modtools/music/ui/volume_meter.tscn" id="3_vol"]
[ext_resource type="PackedScene" path="res://modtools/music/ui/bank_mode.tscn" id="4_bank"]

[node name="LiveMode" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_live")

[node name="Screen" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0

[node name="TransportBar" type="HBoxContainer" parent="Screen"]
layout_mode = 2

[node name="StartButton" type="Button" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Start"

[node name="PauseButton" type="Button" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Pause"

[node name="ResumeButton" type="Button" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Resume"

[node name="StopButton" type="Button" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
text = "Stop"

[node name="TSep" type="VSeparator" parent="Screen/TransportBar"]
layout_mode = 2

[node name="StateLabel" type="Label" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
text = "STOPPED"

[node name="NowPlaying" type="Label" parent="Screen/TransportBar"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
text = "Now playing: —"
tooltip_text = "The section the music is currently in. Updates live as the script transitions or you jump."

[node name="Body" type="HSplitContainer" parent="Screen"]
layout_mode = 2
size_flags_vertical = 3
split_offset = 340

[node name="LeftDock" type="VSplitContainer" parent="Screen/Body"]
custom_minimum_size = Vector2(340, 0)
layout_mode = 2

[node name="TracksPanel" type="VBoxContainer" parent="Screen/Body/LeftDock"]
layout_mode = 2
size_flags_vertical = 3

[node name="TracksHeader" type="Label" parent="Screen/Body/LeftDock/TracksPanel"]
layout_mode = 2
text = "Tracks"
tooltip_text = "The sounds in the loaded bank. Each section's plays trigger these by index."

[node name="Bank" parent="Screen/Body/LeftDock/TracksPanel" instance=ExtResource("4_bank")]
layout_mode = 2
size_flags_vertical = 3

[node name="DialsPanel" type="VBoxContainer" parent="Screen/Body/LeftDock"]
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 1.4

[node name="DialsHeader" type="Label" parent="Screen/Body/LeftDock/DialsPanel"]
layout_mode = 2
text = "Game Dials"
tooltip_text = "The variables the game writes to drive the music. Poke one while playing to watch the map follow."

[node name="VarInspector" parent="Screen/Body/LeftDock/DialsPanel" instance=ExtResource("2_var")]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="VolumeMeter" parent="Screen/Body/LeftDock/DialsPanel" instance=ExtResource("3_vol")]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4

[node name="AudioHint" type="Label" parent="Screen/Body/LeftDock/DialsPanel"]
layout_mode = 2
theme_override_colors/font_color = Color(0.55, 0.55, 0.55, 1)
text = "No sound? The editor may be on a silent audio driver; the meter above still moves."
autowrap_mode = 2

[node name="CenterCol" type="VBoxContainer" parent="Screen/Body"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="MapHeader" type="Label" parent="Screen/Body/CenterCol"]
layout_mode = 2
text = "Section map"
tooltip_text = "Each box is a musical state. Arrows show how the script moves between them. While playing, the active state lights up. Single-click jumps there; double-click opens its blueprint; right-click to rename or delete."

[node name="Canvas" type="HSplitContainer" parent="Screen/Body/CenterCol"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
split_offset = 170

[node name="StatesPanel" type="VBoxContainer" parent="Screen/Body/CenterCol/Canvas"]
custom_minimum_size = Vector2(150, 0)
layout_mode = 2

[node name="StatesHeader" type="Label" parent="Screen/Body/CenterCol/Canvas/StatesPanel"]
layout_mode = 2
text = "States"
tooltip_text = "Every state in the music program. Click one to open it; you always know where you are, however deep you've drilled."

[node name="StatesList" type="ItemList" parent="Screen/Body/CenterCol/Canvas/StatesPanel"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3

[node name="CanvasStack" type="VBoxContainer" parent="Screen/Body/CenterCol/Canvas"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3

[node name="SectionMap" type="GraphEdit" parent="Screen/Body/CenterCol/Canvas/CanvasStack"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
show_grid = true
grid_pattern = 1
show_menu = false
minimap_enabled = true

[node name="LogStrip" type="VBoxContainer" parent="Screen"]
layout_mode = 2

[node name="FilterRow" type="HBoxContainer" parent="Screen/LogStrip"]
layout_mode = 2

[node name="FilterLabel" type="Label" parent="Screen/LogStrip/FilterRow"]
layout_mode = 2
text = "Show:"

[node name="FilterSection" type="CheckBox" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "section"

[node name="FilterSound" type="CheckBox" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
button_pressed = true
text = "sound"

[node name="FilterVar" type="CheckBox" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
text = "var"
tooltip_text = "Off by default: the Game Dials already mirror every live value, so logging each write floods the list."

[node name="FilterVolume" type="CheckBox" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
text = "volume"
tooltip_text = "Off by default: the volume meter shows the live value, so logging each GSV/GSDV call floods the list."

[node name="Spacer" type="Control" parent="Screen/LogStrip/FilterRow"]
layout_mode = 2
size_flags_horizontal = 3

[node name="JumpLabel" type="Label" parent="Screen/LogStrip/FilterRow"]
layout_mode = 2
text = "Jump to:"

[node name="JumpSection" type="OptionButton" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
disabled = true
tooltip_text = "Jump the running script straight to any section, including the win/lose stings the script's variable branches never reach on their own. Enabled while the music is playing."

[node name="ClearButton" type="Button" parent="Screen/LogStrip/FilterRow"]
unique_name_in_owner = true
layout_mode = 2
text = "Clear"

[node name="Events" type="ItemList" parent="Screen/LogStrip"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 80)
layout_mode = 2
