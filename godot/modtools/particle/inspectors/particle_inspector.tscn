[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://modtools/particle/inspectors/particle_inspector.gd" id="1_part"]

[node name="ParticleInspector" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_part")

[node name="Header" type="Label" parent="."]
text = "[particledef]"
theme_type_variation = &"HeaderSmall"

[node name="ParticleList" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 160)
size_flags_vertical = 3

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Open a .ptl to browse particles."
theme_type_variation = &"Muted"
horizontal_alignment = 1

[node name="DetailLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "(no particle selected)"
theme_type_variation = &"Muted"

[node name="IdRow" type="HBoxContainer" parent="."]

[node name="IdLabel" type="Label" parent="IdRow"]
custom_minimum_size = Vector2(80, 0)
text = "id"

[node name="IdEdit" type="LineEdit" parent="IdRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
editable = false

[node name="FlagsRow" type="HBoxContainer" parent="."]

[node name="FlagsLabel" type="Label" parent="FlagsRow"]
custom_minimum_size = Vector2(80, 0)
