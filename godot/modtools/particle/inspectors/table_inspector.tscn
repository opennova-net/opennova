[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://modtools/particle/inspectors/table_inspector.gd" id="1_table"]

[node name="TableInspector" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_table")

[node name="Header" type="Label" parent="."]
text = "[tabledef]"
theme_type_variation = &"HeaderSmall"

[node name="TableList" type="ItemList" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 140)
size_flags_vertical = 3

[node name="EmptyLabel" type="Label" parent="."]
unique_name_in_owner = true
text = "Open a .ptl with [tabledef] entries."
theme_type_variation = &"Muted"
horizontal_alignment = 1

[node name="IdRow" type="HBoxContainer" parent="."]

[node name="IdLabel" type="Label" parent="IdRow"]
custom_minimum_size = Vector2(56, 0)
text = "Name"

[node name="IdEdit" type="LineEdit" parent="IdRow"]
unique_name_in_owner = true
size_flags_horizontal = 3
placeholder_text = "Table identifier"
editable = false

[node name="CurveCaption" type="Label" parent="."]
unique_name_in_owner = true
text = "(no table selected)"
theme_type_variation = &"Muted"

[node name="CurveView" type="Control" parent="."]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 220)
size_flags_vertical = 3
