; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="OpenNova"
config/version="0.0.10"
run/main_scene="res://game/game_runtime_root.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.08, 0.09, 0.12, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"

[autoload]

Strings="*res://game/strings/strings.gd"
MusicService="*res://game/world/music_service.gd"
ImGuiRoot="*uid://dugmpnsxaagba"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/subwindows/embed_subwindows=false
window/vsync/vsync_mode=0

[editor]

import/use_multiple_threads=false

[editor_plugins]

enabled=PackedStringArray("res://addons/imgui-godot/plugin.cfg")

[physics]

3d/physics_engine="Dummy"

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_s3tc_bptc=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=4
limits/global_shader_variables/buffer_size=262144
environment/defaults/default_clear_color=Color(0.08, 0.09, 0.12, 1)

[shader_globals]

opennova_sun_light={
"type": "vec3",
"value": Vector3(0.666667, 0.666667, 0.654902)
}
opennova_sky_ambient={
