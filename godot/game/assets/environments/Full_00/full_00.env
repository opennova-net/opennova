enviro_name "Full_00"

timeofday "Day"

envscale   1.0

iris_percent 15
iris_center 1.0

water_rgb         56,59,39              ;color seen when under water and surface color

sky_map1          Cloud01.pcx           ;cloud pcx - full range cloud image, square rooted (bright gamma)
sky_map2          Cloud01b.pcx          ;cloud pcx, subtile modulation layer - centered at 128
sky_height        175                   ;height in meters
sky_speed         15                    ;movement rate

fog_level         1000                  ;0=1000 meters 1=500 meters etc.
fog_type          2                        ;0=fog, 1=haze, 2=haze wall, 3=mild haze wall

cloud_rgb         128,128,128           ;cloud color tinter
terrain_rgb       255,255,255           ;1.0 terrain tinting color (255,255,255 is default)
vertex_rgb        128,128,128           ;2.0 vertex tinting color (128,128,128 is default)

lightning_rgb     85,85,90              ;lightning color (from sky direction)
			                ;lightning is added to sky_rgb
                                        ;and also affects fog and ambient slightly
sun_3di             msun.3di              ;sun object
moon_3di          fmoon4.3di            ;moon object
glare_3di          mglare.3di            ;glare object
star_3di                                ;star object / leave blank for null

;indoor ambient lighting values
;ceiling_rgb     80,80,80                ;overhead and wraps around
;floor_rgb       25,25,25                ;underneath, wraps around
ceiling_rgb     55,55,55                ;overhead and wraps around
floor_rgb       25,25,25                ;underneath, wraps around

curtime         1200


;new shit
advanced_clouds    1

tod_begin  0200
    sun_rgb            0,0,0
    moon_rgb           47,66,86
    sky_rgb            35,36,59
    ground_rgb         14,29,45
    skyfog_rgb         1,2,6
    fog_rgb            1,2,6
    skybase_rgb        0,1,2
    skybright_rgb      65,65,85
    skyhighlight_rgb   1,4,2
    cloudbase_rgb      14,14,21
    cloudhighlight_rgb 54,54,54
    cloudedge_rgb      43,50,59
tod_end

