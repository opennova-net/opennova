[configuration]

entry_symbol = "opennova_library_init"
compatibility_minimum = "4.6"
reloadable = true

[libraries]

windows.debug.x86_64 = "res://bin/libopennova.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://bin/libopennova.windows.template_release.x86_64.dll"
linux.debug.x86_64 = "res://bin/libopennova.linux.template_debug.x86_64.so"
linux.release.x86_64 = "res://bin/libopennova.linux.template_release.x86_64.so"
macos.debug = "res://bin/libopennova.macos.template_debug.arm64.dylib"
macos.release = "res://bin/libopennova.macos.template_release.universal.dylib"
web.debug.threads.wasm32 = "res://bin/libopennova.web.template_debug.wasm32.wasm"
web.release.threads.wasm32 = "res://bin/libopennova.web.template_release.wasm32.wasm"
