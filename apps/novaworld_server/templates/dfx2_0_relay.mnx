{
ACTION: REPLACE
TYPE:	WINDOW
SCREEN: NW_MULTI_PLAYER
PARENT: MAIN
NAME:	NOVAWORLD

<WINDOW type="static" name="NOVAWORLD">
	<POSITION>
		<LEFT>100</LEFT>
		<TOP>15</TOP>
	</POSITION>
	<WINDOW type="multiline_edit" name="STATIC_NW_RELAY" READONLY>
		<POSITION>
			<LEFT>0</LEFT>
			<RIGHT>600</RIGHT>
			<TOP>0</TOP>
			<BOTTOM>320</BOTTOM>
		</POSITION>
		<FONT>
			<NAME>%DEF_FONTNAME_BODY%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>
		<STRING justify="CENTER" vjustify="CENTER">@MESSAGE@</STRING>
	</WINDOW>
	<WINDOW @OPTIONAL_BUTTON@ type="button" name="NWServerSubmitContinueButton">
		<ACTION type="FORM_POST" target_form="1">@TARGET@</ACTION>
		<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
		<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
		<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
		<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
		<POSITION>
			<LEFT>222</LEFT>
			<RIGHT>378</RIGHT>
			<TOP>330</TOP>
			<BOTTOM>354</BOTTOM>
		</POSITION>
		<FONT>
			<NAME>%DEF_FONTNAME_BODY%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>
		<STRING justify="CENTER" vjustify="CENTER">@NAME@</STRING>
	</WINDOW>
	@IB3_FORM_1@
</WINDOW>
}