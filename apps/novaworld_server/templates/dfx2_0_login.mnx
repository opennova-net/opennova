			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn7.tga</APPEARANCE>
			<POSITION>
				<LEFT>220</LEFT>
				<RIGHT>380</RIGHT>
				<TOP>70</TOP>
				<BOTTOM>94</BOTTOM>
			</POSITION>
			<STRING type="ID" justify="CENTER" vjustify="CENTER">TT_YES</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="button" name="QUERY_NO">
			<ACTION type="window" state="HIDE">QUERY_WINDOW</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn7.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn7.tga</APPEARANCE>
