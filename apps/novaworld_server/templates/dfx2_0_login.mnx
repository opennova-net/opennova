	<WINDOW type="window" name="QUERY_WINDOW" DRAW_FRAME HIDDEN MODAL>
		<APPEARANCE type="color" state="default">%COLOR_BLACK%</APPEARANCE>
		<POSITION>
			<LEFT>200</LEFT>
			<RIGHT>600</RIGHT>
			<TOP>150</TOP>
			<BOTTOM>250</BOTTOM>
		</POSITION>
		<WINDOW type="multiline_edit" name="STATIC_QUESTION" READONLY>
			<POSITION>
				<LEFT>20</LEFT>
				<RIGHT>380</RIGHT>
				<TOP>5</TOP>
				<BOTTOM>60</BOTTOM>
			</POSITION>
			<STRING type="id" justify="LEFT">This action will close the game and open Novaworld Community in a browser window.  Would you like to continue?</STRING>
		</WINDOW>
		<WINDOW type="button" name="QUERY_YES">
			<ACTION type="window" state="HIDE">QUERY_WINDOW</ACTION>
			<ACTION type="URL" EXTERNAL_BROWSER>
				https://www.novaworld2.com/index.php?do=/public/signup/&parent_close=1&pfid=38&source=dfx2
			</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn7.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn7.tga</APPEARANCE>
