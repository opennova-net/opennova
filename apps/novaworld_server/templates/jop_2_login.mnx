{
ACTION: REPLACE
TYPE:	WINDOW
SCREEN: NW_MULTI_PLAYER
PARENT: MAIN
NAME:	NOVAWORLD
ACTIVATE: ENABLE_BACK_BUTTON

<WINDOW type="static" name="NOVAWORLD">
	<WINDOW type="window" name="ENABLE_BACK_BUTTON">
		<ACTION type="window" state="show">BACK</ACTION>
	</WINDOW>
	<POSITION>
		<LEFT>0</LEFT>
		<TOP>0</TOP>
	</POSITION>
	<WINDOW type="static" name="STATIC_MOTD">
		<POSITION>
			<LEFT>0</LEFT>
			<RIGHT>800</RIGHT>
			<TOP>20</TOP>
			<BOTTOM>35</BOTTOM>
		</POSITION>
		<STRING justify="CENTER" vjustify="CENTER">@MOTD1@</STRING>
	</WINDOW>

	<WINDOW type="table" name="AD_TABLE">
		<APPEARANCE state="default"></APPEARANCE>
		<ACTION type="URL" EXTERNAL_BROWSER>				https://www.novaworld2.com/index.php?do=/public/store/catalog/&parent_close=1&pfid=28&source=jo
		</ACTION>
		<POSITION>
			<LEFT>205</LEFT>
			<RIGHT>595</RIGHT>
			<TOP>40</TOP>
			<BOTTOM>87</BOTTOM>
		</POSITION>
		<COLUMN count="1" spacing="0">
			<HEADER justify="CENTER" vjustify="TOP" column="0" sort="0" width="390" type="id"></HEADER>
			<BODY justify="CENTER" vjustify="TOP" column="0" BITMAP_DRAW></BODY>
			<SUBST column="0" value="0"  URL>/static/jop_2/nonbhdx2.tga</SUBST>
			<SUBST column="0"  URL>/static/jop_2/nonbhdx2.tga</SUBST>
		</COLUMN>
		<MIN_ITEM_HEIGHT>48</MIN_ITEM_HEIGHT>
		<FIXED_HEADER_HEIGHT>0</FIXED_HEADER_HEIGHT>
		<ITEMS>
			<ROW>
				<ITEM VALUE="0">0</ITEM>
			</ROW>
		</ITEMS>
	</WINDOW>


	<WINDOW type="window" name="LOGIN_PAGE">
		<WINDOW type="static" name="STATIC_NW_USERNAME">
			<POSITION>
				<LEFT>0</LEFT>
				<RIGHT>200</RIGHT>
				<TOP>111</TOP>
				<BOTTOM>135</BOTTOM>
			</POSITION>
			<STRING justify="RIGHT" vjustify="CENTER">Name:</STRING>
		</WINDOW>
		<WINDOW type="edit" name="NAME" form="1" MAXCHAR="16">
			<ACTION type="TAB">PASSWORD</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>210</LEFT>
				<RIGHT>400</RIGHT>
				<TOP>111</TOP>
				<BOTTOM>135</BOTTOM>
			</POSITION>
			<STRING edge="5" justify="LEFT" vjustify="CENTER">@NAME@</STRING>
		</WINDOW>
		<WINDOW type="static" name="STATIC_NW_PASSWORD">
			<POSITION>
				<LEFT>0</LEFT>
				<RIGHT>200</RIGHT>
				<TOP>141</TOP>
				<BOTTOM>165</BOTTOM>
			</POSITION>
			<STRING justify="RIGHT" vjustify="CENTER">Password:</STRING>
		</WINDOW>
		<WINDOW type="edit" name="PASSWORD" PASSWORD form="1" MAXCHAR="16">
			<ACTION type="TAB">NAME</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>210</LEFT>
				<RIGHT>400</RIGHT>
				<TOP>141</TOP>
				<BOTTOM>165</BOTTOM>
			</POSITION>
			<STRING edge="5" justify="LEFT" vjustify="CENTER"></STRING>
		</WINDOW>
		<WINDOW type="static" name="STATIC_NW_PASSWORD_HIDDEN" HIDDEN>
			<FONT>
				<NAME>%DEF_FONTNAME_BODY%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<POSITION>
				<LEFT>215</LEFT>
				<RIGHT>400</RIGHT>
				<TOP>141</TOP>
				<BOTTOM>165</BOTTOM>
			</POSITION>
			<STRING justify="LEFT" vjustify="CENTER">********</STRING>
		</WINDOW>
		<WINDOW type="edit" name="rememberlogindata" form="1" READONLY HIDDEN>
			<STRING></STRING>
		</WINDOW>
		<WINDOW type="button" name="ACCEPT">
			<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
			<ACTION type="FORM_POST" target_form="1">NWLogin.dll</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>450</LEFT>
				<RIGHT>550</RIGHT>
				<TOP>121</TOP>
				<BOTTOM>145</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Login</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="button" name="CREATE_ACCOUNT">
			<ACTION type="URL" EXTERNAL_BROWSER>
				https://www.novaworld2.com/index.php?do=/public/signup/&parent_close=1&pfid=28&source=jo
			</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>50</LEFT>
				<TOP>201</TOP>
				<BOTTOM>225</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Create Account</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="button" name="FORGOT_NAME">
			<ACTION type="URL">jop_2_geth.htm</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>210</LEFT>
				<TOP>201</TOP>
				<BOTTOM>225</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Forgotten Name</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="button" name="FORGOT_PASSWORD">
			<ACTION type="URL">jop_2_getp.htm</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>370</LEFT>
				<TOP>201</TOP>
				<BOTTOM>225</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Forgotten Password</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="button" name="HELP">
			<ACTION type="window" state="HIDE">LOGIN_PAGE</ACTION>
			<ACTION type="window" state="SHOW">HELP_PAGE</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>530</LEFT>
				<TOP>201</TOP>
				<BOTTOM>225</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Help</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="checkbox" name="REMEMBER_LOGIN" GLOBAL_VAR>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn5.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn5.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn5.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn5.tga</APPEARANCE>
			<POSITION>
				<LEFT>260</LEFT>
				<TOP>256</TOP>
				<BOTTOM>280</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Remember my login information.</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>

		<WINDOW type="static" name="STATIC_ESRB_WARNING">
			<POSITION>
				<LEFT>160</LEFT>
				<RIGHT>640</RIGHT>
				<TOP>320</TOP>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">ESRB Notice: Game experience may change during online play.</STRING>
		</WINDOW>

		<WINDOW type="static" name="STATIC_ACCOUNT_WARNING">
			<POSITION>
				<LEFT>140</LEFT>
				<RIGHT>660</RIGHT>
				<TOP>340</TOP>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Accounts running hacks or cheats will be terminated without warning.</STRING>
		</WINDOW>

		<WINDOW type="static" name="STATIC_ACCOUNT_WARNING">
			<POSITION>
				<LEFT>140</LEFT>
				<RIGHT>660</RIGHT>
				<TOP>360</TOP>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Accounts with no activity and/or services are subject to deletion.</STRING>
		</WINDOW>

		<WINDOW type="static" name="STATIC_ACCOUNT_WARNING">
			<POSITION>
				<LEFT>140</LEFT>
				<RIGHT>660</RIGHT>
				<TOP>380</TOP>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Visit the new www.Novaworld.com for account management and forums.</STRING>
		</WINDOW>


		@IB3_FORM_1@
	</WINDOW>
	<WINDOW type="window" name="HELP_PAGE" HIDDEN>
		<WINDOW type="multiline_edit" name="HELP_TEXT" READONLY>
			<POSITION>
				<LEFT>100</LEFT>
				<RIGHT>700</RIGHT>
				<TOP>50</TOP>
				<BOTTOM>300</BOTTOM>
			</POSITION>
			<STRING edge="5" justify="LEFT" vjustify="TOP">@HELP_STRING@</STRING>
			<SCROLLBAR>
				<APPEARANCE type="image" state="default">m_scrolV.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover">m_scrolV.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected">m_scrolV.tga</APPEARANCE>
				<SHUTTLE type="image" state="default">shuttlev.tga</SHUTTLE>
				<SHUTTLE type="image" state="mouseover">shuttlev.tga</SHUTTLE>
				<SHUTTLE type="image" state="selected">shuttlev.tga</SHUTTLE>
				<SCROLLUP type="image" state="default" map_state="0" height="24">up2arrw.tga</SCROLLUP>
				<SCROLLUP type="image" state="mouseover" map_state="1" height="24">up2arrw.tga</SCROLLUP>
				<SCROLLUP type="image" state="selected" map_state="2" height="24">up2arrw.tga</SCROLLUP>
				<SCROLLUP type="image" state="disabled" map_state="3 height="24">up2arrw.tga</SCROLLUP>
				<SCROLLDOWN type="image" state="default" map_state="0" height="24">dn2arrw.tga</SCROLLDOWN>
				<SCROLLDOWN type="image" state="mouseover" map_state="1" height="24">dn2arrw.tga</SCROLLDOWN>
				<SCROLLDOWN type="image" state="selected" map_state="2" height="24">dn2arrw.tga</SCROLLDOWN>
				<SCROLLDOWN type="image" state="disabled" map_state="3" height="24">dn2arrw.tga</SCROLLDOWN>
				<POSITION>
					<LEFT>630</LEFT>
					<TOP>0</TOP>
					<RIGHT>650</RIGHT>
					<BOTTOM>250</BOTTOM>
				</POSITION>
				<SOUND state="selected" trigger="CLICK_VALUE">menu.lwf</SOUND>
			</SCROLLBAR>
		</WINDOW>
		<WINDOW type="button" name="HELP_PAGE_BACK">
			<ACTION type="window" state="SHOW">LOGIN_PAGE</ACTION>
			<ACTION type="window" state="HIDE">HELP_PAGE</ACTION>
			<ACTION type="WINDOW" ></ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>350</LEFT>
				<RIGHT>450</RIGHT>
				<TOP>351</TOP>
				<BOTTOM>375</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Okay</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
	</WINDOW>
</WINDOW>
}
