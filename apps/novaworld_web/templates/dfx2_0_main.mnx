{
ACTION: REPLACE
TYPE:	WINDOW
SCREEN: NW_MULTI_PLAYER
PARENT: MAIN
NAME:	NOVAWORLD
ACTIVATE: RADIO_TAB_GAMES
ACTIVATE: SERVER_LIST_REFRESH
ACTIVATE: TAB_MOTD
ACTIVATE: ENABLE_HOME_TABS
ACTIVATE: NOVAWORLD

<WINDOW type="static" name="NOVAWORLD">

	<WINDOW type="window" name="ENABLE_HOME_TABS">
		<ACTION type="window" state="enable">TAB_MOTD</ACTION>
		<ACTION type="window" state="enable">GOTO_NOVAWORLD</ACTION>
		<ACTION type="window" state="hide">BACK</ACTION>
		<ACTION type="window" state="show">LOGOUT</ACTION>
	</WINDOW>

	<ACTION type="mnx">host.mnx</ACTION>
	<POSITION>
		<LEFT>0</LEFT>
		<TOP>-35</TOP>
	</POSITION>
	<WINDOW type="window" name="GENERAL_TABS_WRAPPER">
		<FONT>
			<NAME>%DEF_FONTNAME_BODY%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>
		<WINDOW type="window">
			<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
			<POSITION>
				<TOP>34</TOP>
				<BOTTOM>34</BOTTOM>
				<LEFT>0</LEFT>
				<RIGHT>801</RIGHT>
			</POSITION>
		</WINDOW>
		<WINDOW type="radio" name="RADIO_TAB_GENERAL">
			<GROUP>1</GROUP>
			<ACTION type="window" state="SHOW">TAB_GENERAL</ACTION>
			<ACTION type="window" state="HIDE">TAB_JOIN</ACTION>
			<ACTION type="window" state="HIDE">TAB_HOSTMNX</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="25">tab_mid.tga</APPEARANCE>
			<POSITION>
				<LEFT>20</LEFT>
				<RIGHT>180</RIGHT>
				<TOP>10</TOP>
				<BOTTOM>35</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Info</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="radio" name="RADIO_TAB_GAMES">
			<GROUP>1</GROUP>
			<ACTION type="window" state="HIDE">TAB_GENERAL</ACTION>
			<ACTION type="window" state="SHOW">TAB_JOIN</ACTION>
			<ACTION type="window" state="HIDE">TAB_HOSTMNX</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="25">tab_mid.tga</APPEARANCE>
			<POSITION>
				<LEFT>180</LEFT>
				<RIGHT>340</RIGHT>
				<TOP>10</TOP>
				<BOTTOM>35</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Play</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="radio" name="RADIO_TAB_HOSTMNX">
			<GROUP>1</GROUP>
			<ACTION type="window" state="HIDE">TAB_GENERAL</ACTION>
			<ACTION type="window" state="HIDE">TAB_JOIN</ACTION>
			<ACTION type="window" state="SHOW">TAB_HOSTMNX</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="25">tab_mid.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="25">tab_mid.tga</APPEARANCE>
			<POSITION>
				<LEFT>340</LEFT>
				<RIGHT>500</RIGHT>
				<TOP>10</TOP>
				<BOTTOM>35</BOTTOM>
			</POSITION>
			<STRING justify="CENTER" vjustify="CENTER">Host</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
	</WINDOW>
	<WINDOW type="button" name="LOGOUT">
		<ACTION type="window" state="HIDE">TAB_HOSTMNX</ACTION>
		<ACTION type="window" state="hide">LOGOUT</ACTION>
		<ACTION type="window" state="show">BACK</ACTION>
		<ACTION type="url">NWLogout.dll?success=dfx2_0_login.htm&failure=dfx2_0_main.htm&msgbase=dfx2_0_msg.htm&relay=dfx2_0_relay.htm&nodb=dfx2_0_nodb.htm&charglsvssrequest=[dfx2]kills</ACTION>
<!--	<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>-->
		<APPEARANCE state="default"></APPEARANCE>
		<APPEARANCE state="mouseover"></APPEARANCE>
		<APPEARANCE state="selected"></APPEARANCE>
		<APPEARANCE state="disabled"></APPEARANCE>
<!--		
		<POSITION>
			<LEFT>76</LEFT>
			<TOP>528</TOP>
		</POSITION>
-->		
		<POSITION>
			<LEFT>16</LEFT>
			<TOP>528</TOP>
		</POSITION>
		<FONT>
			<NAME>%DEF_FONTNAME_LG%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>
<!--	<STRING type="id" justify="RIGHT" vjustify="CENTER">NAV_Back</STRING>-->
		<STRING justify="LEFT" vjustify="CENTER">Exit NovaWorld</STRING>
		<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
		<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
	</WINDOW>

	<WINDOW type="window" name="TAB_GENERAL">
		<POSITION>
			<LEFT>30</LEFT>
			<TOP>50</TOP>
		</POSITION>
		<WINDOW type="radio" name="TAB_MOTD">
			<GROUP>1</GROUP>
			<ACTION type="window" state="SHOW">GENERAL_SUB_MOTD</ACTION>
			<ACTION type="window" state="HIDE">GENERAL_SUB_EULA</ACTION>
			<ACTION type="window" state="HIDE">QUERY_WINDOW</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>-10</LEFT>
				<RIGHT>146</RIGHT>
				<TOP>68</TOP>
				<BOTTOM>92</BOTTOM>
			</POSITION>
			<FONT>
				<NAME>%DEF_FONTNAME_BODY%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<STRING justify="CENTER" vjustify="CENTER">Announcements</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		<WINDOW type="radio" name="TAB_EULA">
			<GROUP>1</GROUP>
			<ACTION type="window" state="SHOW">GENERAL_SUB_EULA</ACTION>
			<ACTION type="window" state="HIDE">GENERAL_SUB_MOTD</ACTION>
			<ACTION type="window" state="HIDE">QUERY_WINDOW</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>-10</LEFT>
				<RIGHT>146</RIGHT>
				<TOP>108</TOP>
				<BOTTOM>132</BOTTOM>
			</POSITION>
			<FONT>
				<NAME>%DEF_FONTNAME_BODY%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<STRING justify="CENTER" vjustify="CENTER">User Agreement</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>
		
		<WINDOW type="button" name="GOTO_NOVAWORLD">
			<ACTION type="window" state="SHOW">QUERY_WINDOW</ACTION>
			<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
			<POSITION>
				<LEFT>-10</LEFT>
				<RIGHT>146</RIGHT>
				<TOP>148</TOP>
				<BOTTOM>172</BOTTOM>
			</POSITION>
			<FONT>
				<NAME>%DEF_FONTNAME_BODY%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<STRING justify="CENTER" vjustify="CENTER">My Account</STRING>
			<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
			<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
		</WINDOW>

