		<WINDOW type="multiline_edit" name="GENERAL_SUB_MOTD">
			<POSITION>
				<LEFT>114</LEFT>
				<TOP>80</TOP>
			</POSITION>
			<WINDOW type="multiline_edit" name="MOTD" READONLY>
				<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
				<STRING vjustify="TOP"><RAW_TEXT>@MOTD@</RAW_TEXT></STRING>
				<POSITION>
					<LEFT>50</LEFT>
					<RIGHT>500</RIGHT>
					<TOP>-50</TOP>
					<BOTTOM>340</BOTTOM>
				</POSITION>
				<SCROLLBAR>
					<APPEARANCE type="image" state="default">m_scrolV.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover">m_scrolV.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected">m_scrolV.tga</APPEARANCE>
					<SHUTTLE type="image" state="default">shuttlev.tga</SHUTTLE>
					<SHUTTLE type="image" state="mouseover">shuttlev.tga</SHUTTLE>
