# Keep the server image build context lean. The Dockerfile only needs
# engine/, backend/, third_party/, apps/, and the root CMakeLists.
.git
build/
build-*/
**/build/
**/.godot/
godot/bin/
godot/exports/
.godot-bin/
node_modules/
**/node_modules/
web/dist/
launcher/**/bin/
launcher/**/obj/
.venv/
__pycache__/
*.pyc
.scratch/
notes/
fixtures/
screenshots/
infra/aws/.terraform/
infra/github/.terraform/
# Terraform state + operator var-files hold real secrets — never into any build
# context (CI checkouts lack them since they're gitignored; this guards local builds).
**/*.tfstate
**/*.tfstate.*
**/terraform.tfvars
**/*.auto.tfvars
