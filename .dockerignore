# Keep the server image build context lean. The Dockerfile only needs
# engine/, backend/, third_party/, apps/, and the root CMakeLists.
.git
build/
build-*/
**/build/
**/.godot/
godot/bin/
godot/exports/
.godot-bin/
node_modules/
**/node_modules/
web/dist/
launcher/**/bin/
launcher/**/obj/
__pycache__/
*.pyc
.scratch/
# Agent worktrees (.claude/worktrees/, each a whole checkout) and the
# machine-local settings file live here; no image reads any of it. libs/ is
# a stale pre-ADR-0028 tree a maintainer checkout can still hold.
.claude/
libs/
fixtures/
infra/aws/.terraform/
# Terraform state + operator var-files hold real secrets — never into any build
# context (CI checkouts lack them since they're gitignored; this guards local builds).
**/*.tfstate
**/*.tfstate.*
**/terraform.tfvars
**/*.auto.tfvars
