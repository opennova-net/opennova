# Claude Code: track shared project config (settings.json, skills, commands,
# CLAUDE.md files); keep machine-local state and worktrees out. Negations only
# work because the exclusion is `.claude/*` (children), not `.claude/` (dir).
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/agents/
# belt-and-suspenders: keep these ignored even if the negations above widen
.claude/worktrees/
.claude/settings.local.json

# Build artifacts
build/
*.o
*.os
*.a
*.so
*.dll
*.dylib
*.lib
*.exp
*.pdb
*.wasm

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# SCons
.sconsign.dblite
*.pyc
__pycache__/

# Python tooling
.venv/
.pytest_cache/
pytest-cache-files-*/
*.egg-info/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
Testing/Temporary/

# PyInstaller
*.spec

# Runtime logs
*.log

# Terraform (state, providers, and operator var-files are never committed; the
# .terraform.lock.hcl provider pins and *.tfvars.example ARE committed; see DEPLOY.md)
infra/aws/.terraform/
infra/github/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# Blender addon native libs and wheels (built/downloaded artifacts)
blender/lib/**/*.so
blender/lib/**/*.dll
blender/lib/**/*.dylib
blender/wheels/

# Shared library build directories
build-*/
build_*/
dist/

# OS files
.DS_Store
Thumbs.db
TODO

# Godot
godot/.godot/
*.TMP
godot/exports/
.godot-bin/
godot/addons/gut/

CLAUDE.local.md
.superpowers/

.scratch/

# Local-only Windows dev helper: per-machine compose override that moves the NovaWorld UDP
# port off the Hyper-V/WinNAT reserved range (see DEVELOPING.md). Not for commit.
deploy/compose/docker-compose.winport.yml

# Local reverse-engineering notes/dumps
ida_dumps/
stripify_call_*.log
