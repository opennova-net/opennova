# Claude Code: track shared project config (settings.json, skills, commands,
# CLAUDE.md files); keep machine-local state and worktrees out. Negations only
# work because the exclusion is `.claude/*` (children), not `.claude/` (dir).
.claude/*
!.claude/settings.json
!.claude/skills/
!.claude/commands/
!.claude/agents/
# belt-and-suspenders: keep these ignored even if the negations above widen
.claude/worktrees/
.claude/settings.local.json

# Codex CLI: machine-local state and worktrees, same policy as .claude above
.codex/
.worktrees/

# Debris of the ADR 0038 Python pipeline cut on machines that ran it (the
# PyInstaller spec, the egg-info, the loose ModSuperOed .fx set); nothing
# tracked produces or reads them.
onimport.spec
opennova_tools.egg-info/
third_party/modsuperoed/

# Build artifacts
build/
# Keep a Godot ignore sentinel in the in-project GDExtension build tree. MSVC
# object files also use .obj, which Godot otherwise treats as Wavefront meshes.
!godot/src/build/
godot/src/build/*
!godot/src/build/.gdignore
*.o
*.os
*.a
*.so
*.dll
*.dylib
*.lib
*.exp
*.pdb
*.wasm

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# SCons
.sconsign.dblite
*.pyc
__pycache__/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
compile_commands.json
Testing/Temporary/

# Runtime logs
*.log

# Terraform (state, providers, and operator var-files are never committed; the
# .terraform.lock.hcl provider pins and *.tfvars.example ARE committed; see DEPLOY.md)
infra/aws/.terraform/
infra/github/.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
*.auto.tfvars

# Shared library build directories
build-*/
build_*/
dist/

# OS files
.DS_Store
Thumbs.db
TODO

# Godot
godot/.godot/
*.TMP
godot/exports/
.godot-bin/
godot/addons/gut/
godot/addons/imgui-godot/

CLAUDE.local.md
.superpowers/

.scratch/

# Retail capture restore tokens bind machine-local absolute install paths.
*.restore-token.local.json

# Local-only Windows dev helper: per-machine compose override that moves the NovaWorld UDP
# port off the Hyper-V/WinNAT reserved range (see DEVELOPING.md). Not for commit.
deploy/compose/docker-compose.winport.yml

# Local reverse-engineering notes/dumps
ida_dumps/
stripify_call_*.log

# Loose scratch dumps at the repo root (retail-derived data: never commit).
.scratch_*

# MSVC incremental-link databases: build output, never tracked (a 165 MB one
# was committed by accident in ba5db60c).
*.ilk

# Isolated user:// for the GUT suite (scripts/test_godot.sh) so tests cannot
# write the developer's real Godot user directory.
/.godot-test-user/

# The CI checkout of opennova-net/opennova-reference-assets (the OPENNOVA_JO_ASSETS tree).
.reference-assets/

# The CI checkout of opennova-net/opennova-reference-retail-packed (the OPENNOVA_JO_DIR install).
.reference-retail-packed/

# Local retail data used by configured Godot worlds; never committed.
/local-data/
