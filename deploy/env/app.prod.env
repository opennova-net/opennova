# Non-secret values for a deployed NovaWorld stack (prod and staging alike).
# Committed on purpose: every release bundle carries this file, and the service
# host's converge passes it to docker compose first, so the env files after it
# override it:
#   /run/opennova/infra.env    what Terraform knows (the public address,
#                              ONNET_PUBLIC_HOST; the site's URL; the hosted
#                              machines' settings): SSM /opennova/<deployment>/infra.env
#   release.env                the release's images, pinned by digest
#   /run/opennova/secret.env   the vault's secrets (secrets sync)
#
# The site is https behind Cloudflare (proxied web records, infra/aws), so the
# website session cookie is Secure; the server speaks plain http behind nginx and
# cannot tell on its own.
ONNET_COOKIE_SECURE=1
# The proxies whose X-Real-IP names the client (the website login/register rate
# limits): the portal's nginx, which reaches the server from its fixed address
# on the `edge` bridge network (deploy/compose/docker-compose.prod.yml), and the
# host's loopback, from which only the host itself calls (the toolbox's `fleet`
# commands, over SSM, with the admin token).
ONNET_TRUSTED_PROXIES=172.30.0.10,127.0.0.1
# /api/ answers those proxies alone: the server's port 8080 is open to the
# internet for the retail client, whose NW*.dll and .gsb routes stay open on it,
# but the website's API is reached only through nginx and its edge checks.
ONNET_API_PROXY_ONLY=1
# The server's database connections at most (DATABASE_URL comes from infra.env,
# DATABASE_PASSWORD from the vault). db.t4g.micro takes about 80 in all.
DATABASE_POOL_MAX=16
