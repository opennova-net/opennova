# Non-secret prod values for the NovaWorld stack. Committed on purpose.
# Secrets (admin token + basic-auth) are injected separately from the
# vault via app.prod.env.tpl. Set ONNET_PUBLIC_HOST to the prod EIP or the
# nw.<domain> record's resolved IP before the first deploy.
ONNET_PUBLIC_HOST=54.162.79.147
# The site is https behind Cloudflare (proxied web records, infra/aws), so the
# website session cookie is Secure; nginx and the server speak plain http
# behind it and cannot tell on their own.
ONNET_COOKIE_SECURE=1
# The web container's nginx (host networking) reaches the server from the
# loopback; its X-Real-IP names the client for the login/register rate limits.
ONNET_TRUSTED_PROXIES=127.0.0.1
