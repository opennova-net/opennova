# Dev environment for the local NovaWorld stack. Committed on purpose:
# these are local-only, non-secret values. Prod values come from the
# 1Password vault via the deploy toolbox (see DEPLOY.md), never from a
# committed file.

# The server advertises this host in its gate response. 127.0.0.1 works
# when retail JO runs on the same machine with the launcher in dev mode.
# Override to your LAN IP to test from a second machine.
ONNET_PUBLIC_HOST=127.0.0.1

# Local admin basic-auth for the web /admin area (dev only).
ADMIN_BASIC_AUTH_USER=admin
ADMIN_BASIC_AUTH_PASSWORD=admin

# Enables the admin API on the C++ server (dev token; rotate in prod).
ADMIN_API_TOKEN=dev-admin-token
