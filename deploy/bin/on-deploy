#!/usr/bin/env bash
# OpenNova NovaWorld deploy orchestrator. Runs inside the deploy toolbox
# container (deploy/Dockerfile). The operator supplies only
# OP_SERVICE_ACCOUNT_TOKEN; every other secret is read from the 1Password
# vault at run time and rendered to a tmpfs (/run/secrets) that never
# touches disk.
#
# Subcommands:
#   secrets check                 dry-run every op:// reference
#   infra plan|apply|destroy      terraform (AWS + Cloudflare); plan and apply pass
#                                 further terraform args on (-replace=ADDRESS)
#   infra output|list [args...]   terraform output / state list
#   aws <args...>                 run the AWS CLI with vault credentials
#   app deploy [--tag SHA] [--game-tag SHA] [--serve-tag TAG] [--no-hosting]
#                                 pull the Terraform state, then GHCR images +
#                                 compose up on the target;
#                                 with hosted game servers set up (infra output
#                                 hosted_enabled), the service gets every
#                                 ONNET_HOSTED_* ec2 setting from the Terraform
#                                 outputs and the serve image pinned to the digest
#                                 --serve-tag (default latest) names now;
#                                 --no-hosting deploys with hosting off
#   app status|logs [svc]|restart|down
#   app sql <statement>           run SQL against the live sqlite DB
#   app reset-db --yes-drop-database --tag SHA [--game-tag SHA] [--serve-tag TAG]
#                [--no-hosting] [--no-backup]
#                                 delete the sqlite DB, then deploy SHA onto an
#                                 empty one (a deploy with an edited migration;
#                                 DEPLOY.md "Resetting the service database").
#                                 Takes a final backup first unless --no-backup;
#                                 earlier backups stay in S3
#   backup now|list               trigger / list the sqlite backups
#   state push|pull [--force]     terraform state <-> 1Password document; a pull
#                                 refuses to overwrite a newer local state
#                                 unless --force
#   hosted status [--deployment NAME]
#                                 this deployment's hosted game server machines
#   hosted data-snapshot          the hosted servers' game data, once: the Joint
#                                 Operations folder mounted at /hosted-data
#                                 (HOSTED_DATA_DIR=<folder> ./deploy/run.sh ...)
#                                 into a new private encrypted EBS snapshot;
#                                 prints its id (DEPLOY.md, "Hosted game servers")
#
# OP_VAULT (default OpenNova-Deploy) names the vault.
set -euo pipefail

VAULT="${OP_VAULT:-OpenNova-Deploy}"
SECRETS_DIR="/run/secrets"
TF_DIR="/workspace/infra/aws"
COMPOSE_DIR="/workspace/deploy/compose"
TF_ENV_TPL="/workspace/deploy/env/terraform.env.tpl"
APP_ENV_TPL="/workspace/deploy/env/app.prod.env.tpl"

# Progress/diagnostics go to STDERR so stdout stays clean for captured output
# (e.g. `infra output -raw`, `aws ...` in command substitutions).
log()  { printf '\033[1;36m[deploy]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[deploy:error]\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

require_op() {
  [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || die "OP_SERVICE_ACCOUNT_TOKEN is not set"
  op whoami >/dev/null 2>&1 || die "1Password auth failed (check OP_SERVICE_ACCOUNT_TOKEN)"
}

# Render an op:// template to a tmpfs file (0600). Echoes the path.
inject() {
  local tpl="$1" out="$2"
  op inject -i "$tpl" -o "$out" -f >/dev/null
  chmod 600 "$out"
  printf '%s' "$out"
}

# Read the SSH private key from the vault to a tmpfs file; echo the path.
ssh_key_file() {
  local key="$SECRETS_DIR/ssh_key"
  op read "op://$VAULT/ssh/private key?ssh-format=openssh" > "$key"
  chmod 600 "$key"
  printf '%s' "$key"
}

# Resolve the target host IP: explicit override, else terraform output.
target_ip() {
  if [ -n "${TARGET_HOST:-}" ]; then
    printf '%s' "$TARGET_HOST"
    return
  fi
  terraform -chdir="$TF_DIR" output -raw public_ip 2>/dev/null \
    || die "no public_ip output; run 'infra apply' first or set TARGET_HOST"
}

tf_init() {
  terraform -chdir="$TF_DIR" init -input=false >/dev/null
}

# ---------------------------------------------------------------------------
cmd_secrets() {
  require_op
  case "${1:-check}" in
    check)
      log "checking vault '$VAULT' references (dry run)…"
      local rc=0
      if op inject -f -i "$TF_ENV_TPL" -o /dev/null >/dev/null; then
        log "  terraform.env.tpl    OK"
      else
        err "  terraform.env.tpl    FAILED"; rc=1
      fi
      if op inject -f -i "$APP_ENV_TPL" -o /dev/null >/dev/null; then
        log "  app.prod.env.tpl     OK"
      else
        err "  app.prod.env.tpl     FAILED"; rc=1
      fi
      if op read "op://$VAULT/ssh/private key?ssh-format=openssh" >/dev/null; then
        log "  ssh private key      OK"
      else
        err "  ssh private key      FAILED"; rc=1
      fi
      # Optional: hosted game servers are off without it (DEPLOY.md, "Hosted game servers").
      if op read "op://$VAULT/hosted/data_snapshot_id" >/dev/null 2>&1; then
        log "  hosted data snapshot OK"
      else
        log "  hosted data snapshot absent (hosted game servers off)"
      fi
      [ "$rc" -eq 0 ] || die "one or more references did not resolve — create the missing vault items (DEPLOY.md §1)"
      log "all references resolved."
      ;;
    *) die "unknown: secrets $1 (try: check)" ;;
  esac
}

# The hosted game servers' data snapshot (infra/aws/hosted.tf), from the vault:
# item `hosted`, field `data_snapshot_id`, as TF_VAR_hosted_data_snapshot_id.
# No `hosted` item means hosting is off (the variable stays empty, and hosted.tf
# makes nothing). Any other failure to read it stops the run, so a vault hiccup
# never plans the hosting resources away.
hosted_snapshot_var() {
  local value errfile="$SECRETS_DIR/hosted-read.err" err
  if value="$(op read "op://$VAULT/hosted/data_snapshot_id" 2>"$errfile")"; then
    rm -f "$errfile"
    export TF_VAR_hosted_data_snapshot_id="$value"
    log "hosted game servers: data snapshot '${value:-<empty>}' (vault item 'hosted')"
    return
  fi
  err="$(cat "$errfile" 2>/dev/null || true)"
  rm -f "$errfile"
  case "$err" in
    *"isn't an item"*)
      export TF_VAR_hosted_data_snapshot_id=""
      log "hosted game servers: off (no 'hosted' item in vault '$VAULT')" ;;
    *) die "reading op://$VAULT/hosted/data_snapshot_id failed: ${err:-no error text}. Refusing to run terraform with hosting unknown (fix the vault access, or delete the 'hosted' item to turn hosting off)" ;;
  esac
}

cmd_infra() {
  require_op
  cmd_state pull
  tf_init
  local action="${1:-plan}"
  case "$action" in
    plan|apply|destroy) hosted_snapshot_var ;;
  esac
  log "terraform $action…"
  # op run injects AWS + Cloudflare + ssh pubkey as env for the terraform run.
  # plan and apply pass any further arguments on (say a -replace=ADDRESS).
  shift || true
  case "$action" in
    plan)    op run --env-file="$TF_ENV_TPL" -- terraform -chdir="$TF_DIR" plan -input=false "$@" ;;
    apply)   op run --env-file="$TF_ENV_TPL" -- terraform -chdir="$TF_DIR" apply -input=false -auto-approve "$@"
             cmd_state push ;;
    destroy) op run --env-file="$TF_ENV_TPL" -- terraform -chdir="$TF_DIR" destroy -input=false -auto-approve
             cmd_state push ;;
    output)  terraform -chdir="$TF_DIR" output "$@" ;;
    list)    terraform -chdir="$TF_DIR" state list "$@" ;;
    *) die "unknown: infra $action (try: plan|apply|destroy|output|list)" ;;
  esac
}

# Run the AWS CLI with credentials injected from the vault, so the operator
# never configures AWS locally. The CLI can't run natively on this Alpine
# image (musl vs python-aws-cli), so we shell out to the official glibc
# `amazon/aws-cli` image via the mounted Docker socket. `op run` resolves the
# AWS_* refs in terraform.env.tpl into the env, and `docker run -e` forwards
# them (by name) into the aws container, whose entrypoint is `aws`.
#   ./deploy/run.sh aws ec2 describe-instances ...
AWS_CLI_IMAGE="${AWS_CLI_IMAGE:-amazon/aws-cli:latest}"
cmd_aws() {
  require_op
  op run --env-file="$TF_ENV_TPL" -- \
    docker run --rm -i \
      -e AWS_ACCESS_KEY_ID -e AWS_SECRET_ACCESS_KEY \
      -e AWS_REGION -e AWS_DEFAULT_REGION \
      "$AWS_CLI_IMAGE" "$@"
}

# Build the compose invocation for the remote host (DOCKER_HOST=ssh://).
remote_compose() {
  local ip key app_env
  ip="$(target_ip)"
  key="$(ssh_key_file)"
  app_env="$(inject "$APP_ENV_TPL" "$SECRETS_DIR/app.prod.env")"
  export DOCKER_HOST="ssh://ubuntu@${ip}"
  # docker's ssh:// transport invokes `ssh` WITHOUT -i (there is no DOCKER_SSH_OPTS
  # variable), so it must find the vault key via ~/.ssh/config. Point the host's
  # IdentityFile at the tmpfs key; IdentitiesOnly avoids agent/default-key probing.
  mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
  cat > "$HOME/.ssh/config" <<SSHCFG
Host ${ip}
  HostName ${ip}
  User ubuntu
  IdentityFile ${key}
  IdentitiesOnly yes
  StrictHostKeyChecking accept-new
SSHCFG
  chmod 600 "$HOME/.ssh/config"
  # The prod overlay's backup sidecar interpolates ${BACKUP_BUCKET} (required),
  # and every compose invocation parses it — so resolve it for ALL app actions
  # (deploy/status/logs/...), not just `backup`. From the AWS tf output; the
  # state file is on the mounted disk from `infra apply`.
  BACKUP_BUCKET="$(terraform -chdir="$TF_DIR" output -raw backup_bucket_name 2>/dev/null || true)"
  export BACKUP_BUCKET
  # The prod overlay requires SERVER_IMAGE/WEB_IMAGE/GAME_IMAGE to interpolate for EVERY
  # compose action (status/logs/down parse them too), but only `deploy` sets
  # them from --tag. Default the rest so those actions work; `ps`/`logs` match
  # by service name, not image, so the tag is immaterial there. `:-` keeps the
  # explicit values `deploy` already exported.
  local owner; owner="$(op read "op://$VAULT/ghcr/owner" 2>/dev/null || echo opennova-net)"
  export SERVER_IMAGE="${SERVER_IMAGE:-ghcr.io/${owner}/novaworld-server:latest}"
  export WEB_IMAGE="${WEB_IMAGE:-ghcr.io/${owner}/novaworld-web:latest}"
  export GAME_IMAGE="${GAME_IMAGE:-ghcr.io/${owner}/opennova-game:latest}"
  # compose files + env, evaluated against the remote engine.
  COMPOSE_ARGS=(-f "$COMPOSE_DIR/docker-compose.yml"
                -f "$COMPOSE_DIR/docker-compose.prod.yml"
                --env-file "$COMPOSE_DIR/../env/app.prod.env"
                --env-file "$app_env")
}

# The one compose invocation every app/backup action runs: COMPOSE_ARGS (set
# by remote_compose) against whatever engine DOCKER_HOST names.
app_compose() {
  docker compose "${COMPOSE_ARGS[@]}" "$@"
}

# The deployed images. --tag moves the server + portal pair; the game image
# (the web build, ADR 0049) publishes on its own path filter, so it has its
# own tag.
app_images() {
  local tag="$1" game_tag="$2" owner
  owner="$(op read "op://$VAULT/ghcr/owner" 2>/dev/null || echo opennova-net)"
  export SERVER_IMAGE="ghcr.io/${owner}/novaworld-server:${tag}"
  export WEB_IMAGE="ghcr.io/${owner}/novaworld-web:${tag}"
  export GAME_IMAGE="ghcr.io/${owner}/opennova-game:${game_tag}"
}

# The hosted game servers' settings for the service (apps/novaworld_server/
# README.md, "Hosted servers"), from the Terraform outputs, so nobody copies an
# id by hand: while hosted_data_snapshot_id is set (output hosted_enabled),
# ONNET_HOSTED_PROVIDER=ec2 and every ec2 setting, and the serve image pinned to
# the digest `serve_tag` names right now; with an explicit false, or with
# --no-hosting (`hosting` 0), ONNET_HOSTED_PROVIDER=none. A state with no
# hosted_enabled output at all (one the infra was not applied to since hosted.tf
# came) is no answer: the deploy stops, never reading it as off. The caller has
# pulled the state. Exported for compose's interpolation (docker-compose.yml
# passes them to the server); the shell's values win over the env files'.
hosted_app_env() {
  local serve_tag="$1" hosting="$2" enabled owner ref digest
  if [ "$hosting" -eq 0 ]; then
    export ONNET_HOSTED_PROVIDER=none
    log "hosted game servers: off (--no-hosting)"
    return
  fi
  enabled="$(terraform -chdir="$TF_DIR" output -raw hosted_enabled 2>/dev/null)" \
    || die "no 'hosted_enabled' infra output: run 'infra apply' first (with hosting off it only adds outputs), or deploy with --no-hosting"
  case "$enabled" in
    true) ;;
    false)
      export ONNET_HOSTED_PROVIDER=none
      log "hosted game servers: off (no data snapshot in the infra; DEPLOY.md, \"Hosted game servers\")"
      return ;;
    *) die "the 'hosted_enabled' infra output reads '$enabled', neither true nor false" ;;
  esac
  tf_output() {
    terraform -chdir="$TF_DIR" output -raw "$1" 2>/dev/null \
      || die "no '$1' output; run 'infra apply' (hosted_data_snapshot_id is set, its resources are not)"
  }
  ONNET_HOSTED_EC2_REGION="$(tf_output region)"
  ONNET_HOSTED_EC2_LAUNCH_TEMPLATE="$(tf_output hosted_launch_template_id)"
  ONNET_HOSTED_EC2_SUBNET="$(tf_output hosted_subnet_id)"
  ONNET_HOSTED_DEPLOYMENT="$(tf_output hosted_deployment)"
  ONNET_HOSTED_SERVICE_ADDRESS="$(tf_output service_private_ip)"
  ONNET_HOSTED_BOOTSTRAP_CIDRS="$(tf_output hosted_subnet_cidr)"
  owner="$(op read "op://$VAULT/ghcr/owner" 2>/dev/null || echo opennova-net)"
  ref="ghcr.io/${owner}/opennova-serve:${serve_tag}"
  digest="$(docker buildx imagetools inspect "$ref" --format '{{json .Manifest}}' 2>/dev/null | jq -r '.digest // empty')"
  case "$digest" in
    sha256:*) ;;
    *) die "cannot resolve $ref to a digest (is the opennova-serve package public, and the tag published?)" ;;
  esac
  ONNET_HOSTED_SERVE_IMAGE="ghcr.io/${owner}/opennova-serve@${digest}"
  export ONNET_HOSTED_PROVIDER=ec2 ONNET_HOSTED_EC2_REGION ONNET_HOSTED_EC2_LAUNCH_TEMPLATE \
    ONNET_HOSTED_EC2_SUBNET ONNET_HOSTED_DEPLOYMENT ONNET_HOSTED_SERVICE_ADDRESS \
    ONNET_HOSTED_BOOTSTRAP_CIDRS ONNET_HOSTED_SERVE_IMAGE
  log "hosted game servers: ec2 in $ONNET_HOSTED_EC2_REGION, launch template $ONNET_HOSTED_EC2_LAUNCH_TEMPLATE,"
  log "  subnet $ONNET_HOSTED_EC2_SUBNET ($ONNET_HOSTED_BOOTSTRAP_CIDRS), deployment $ONNET_HOSTED_DEPLOYMENT,"
  log "  service $ONNET_HOSTED_SERVICE_ADDRESS, image $ref = $ONNET_HOSTED_SERVE_IMAGE"
}

check_target() {
  ssh -i "$(ssh_key_file)" -o StrictHostKeyChecking=accept-new \
    "ubuntu@$(target_ip)" "docker --version" >/dev/null \
    || die "cannot reach docker on the target over SSH"
}

# Pull only the published images; the backup sidecar has no registry image
# (it's built from deploy/backup/), so a blanket `pull` fails on it.
app_pull() {
  app_compose pull novaworld web game
}

# `up --build` pulls server/web/game (pull_policy: always) and builds the backup
# sidecar on the remote in one shot. It also starts any stopped service.
app_up() {
  app_compose up -d --remove-orphans --build
}

# The novaworld image the target holds now (running or stopped), with the tag its
# build revision publishes under: what undoing a reset deploys again.
running_server() {
  local cid image rev
  if ! cid="$(app_compose ps --all -q novaworld 2>/dev/null)"; then
    printf 'unknown (compose ps failed)'; return
  fi
  cid="${cid%%$'\n'*}"
  [ -n "$cid" ] || { printf 'none'; return; }
  image="$(docker inspect -f '{{.Config.Image}}' "$cid" 2>/dev/null || true)"
  rev="$(docker inspect -f '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$cid" 2>/dev/null || true)"
  printf '%s' "${image:-unknown}"
  if [ -n "$rev" ]; then printf ', revision %s (--tag sha-%s)' "$rev" "${rev:0:7}"; fi
}

# app reset-db: delete the service's SQLite database and deploy onto an empty
# one. The database is disposable: a schema fix edits a migration in place,
# and the server records applied migrations by file name only
# (_schema_migrations, engine/net/novaworld/db/sqlite.h), so an edited file
# never runs again on an existing database. Such a deploy starts from nothing.
#
# It takes --tag and deploys itself rather than leaving the server stopped:
# the first server to boot on the empty database applies and records every
# migration, so that boot must be the image carrying the edit. Any other (an
# `app restart` of the old container, a deploy of an older tag) writes the old
# schema under the same file names and the reset is spent with no error.
# Deploying in the same command also pulls the new images before anything is
# stopped, so a mistyped tag fails while the database is still there.
#
# The final backup is on by default: the nightly snapshot can be a day old, and
# the reset cannot be undone without one. --no-backup is for a database known
# to be worthless or a backup path that is itself broken.
app_reset_db() {
  local tag="" game_tag="latest" serve_tag="latest" hosting=1 confirmed=0 backup=1
  while [ $# -gt 0 ]; do
    case "$1" in
      --yes-drop-database) confirmed=1; shift ;;
      --tag)      [ $# -ge 2 ] || die "--tag needs a value"; tag="$2"; shift 2 ;;
      --game-tag) [ $# -ge 2 ] || die "--game-tag needs a value"; game_tag="$2"; shift 2 ;;
      --serve-tag) [ $# -ge 2 ] || die "--serve-tag needs a value"; serve_tag="$2"; shift 2 ;;
      --no-hosting) hosting=0; shift ;;
      --no-backup) backup=0; shift ;;
      *) die "unknown: app reset-db $1 (try: --yes-drop-database --tag SHA [--game-tag SHA] [--serve-tag TAG] [--no-hosting] [--no-backup])" ;;
    esac
  done
  [ -n "$tag" ] || die "app reset-db needs --tag SHA: the server image carrying the edited migration, deployed onto the empty database"

  # The target and the hosted settings come from the Terraform state.
  cmd_state pull
  app_images "$tag" "$game_tag"
  remote_compose
  # The deploy below recreates the server: with the same hosted settings as
  # `app deploy`. (A reset drops every hosted server's row: stop them all from
  # the admin fleet view first, or the next boot's reconciliation ends their
  # machines, which no row names.)
  hosted_app_env "$serve_tag" "$hosting"
  # Read-only lookups for the plan. A compose file that does not parse leaves
  # them blank here, and the pull below fails with compose's own error.
  local project volume running
  project="$(app_compose config 2>/dev/null | sed -n 's/^name: //p' | head -n 1 || true)"
  volume="${project:+${project}_}nw_data"
  running="$(running_server)"

  log "app reset-db on $(target_ip) will:"
  log "  1. pull $SERVER_IMAGE + $WEB_IMAGE + $GAME_IMAGE (a bad tag stops here, before anything changes)"
  log "  2. stop novaworld and the backup sidecar (web and game stay up; the site's API is down until step 5)"
  if [ "$backup" -eq 1 ]; then
    log "  3. take a final backup to s3://${BACKUP_BUCKET:-<backup bucket>}/ (as 'backup now'); if it fails, start both again and stop here"
  else
    log "  3. take NO final backup (--no-backup)"
  fi
  log "  4. delete novaworld.db and its -wal, -shm and -journal files from the volume $volume"
  log "  5. deploy into a fresh novaworld container (compose up): its first boot applies every migration to the empty database"
  log "novaworld now: $running"
  log "Earlier backups stay in S3 (90-day lifecycle). Each records every migration it ran, so undoing"
  log "the reset takes both: restore one AND deploy the server tag above (a newer server on it skips"
  log "every migration and runs the old schema without a word)."
  [ "$confirmed" -eq 1 ] || die "refusing to drop the database without --yes-drop-database"

  check_target
  log "pulling the images…"
  app_pull || die "the pull failed; nothing was stopped or deleted"
  log "stopping novaworld + backup…"
  app_compose stop novaworld backup \
    || die "stopping novaworld + backup failed; nothing was deleted (app status shows what runs)"
  if [ "$backup" -eq 1 ]; then
    log "taking the final backup…"
    if ! app_compose run --rm --no-deps backup /backup/backup.sh; then
      app_compose start novaworld backup || true
      die "the final backup failed; nothing was deleted and novaworld + backup were started again (fix the backup, or pass --no-backup)"
    fi
  fi
  log "deleting the database files…"
  # One-off container of the backup sidecar: it mounts the same nw_data volume
  # as the server, and DATABASE_PATH names the same file.
  # shellcheck disable=SC2016  # expanded by the container's sh, not here
  app_compose run --rm --no-deps backup sh -c '
    set -eu
    db="$DATABASE_PATH"
    rm -f "$db" "$db-wal" "$db-shm" "$db-journal"
    for f in "$db" "$db-wal" "$db-shm" "$db-journal"; do
      if [ -e "$f" ]; then echo "still present: $f" >&2; exit 1; fi
    done
    echo "[reset-db] deleted $db (+ -wal, -shm, -journal); $(dirname "$db") now holds:"
    ls -la "$(dirname "$db")"' \
    || die "deleting the database files failed; novaworld + backup are stopped and nothing was deployed (rerun reset-db)"

  # Only the new image may boot first on the empty database (see above). The
  # stopped server container goes too, so the deploy creates a fresh one whose
  # log holds nothing but its boots on the empty database.
  local redeploy="app deploy --tag $tag --game-tag $game_tag (not app restart)"
  app_compose rm -f novaworld \
    || die "removing the stopped novaworld container failed; the database is deleted and nothing was deployed; run: $redeploy"
  log "deploying onto the empty database…"
  app_up || die "the deploy onto the empty database failed; rerun: $redeploy"
  # The first boot logs its migration count; on an empty database every file
  # applies and none is skipped. "0 applied, 0 skipped" means the server found
  # no migrations at all (run_migrations on a missing MIGRATIONS_DIR).
  local line="" _
  for _ in $(seq 1 30); do
    line="$(app_compose logs --no-log-prefix novaworld 2>/dev/null \
              | grep -m 1 '\[boot\] migrations:' || true)"
    [ -n "$line" ] && break
    sleep 2
  done
  case "$line" in
    *": "[1-9]*" applied, 0 skipped"*) log "novaworld: $line" ;;
    "") die "novaworld logged no '[boot] migrations:' line in 60 s; check: app logs novaworld" ;;
    *) die "novaworld: $line (expected at least one applied and 0 skipped on an empty database; check: app logs novaworld)" ;;
  esac
  log "reset-db complete."
}

cmd_app() {
  require_op
  local action="${1:-status}"; shift || true
  case "$action" in
    deploy)
      local tag="latest" game_tag="latest" serve_tag="latest" hosting=1
      while [ $# -gt 0 ]; do
        case "$1" in
          --tag) tag="$2"; shift 2 ;;
          --game-tag) game_tag="$2"; shift 2 ;;
          --serve-tag) [ $# -ge 2 ] || die "--serve-tag needs a value"; serve_tag="$2"; shift 2 ;;
          --no-hosting) hosting=0; shift ;;
          *) die "unknown: app deploy $1 (try: --tag SHA, --game-tag SHA, --serve-tag TAG, --no-hosting)" ;;
        esac
      done
      # The target and the hosted settings come from the Terraform state.
      cmd_state pull
      app_images "$tag" "$game_tag"
      remote_compose
      hosted_app_env "$serve_tag" "$hosting"
      log "deploying $SERVER_IMAGE + $WEB_IMAGE + $GAME_IMAGE to $(target_ip)…"
      check_target
      app_pull
      app_up
      log "deploy complete."
      ;;
    status)  remote_compose; app_compose ps ;;
    logs)    remote_compose; app_compose logs --tail=200 "${1:-}" ;;
    restart) remote_compose; app_compose restart "${1:-}" ;;
    down)    remote_compose; app_compose down ;;
    # Run SQL against the live SQLite DB via the backup sidecar (it has sqlite3
    # and the nw_data volume rw). E.g. one-off admin cleanup.
    sql)     remote_compose; app_compose exec -T backup \
               sqlite3 /data/novaworld.db "$*" ;;
    reset-db) app_reset_db "$@" ;;
    *) die "unknown: app $action (try: deploy|status|logs|restart|down|sql|reset-db)" ;;
  esac
}

cmd_backup() {
  require_op
  # The backup S3 bucket comes from terraform output.
  BACKUP_BUCKET="$(terraform -chdir="$TF_DIR" output -raw backup_bucket_name 2>/dev/null || true)"
  [ -n "$BACKUP_BUCKET" ] || die "no backup_bucket_name output; run 'infra apply' first"
  export BACKUP_BUCKET
  case "${1:-now}" in
    now)  remote_compose; app_compose run --rm backup /backup/backup.sh ;;
    list) remote_compose; app_compose run --rm backup /backup/list.sh ;;
    *) die "unknown: backup $1 (try: now|list)" ;;
  esac
}

# A state file's serial (terraform bumps it at every change); 0 when the file
# has none or is no state at all.
state_serial() {
  local serial
  serial="$(jq -r '.serial // 0' "$1" 2>/dev/null || true)"
  case "$serial" in
    ''|*[!0-9]*) echo 0 ;;
    *) echo "$serial" ;;
  esac
}

cmd_state() {
  require_op
  # Optional args let other stacks reuse this:
  #   state <pull|push> [--force] [doc] [tfdir]
  # Defaults target the AWS stack (tfstate / infra/aws). A pull refuses to
  # overwrite a local state newer (a higher serial) than the vault's, which an
  # apply whose push never ran leaves behind, unless --force; and only a vault
  # that has no such document reads as a first run: any other failure stops,
  # so no command goes on with a state of unknown age.
  local action="${1:-pull}" force=0
  shift || true
  if [ "${1:-}" = "--force" ]; then force=1; shift; fi
  local doc="${1:-tfstate}"
  local tfdir="${2:-$TF_DIR}"
  local statefile="$tfdir/terraform.tfstate"
  local fetched="$SECRETS_DIR/state-pull.tfstate" errfile="$SECRETS_DIR/state.err" err local_serial remote_serial
  case "$action" in
    pull) log "pulling state '$doc' from vault…"
          mkdir -p "$(dirname "$statefile")"
          # `op document get --out-file` echoes the path to STDOUT — redirect it
          # so it can't pollute captured output (e.g. `$(... infra output -raw)`,
          # which runs a state pull first). All progress goes via log() to stderr.
          # It lands on the tmpfs first, and replaces the local state only once
          # it is known not to be older.
          if ! op document get "$doc" --vault "$VAULT" --out-file "$fetched" --force >/dev/null 2>"$errfile"; then
            err="$(cat "$errfile" 2>/dev/null || true)"
            rm -f "$errfile" "$fetched"
            case "$err" in
              *"isn't an item"*) log "no remote state yet (first run)"; return ;;
              *) die "pulling state '$doc' from vault '$VAULT' failed: ${err:-no error text}. Refusing to go on with a state of unknown age (run again once the vault answers)" ;;
            esac
          fi
          rm -f "$errfile"
          if [ -f "$statefile" ] && [ "$force" -eq 0 ]; then
            local_serial="$(state_serial "$statefile")"
            remote_serial="$(state_serial "$fetched")"
            if [ "$local_serial" -gt "$remote_serial" ]; then
              rm -f "$fetched"
              die "the local $statefile (serial $local_serial) is newer than vault document '$doc' (serial $remote_serial): an apply whose push never ran? Push it (state push), or overwrite it (state pull --force)"
            fi
          fi
          mv -f "$fetched" "$statefile"
          log "wrote $statefile" ;;
    push) log "pushing state to vault document '$doc'…"
          [ -f "$statefile" ] || die "no local state at $statefile"
          if op document get "$doc" --vault "$VAULT" >/dev/null 2>"$errfile"; then
            rm -f "$errfile"
            op document edit "$doc" "$statefile" --vault "$VAULT"
          else
            err="$(cat "$errfile" 2>/dev/null || true)"
            rm -f "$errfile"
            case "$err" in
              *"isn't an item"*) op document create "$statefile" --title "$doc" --vault "$VAULT" ;;
              *) die "reading vault document '$doc' failed: ${err:-no error text}. Not pushing (a second document would split the state); run state push again once the vault answers" ;;
            esac
          fi
          log "state pushed." ;;
    *) die "unknown: state $action (try: pull|push)" ;;
  esac
}

# ---------------------------------------------------------------------------
# Hosted game servers (ADR 0053; DEPLOY.md "Hosted game servers")
# ---------------------------------------------------------------------------

# Where the Joint Operations folder is mounted into this container for
# `hosted data-snapshot` (run.sh and run.ps1 mount HOSTED_DATA_DIR there).
HOSTED_DATA_MOUNT=/hosted-data
HOSTED_DATA_IMAGE=opennova-hosted-data:local

# The deployment tag the hosted machines carry: --deployment, else the infra's
# output, else the stack's default name (instance_name's default).
hosted_deployment() {
  local given="$1" out
  if [ -n "$given" ]; then printf '%s' "$given"; return; fi
  out="$(terraform -chdir="$TF_DIR" output -raw hosted_deployment 2>/dev/null || true)"
  printf '%s' "${out:-opennova-server}"
}

# hosted status: every machine this deployment tagged (the service's own
# listing's scope), with its server, state and addresses.
hosted_status() {
  local given="" dep
  while [ $# -gt 0 ]; do
    case "$1" in
      --deployment) [ $# -ge 2 ] || die "--deployment needs a value"; given="$2"; shift 2 ;;
      *) die "unknown: hosted status $1 (try: --deployment NAME)" ;;
    esac
  done
  dep="$(hosted_deployment "$given")"
  log "hosted machines tagged opennova:deployment=$dep:"
  # shellcheck disable=SC2016  # a JMESPath literal, not a shell expansion
  cmd_aws ec2 describe-instances \
    --filters "Name=tag:opennova:hosted,Values=1" "Name=tag:opennova:deployment,Values=$dep" \
    --query 'Reservations[].Instances[].{machine:InstanceId,server:Tags[?Key==`opennova:server-id`]|[0].Value,state:State.Name,type:InstanceType,private:PrivateIpAddress,public:PublicIpAddress,launched:LaunchTime}' \
    --output table
}

# hosted data-snapshot: the hosted servers' game data, once, as a private
# encrypted EBS snapshot. The Joint Operations Combined Arms folder is mounted
# here (HOSTED_DATA_MOUNT) read-only; only the files opennova-serve reads are
# taken (apps/serve/README.md, "Container image"): the three base archives,
# Escalation's archive pair and its version.txt (required), and score.ini and
# _NSTMOUT.TXT when present. They stream as a tar into the helper image
# (deploy/hosted-data), built on this docker, which makes an ext4 image of them
# labelled opennova-jo and writes it into a new snapshot through the EBS direct
# APIs: no machine, no bucket, no SSH. The snapshot is the only AWS resource it
# makes, and it deletes it on any failure; the image and the staging copy live
# in the helper's container alone (--rm). Prints the snapshot id.
hosted_data_snapshot() {
  local given="" dep dir="$HOSTED_DATA_MOUNT" rel found
  while [ $# -gt 0 ]; do
    case "$1" in
      --deployment) [ $# -ge 2 ] || die "--deployment needs a value"; given="$2"; shift 2 ;;
      *) die "unknown: hosted data-snapshot $1 (try: --deployment NAME)" ;;
    esac
  done
  if [ ! -d "$dir" ] || [ -z "$(ls -A "$dir" 2>/dev/null)" ]; then
    die "no Joint Operations folder at $dir: run HOSTED_DATA_DIR='<your JO:CA folder>' ./deploy/run.sh hosted data-snapshot (DEPLOY.md, \"Hosted game servers\")"
  fi
  local files=()
  for rel in resource.pff localres.pff language.pff expansion/jox01/jox01.pff \
             expansion/jox01/jox01L.pff expansion/jox01/version.txt; do
    found="$(cd "$dir" && find . -type f -ipath "./$rel" | head -n 1)"
    [ -n "$found" ] || die "$dir has no $rel: mount a Joint Operations Combined Arms install (with expansion/jox01)"
    files+=("${found#./}")
  done
  for rel in score.ini _nstmout.txt; do
    found="$(cd "$dir" && find . -maxdepth 1 -type f -iname "$rel" | head -n 1)"
    [ -z "$found" ] || files+=("${found#./}")
  done
  dep="$(hosted_deployment "$given")"
  log "the data snapshot takes, from $dir:"
  for rel in "${files[@]}"; do log "  $rel"; done
  log "building the helper image (deploy/hosted-data)…"
  docker build -q -t "$HOSTED_DATA_IMAGE" /workspace/deploy/hosted-data >/dev/null \
    || die "the helper image did not build"
  log "making the snapshot (tagged opennova:deployment=$dep); a GiB takes a few minutes…"
  # The vault's AWS credentials and region alone, for the helper, in the tmpfs.
  local all_env="$SECRETS_DIR/terraform.env" aws_env="$SECRETS_DIR/hosted-aws.env" snapshot rc=0
  inject "$TF_ENV_TPL" "$all_env" >/dev/null
  grep -E '^AWS_(ACCESS_KEY_ID|SECRET_ACCESS_KEY|REGION|DEFAULT_REGION)=' "$all_env" > "$aws_env" || true
  chmod 600 "$aws_env"
  rm -f "$all_env"
  snapshot="$( (cd "$dir" && tar -cf - "${files[@]}") \
    | docker run --rm -i --env-file "$aws_env" "$HOSTED_DATA_IMAGE" --deployment "$dep")" || rc=$?
  rm -f "$aws_env"
  [ "$rc" -eq 0 ] \
    || die "the snapshot was not made (the helper deletes one it started; check: ./deploy/run.sh aws ec2 describe-snapshots --owner-ids self --filters Name=tag:opennova:hosted-data,Values=1)"
  snapshot="$(printf '%s\n' "$snapshot" | tail -n 1)"
  case "$snapshot" in
    snap-*) ;;
    *) die "the helper printed no snapshot id ('$snapshot')" ;;
  esac
  log "made $snapshot. Next (DEPLOY.md, \"Hosted game servers\"):"
  log "  1. in vault '$VAULT', an item 'hosted' with the field data_snapshot_id = $snapshot"
  log "  2. ./deploy/run.sh infra plan, then infra apply"
  log "  3. ./deploy/run.sh app deploy --tag <server tag> --serve-tag <serve tag>"
  printf '%s\n' "$snapshot"
}

cmd_hosted() {
  require_op
  local action="${1:-status}"
  shift || true
  case "$action" in
    status)        hosted_status "$@" ;;
    data-snapshot) hosted_data_snapshot "$@" ;;
    *) die "unknown: hosted $action (try: status|data-snapshot)" ;;
  esac
}

# The header comment above `set -euo pipefail` is the help text.
usage() {
  sed -n '2,/^[^#]/p' "${BASH_SOURCE[0]}" | sed -e '$d' -e 's/^# \{0,1\}//'
}

main() {
  local group="${1:-help}"; shift || true
  case "$group" in
    secrets) cmd_secrets "$@" ;;
    infra)   cmd_infra "$@" ;;
    aws)     cmd_aws "$@" ;;
    app)     cmd_app "$@" ;;
    backup)  cmd_backup "$@" ;;
    state)   cmd_state "$@" ;;
    hosted)  cmd_hosted "$@" ;;
    help|-h|--help) usage ;;
    *) err "unknown command: $group"; usage; exit 1 ;;
  esac
}

# Run when executed. Sourced, it only defines the functions, so a local check
# can drive one (say app_reset_db) against a local engine with the vault,
# terraform and SSH steps stubbed.
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
