#!/usr/bin/env bash
# OpenNova NovaWorld deploy orchestrator (DEPLOY.md). Runs inside the deploy
# toolbox container (deploy/Dockerfile), or on a CI runner holding AWS
# credentials of its own (.github/workflows/deploy.yml). The operator supplies
# only OP_SERVICE_ACCOUNT_TOKEN; every other secret is read from the 1Password
# vault at run time into a tmpfs (/run/secrets) that never touches disk. The
# service's five programs (gate, lobby, web, controller, worker) run as ECS
# services on Fargate in the deployment's cluster; nothing is reached over SSH:
# a shell is ECS Exec, the database's commands one-off tasks.
#
# Usage: on-deploy [--deployment prod|staging] <command> [args...]
#
# Deployments (DEPLOY.md, "Deployments: dev, staging and prod"): prod and
# staging, each in an AWS account of its own, which the vault names (item
# aws-<deployment>; no tracked file names an account). A command
# that changes a deployment acts only on the one --deployment names: there is
# no default and no environment variable for it. A read-only command (secrets
# check, stripe check, infra output|list, app status|releases|logs|images,
# fleet status, backup list) without --deployment reads prod and says so.
# Every command prints the deployment and the account it acts in, and the
# toolbox refuses to act when its AWS credentials are another account's. On
# prod, every command that changes something asks first: type prod (or pass
# --yes; with no terminal and no --yes it refuses).
#
#   --deployment NAME   its AWS account and the keys of its deploy user
#                       (vault item aws-NAME; a command holds no other
#                       deployment's but where its flag says: `backup import
#                       --from-deployment prod` on staging, `app deploy
#                       --promote staging` on prod, each for its one read),
#                       its Terraform state (the account's own S3 bucket,
#                       its own lock),
#                       its var-file (infra/aws/NAME.tfvars), its SSM
#                       parameters (/opennova/NAME/...) and its vault items
#                       (app-NAME, rds-NAME, hosted-NAME; stripe-live for
#                       prod, stripe-test for staging)
#
# Commands:
#   secrets init                  add what the vault lacks: the deployment's
#                                 generated secrets and the shared placeholders
#                                 (Stripe, alerts/email, email/forward_to; never
#                                 overwrites; prints no value)
#   secrets check                 resolve every reference; check the Stripe items,
#                                 the alert address and the email destination
#   secrets sync [--prune] [--yes]
#                                 copy the deployment's runtime secrets to SSM
#                                 (/opennova/NAME/secret/*); --prune deletes the
#                                 ones the vault no longer names
#   stripe check                  the deployment's Stripe item (stripe-live on
#                                 prod, stripe-test on staging) and its objects,
#                                 read alone: the key's form and mode, the
#                                 webhook secret's form, each price (active,
#                                 monthly, the lookup key's), the Customer
#                                 Portal configuration, the webhook endpoint
#                                 (its URL, API version and events)
#   stripe setup [--tier1 USD] [--tier2 USD] [--tier3 USD] [--own-machine USD] [--yes]
#                                 make what the deployment's Stripe mode lacks,
#                                 idempotently: the products and monthly prices
#                                 (5, 10, 15 and 45 USD by default; a flag's
#                                 other amount makes a new price, the old one
#                                 kept as grandfathered), their ids in the vault
#                                 item, the Customer Portal configuration, the
#                                 webhook endpoint on the deployment's site (a
#                                 new one's signing secret into the vault)
#   infra plan [args...]          terraform plan of the deployment's stack
#   infra apply [--allow-destroy] [--yes] [args...]
#                                 plan to a file, then apply that plan; refuses a
#                                 plan that destroys or replaces an Elastic IP or
#                                 its association, an instance or a network
#                                 interface, the load balancer, the cluster or a
#                                 program's service, the controller's Cloud Map
#                                 namespace, the database, the cache or a bucket
#                                 unless --allow-destroy, and any plan that
#                                 makes prod a gate address
#   infra destroy [--yes]         (staging alone) destroy the deployment's stack
#   infra state-rm ADDRESS... [--yes]
#                                 forget resources (their objects stay)
#   infra import ADDRESS ID [--yes]
#                                 adopt an existing object
#   infra output|list [args...]   terraform output / state list
#   org plan|apply|import|output|list [args...]
#                                 the Organization (infra/org), as the
#                                 management account's opennova-org user (vault
#                                 item aws-org); no --deployment: the
#                                 Organization and both member accounts, and in
#                                 each account (through its
#                                 OrganizationAccountAccessRole) its state
#                                 bucket, the role boundary, the deploy user
#                                 opennova-deploy and its key, the GitHub deploy
#                                 role; its state in prod's state bucket. An
#                                 apply writes them into aws-prod and
#                                 aws-staging
#   zone plan|apply|import|output|list [args...]
#                                 the Cloudflare zone's shared settings
#                                 (infra/zone: Full (strict), each deployment's
#                                 edge authentication rule, the webhook rule,
#                                 Email Routing); no --deployment; its state in
#                                 prod's state bucket
#   github plan|apply|import|output|list [args...]
#                                 the GitHub organization opennova-net
#                                 (infra/github; DEPLOY.md, "GitHub"): its
#                                 settings, members, CI runners, repositories,
#                                 the deploy environments, branch protection and
#                                 Actions secrets; no --deployment; its state in
#                                 prod's state bucket
#   aws <args...>                 the AWS CLI in the deployment's account
#   app deploy [--tag T] [--image NAME=T|NAME=@sha256:D]... [--serve-tag T]
#              [--hostd-tag T] [--promote staging | --images-from FILE|-]
#              [--no-hosting] [--yes]
#                                 pin the images by digest (--tag sets the five
#                                 programs', the portal's and the backup task's;
#                                 --image one of them, or serve or hostd; an image
#                                 given no tag keeps the current release's;
#                                 --promote staging takes exactly the images
#                                 staging's current release runs, --images-from
#                                 the same from a JSON object), register each
#                                 program's task definition revision (Terraform's,
#                                 with the release's images and the secrets SSM
#                                 holds), roll the services to it, each followed
#                                 until its deployment completes: worker,
#                                 controller, web, lobby, then gate; then record
#                                 the release (a program at no task before the
#                                 first release starts at its count)
#   app images                    the current release's images, as JSON (what
#                                 --images-from takes)
#   app releases                  the deployment's releases, newest last
#   app rollback [--to ID] [--yes]
#                                 point every service back at the previous (or
#                                 the named) release's revisions; refuses one
#                                 made before the programs
#   app converge [--yes]          the current release again on Terraform's task
#                                 definitions and SSM's secrets as they are now
#                                 (after infra apply or secrets sync)
#   app status                    every program's service: its counts, its
#                                 rollout, its revision
#   app restart [PROGRAM] [--yes] new tasks for a program (every program without
#                                 one), the same revision
#   app down [--yes]              every program's count to 0 (recorded)
#   app up                        the recorded counts back
#   app logs [PROGRAM|backup] [--follow] [--since 1h]
#                                 the tasks' logs (CloudWatch; a program's
#                                 containers on every task)
#   app shell PROGRAM [CONTAINER] a root shell in a running task (ECS Exec;
#                                 web's portal nginx is CONTAINER portal)
#   db bootstrap [--yes]          make the service's role and its database
#                                 (SQL_ASCII, C collation) with the master user,
#                                 or set the role's password again; idempotent
#   db psql [-c SQL | -f FILE]    psql as the service's role (interactive without
#                                 SQL, over ECS Exec)
#   db reset-db --yes-drop-database [--orphan-subscriptions] [--no-backup] [--yes]
#                                 dump, then drop and recreate the database and
#                                 start every program on it (their migrations
#                                 run); refuses while a subscription grants
#                                 hosting (the db and backup commands run as
#                                 one-off tasks of the backup task definition)
#   db snapshot                   an RDS snapshot of the database, now
#   backup now|list               dump the database to the deployment's
#                                 operations bucket (novaworld/) / list the dumps
#   backup import - [--as NAME] [--yes]
#                                 a dump from stdin into the deployment's dumps
#                                 (novaworld/NAME, else
#                                 novaworld/novaworld-import-<time>.dump)
#   backup import --from-deployment prod KEY
#                                 (staging alone) a copy of prod's dump KEY into
#                                 staging's dumps: prod's data reaches staging by
#                                 this command alone, and staging's never
#                                 reaches prod
#   backup restore KEY --yes-overwrite-database [--yes]
#                                 restore one of the deployment's own dumps over
#                                 its database (every program is down meanwhile)
#   fleet status                  the deployment's game machines (EC2) and the
#                                 service's view of them (its admin API, in a
#                                 web task)
#   fleet drain MACHINE           start no server there; move its servers off
#   fleet end MACHINE [--yes]     end a machine (its servers move first)
#   fleet roll [--yes]            drain every machine onto new ones (a new
#                                 image, a new hostd), one at a time
#   fleet bake-image              bake the machines' image: a builder from
#                                 Canonical's newest Ubuntu 24.04 installs
#                                 docker and pulls the release's serve and hostd
#                                 images (deploy/host/fleet-image.sh); the image
#                                 of it becomes the one new machines launch
#                                 from (SSM .../fleet/image); the newest two
#                                 are kept
#   hosted data-snapshot --data-set SLUG
#                                 one data set of the hosted servers' game data,
#                                 once per deployment: its game folder mounted
#                                 at /hosted-data (HOSTED_DATA_DIR=<folder>
#                                 ./deploy/run.sh ...) into a new private
#                                 encrypted EBS snapshot in the deployment's
#                                 account; prints its id. SLUG: jop_2_consumer,
#                                 dfx2_consumer or opennova_0_consumer
#
# OP_VAULT (default OpenNova-Deploy) names the vault.
set -euo pipefail

ROOT="${OPENNOVA_ROOT:-/workspace}"
VAULT="${OP_VAULT:-OpenNova-Deploy}"
SECRETS_DIR="${OPENNOVA_SECRETS_DIR:-/run/secrets}"
TF_DIR="$ROOT/infra/aws"
ORG_TF_DIR="$ROOT/infra/org"
ZONE_TF_DIR="$ROOT/infra/zone"
GH_TF_DIR="$ROOT/infra/github"
ENV_DIR="$ROOT/deploy/env"
TF_ENV_TPL="$ENV_DIR/terraform.env.tpl"
ZONE_ENV_TPL="$ENV_DIR/zone.env.tpl"
ORG_ENV_TPL="$ENV_DIR/org.env.tpl"
GH_ENV_TPL="$ENV_DIR/github.env.tpl"
AWS_ENV_TPL="$ENV_DIR/aws.env.tpl"
RUNTIME_TPL="$ENV_DIR/runtime.env.tpl"

# Progress/diagnostics go to STDERR so stdout stays clean for captured output
# (e.g. `infra output -raw`, `aws ...` in command substitutions).
log()  { printf '\033[1;36m[deploy]\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31m[deploy:error]\033[0m %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

# Whatever a command leaves in the tmpfs goes when it ends, and so does the
# master password a db command lent the backup task (db_master_param_put).
DB_MASTER_PARAM=""
cleanup() {
  rm -f "$SECRETS_DIR"/item.*.json "$SECRETS_DIR"/value.* "$SECRETS_DIR"/*.rendered \
    "$SECRETS_DIR"/tfplan "$SECRETS_DIR"/aws.env 2>/dev/null || true
  if [ -n "$DB_MASTER_PARAM" ]; then
    aws ssm delete-parameter --name "$DB_MASTER_PARAM" >/dev/null 2>&1 \
      || err "deleting $DB_MASTER_PARAM failed: delete it by hand (./deploy/run.sh$DEP_FLAG aws ssm delete-parameter --name $DB_MASTER_PARAM)"
  fi
}
trap cleanup EXIT

# ---------------------------------------------------------------------------
# The deployment
# ---------------------------------------------------------------------------

# The deployments, prod and staging. Each lives in an AWS account of its own,
# which its vault item names (aws-<deployment>: account_id, account_name,
# region, root_email by hand; state_bucket, the deploy user's access key and
# github_deploy_role_arn from `org apply`; prod's gate_eip_allocation_id from
# the gate address's transfer): no tracked file names an account or holds a
# key.
DEP=""
DEP_FLAG=""

# Everything a deployment's name decides by itself.
set_deployment() {
  DEP="$1"
  case "$DEP" in
    prod|staging) ;;
    *) die "--deployment takes prod or staging, not '$DEP'" ;;
  esac
  AWS_ITEM="aws-$DEP"
  SSM_PREFIX="/opennova/$DEP"
  TFVARS="$TF_DIR/$DEP.tfvars"
  APP_ITEM="app-$DEP"
  RDS_ITEM="rds-$DEP"
  HOSTED_ITEM="hosted-$DEP"
  # Stripe's live mode is prod's alone; its test mode serves staging (and the
  # local stack and CI, whose databases ignore staging's customers: each
  # stamps its own instance id on the customers it makes).
  if [ "$DEP" = prod ]; then
    STRIPE_ITEM="stripe-live"
    STRIPE_MODE="live"
  else
    STRIPE_ITEM="stripe-test"
    STRIPE_MODE="test"
  fi
  DEP_FLAG=" --deployment $DEP"
  ACCOUNT_ID="" REGION="" STATE_BUCKET="" GATE_EIP_ALLOCATION_ID=""
}

# The deployment's account, from its vault item (aws-<deployment>), read once:
# its id and region (filled in by hand when the account is made), its state
# bucket (the org stack's, written back by `org apply`, as are the deploy
# user's keys there), prod's gate_eip_allocation_id (the gate's address once
# it is the prod account's). On a CI runner, which holds no vault, the deploy
# workflow's environment names the account and region (AWS_ACCOUNT_ID,
# AWS_REGION: infra/github's environment variables).
deployment_identity() {
  [ -z "$ACCOUNT_ID" ] || return 0
  if [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ]; then
    require_op
    vault_has_item "$AWS_ITEM" \
      || die "vault item '$AWS_ITEM' is absent: ./deploy/run.sh$DEP_FLAG secrets init makes it, then fill in its account_id (DEPLOY.md, \"The Organization and the accounts\")"
    local json
    json="$(item_json "$AWS_ITEM")"
    ACCOUNT_ID="$(json_field "$json" account_id)"
    REGION="$(json_field "$json" region)"
    STATE_BUCKET="$(json_field "$json" state_bucket)"
    GATE_EIP_ALLOCATION_ID="$(json_field "$json" gate_eip_allocation_id)"
    rm -f "$json"
  else
    ACCOUNT_ID="${AWS_ACCOUNT_ID:-}"
    REGION="${AWS_REGION:-}"
  fi
  [[ "$ACCOUNT_ID" =~ ^[0-9]{12}$ ]] \
    || die "$AWS_ITEM/account_id names no AWS account ('$ACCOUNT_ID'): the $DEP account's id, once the account is made (DEPLOY.md, \"The Organization and the accounts\")"
  [[ "$REGION" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]$ ]] || die "$AWS_ITEM/region names no AWS region ('$REGION')"
}

# A vault field's value (the item JSON at $1, label $2), empty when it has none
# or holds the placeholder.
json_field() {
  local v
  v="$(jq -r --arg l "$2" '[.fields[]? | select(.label == $l) | (.value // "")][0] // ""' "$1")"
  [ "$v" != REPLACE_ME ] || v=""
  printf '%s' "$v"
}

# The line every command starts with: what it acts on. Prod's in red.
DEP_DEFAULTED=0
banner() {
  local what="$1" color='1;33'
  [ "$DEP" != prod ] || color='1;31'
  printf '\033[%sm[deploy] %s\033[0m%s: %s\n' "$color" "$DEP" \
    "$([ "$DEP_DEFAULTED" -eq 0 ] || echo ' (the default for a read-only command: --deployment staging reads staging)')" \
    "$what" >&2
}

# A change to prod goes ahead only on purpose: with --yes ($2 = 1), or once the
# operator types prod at the prompt. With no terminal to ask on and no --yes
# it refuses. Staging goes ahead unasked (its banner says it is staging).
stdin_is_terminal() { [ -t 0 ]; }
confirm_word() {
  local word="$1" what="$2" yes="$3" answer=""
  if [ "$yes" -eq 1 ]; then
    log "$word: $what (--yes)"
    return 0
  fi
  stdin_is_terminal || die "$word: refusing to $what without --yes (no terminal to ask on); nothing was changed"
  printf '\033[1;31m[deploy]\033[0m %s: %s? Type %s to go on: ' "$word" "$what" "$word" >&2
  IFS= read -r answer || answer=""
  [ "$answer" = "$word" ] || die "$word: not confirmed; nothing was changed"
}
confirm_prod() {
  [ "$DEP" = prod ] || return 0
  confirm_word prod "$1${ACCOUNT_ID:+ (account $ACCOUNT_ID)}" "$2"
}

# A command's arguments with --yes taken out: OPT_YES (1 when it was given)
# and OPT_REST (the others, in order).
take_yes() {
  local a
  OPT_YES=0
  OPT_REST=()
  for a in "$@"; do
    if [ "$a" = --yes ]; then OPT_YES=1; else OPT_REST+=("$a"); fi
  done
}

# A deploy/env template with the toolbox's placeholders filled in, in the tmpfs.
render_tpl() {
  local out
  out="$SECRETS_DIR/$(basename "$1").rendered"
  sed -e "s|@VAULT@|$VAULT|g" -e "s|@APP_ITEM@|${APP_ITEM:-}|g" -e "s|@AWS_ITEM@|${AWS_ITEM:-}|g" \
      -e "s|@STRIPE_ITEM@|${STRIPE_ITEM:-}|g" -e "s|@RDS_ITEM@|${RDS_ITEM:-}|g" "$1" > "$out"
  chmod 600 "$out"
  printf '%s' "$out"
}

require_op() {
  [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] || die "OP_SERVICE_ACCOUNT_TOKEN is not set"
  op whoami >/dev/null 2>&1 || die "1Password auth failed (check OP_SERVICE_ACCOUNT_TOKEN)"
}

# Whether vault $VAULT holds an item titled $1. Asked by title in the vault's
# listing, never read off an error's wording; a listing that fails, comes back
# empty (the deploy vault is never empty: its own items are in it) or is not a
# JSON array stops the command, so no vault hiccup reads as an absent item.
vault_has_item() {
  local title="$1" list rc=0
  list="$(op item list --vault "$VAULT" --format json)" \
    || die "listing vault '$VAULT' failed. Refusing to go on with its items unknown (run again once the vault answers)"
  [ -n "$list" ] \
    || die "listing vault '$VAULT' came back empty. Refusing to go on with its items unknown (run again once the vault answers)"
  printf '%s' "$list" \
    | jq -e --arg t "$title" 'if type == "array" then any(.[]; .title == $t) else error("no array") end' \
      >/dev/null 2>&1 || rc=$?
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "vault '$VAULT' listing unreadable (jq exit $rc)" ;;
  esac
}

# An item's JSON (its fields' values among it) into the tmpfs; echoes the path.
item_json() {
  local out="$SECRETS_DIR/item.$1.json"
  op item get "$1" --vault "$VAULT" --format json > "$out" \
    || die "reading vault item '$1' failed (run again once the vault answers)"
  chmod 600 "$out"
  printf '%s' "$out"
}

# Whether the item JSON at $1 has a field labelled $2.
json_has_field() {
  jq -e --arg l "$2" 'any(.fields[]?; .label == $l)' "$1" >/dev/null
}

# ---------------------------------------------------------------------------
# AWS: the deployment's account
# ---------------------------------------------------------------------------

AWS_READY=0

# The AWS credentials every AWS call of this command uses (the toolbox's own
# and Terraform's, which inherits them): the deployment's account and nothing
# else. A CI runner's own credentials (the deploy workflow's OIDC role, which
# lives in the deployment's account) when no vault token is given; else the
# deployment's own deploy user's keys (its vault item aws-<deployment>, which
# the org stack wrote: the user opennova-deploy of that account alone; another
# deployment's are read only by as_deployment, for the two one-way reads its
# callers name). Either way the caller's account must be the deployment's, or
# the command stops before any other call.
aws_auth() {
  [ "$AWS_READY" -eq 0 ] || return 0
  deployment_identity
  if [ -z "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] \
     && [ -n "${AWS_ACCESS_KEY_ID:-}${AWS_WEB_IDENTITY_TOKEN_FILE:-}${AWS_PROFILE:-}" ]; then
    : # the runner's own credentials (checked below)
  else
    vault_credentials "$AWS_ITEM" \
      || die "$AWS_ITEM holds no access key: the org stack writes the $DEP deploy user's there (./deploy/run.sh org apply)"
  fi
  export AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION"
  aws_account_check "$DEP's" "$AWS_ITEM"
}

# The access key of vault item $1 (access_key_id, secret_access_key) into this
# process's environment, in place of any other credentials. Fails when the
# item holds none.
vault_credentials() {
  require_op
  local tpl out="$SECRETS_DIR/aws.env" line key
  tpl="$(AWS_ITEM="$1" render_tpl "$AWS_ENV_TPL")"
  if ! op inject -f -i "$tpl" -o "$out" >/dev/null 2>&1; then
    rm -f "$out" "$tpl"
    return 1
  fi
  chmod 600 "$out"
  unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in ''|'#'*) continue ;; esac
    key="${line%%=*}"
    case "$key" in AWS_ACCESS_KEY_ID|AWS_SECRET_ACCESS_KEY) export "$key=${line#*=}" ;; esac
  done < "$out"
  rm -f "$out" "$tpl"
  [[ "${AWS_ACCESS_KEY_ID:-}" =~ ^A[KS]IA[A-Z0-9]{12,}$ ]]
}

# The credentials in the environment must act in $ACCOUNT_ID ($1 names whose,
# $2 the vault item that names it): one look at sts, then the command goes on.
aws_account_check() {
  local who account
  who="$(aws sts get-caller-identity --output json)" || die "the AWS credentials do not answer (sts get-caller-identity)"
  account="$(jq -r '.Account // ""' <<<"$who")"
  [ "$account" = "$ACCOUNT_ID" ] \
    || die "the AWS credentials act in account $account, not $1 ($ACCOUNT_ID, vault item $2). Refusing: nothing was read or changed"
  AWS_READY=1
  log "${1%\'s}: account $ACCOUNT_ID as $(jq -r '.Arn' <<<"$who")"
}

# The Organization's own identity, for `org` alone: the management account's
# opennova-org user (vault item aws-org: its keys, the account's id, the
# region), which may read the Organization, make its accounts and assume
# each member account's OrganizationAccountAccessRole, and nothing else.
org_auth() {
  [ "$AWS_READY" -eq 0 ] || return 0
  require_op
  local json
  vault_has_item aws-org \
    || die "vault item 'aws-org' is absent: secrets init makes it; its keys are the opennova-org user's (DEPLOY.md, \"The Organization and the accounts\")"
  json="$(item_json aws-org)"
  ACCOUNT_ID="$(json_field "$json" account_id)"
  REGION="$(json_field "$json" region)"
  rm -f "$json"
  [[ "$ACCOUNT_ID" =~ ^[0-9]{12}$ ]] \
    || die "vault item aws-org names no management account (account_id; DEPLOY.md, \"The Organization and the accounts\")"
  [[ "$REGION" =~ ^[a-z]{2}(-[a-z]+)+-[0-9]$ ]] || die "vault item aws-org names no region ('$REGION')"
  vault_credentials aws-org || die "aws-org holds no access key (the opennova-org user's, made by hand: DEPLOY.md)"
  export AWS_REGION="$REGION" AWS_DEFAULT_REGION="$REGION"
  aws_account_check "the management account's" aws-org
}

# Run "$@" (a function) as deployment $1, in a subshell of its own: its
# account's credentials, its infra.env, its names. The command's own
# deployment is untouched. Needs the vault (a CI runner's credentials are one
# deployment's alone).
as_deployment() {
  local other="$1"
  shift
  (
    [ -n "${OP_SERVICE_ACCOUNT_TOKEN:-}" ] \
      || die "reading $other needs the vault's credentials (a runner's are its own deployment's alone)"
    set_deployment "$other"
    AWS_READY=0
    INFRA=()
    aws_auth
    "$@"
  )
}

cmd_aws() {
  aws_auth
  aws "$@"
}

# The deployment's infra.env (SSM, written by Terraform), read once.
declare -A INFRA=()
infra_env_load() {
  [ "${#INFRA[@]}" -eq 0 ] || return 0
  aws_auth
  local text line re="^([A-Z][A-Z0-9_]*)='([^']*)'\$"
  text="$(aws ssm get-parameter --name "$SSM_PREFIX/infra.env" --query Parameter.Value --output text 2>/dev/null)" \
    || die "cannot read $SSM_PREFIX/infra.env: run ./deploy/run.sh$DEP_FLAG infra apply first"
  while IFS= read -r line; do
    [[ "$line" =~ $re ]] || continue
    INFRA["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
  done <<<"$text"
  [ "${#INFRA[@]}" -gt 0 ] || die "$SSM_PREFIX/infra.env holds nothing (infra apply)"
  [ "${INFRA[OPENNOVA_DEPLOYMENT]:-}" = "$DEP" ] \
    || die "$SSM_PREFIX/infra.env names the deployment '${INFRA[OPENNOVA_DEPLOYMENT]:-}', not $DEP. Refusing"
}

infra_get() {
  local v="${INFRA[$1]:-}"
  [ -n "$v" ] || die "$SSM_PREFIX/infra.env names no $1 (run infra apply)"
  printf '%s' "$v"
}

# ---------------------------------------------------------------------------
# The commands, by responsibility (deploy/bin/lib): each file defines its
# functions and their constants alone, sourced here at the top level, before
# main runs anything (a check that sources this file gets them all too)
# ---------------------------------------------------------------------------

ON_DEPLOY_LIB="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib"
# shellcheck source=deploy/bin/lib/secrets.sh
source "$ON_DEPLOY_LIB/secrets.sh"
# shellcheck source=deploy/bin/lib/stripe.sh
source "$ON_DEPLOY_LIB/stripe.sh"
# shellcheck source=deploy/bin/lib/infra.sh
source "$ON_DEPLOY_LIB/infra.sh"
# shellcheck source=deploy/bin/lib/app.sh
source "$ON_DEPLOY_LIB/app.sh"
# shellcheck source=deploy/bin/lib/db.sh
source "$ON_DEPLOY_LIB/db.sh"
# shellcheck source=deploy/bin/lib/fleet.sh
source "$ON_DEPLOY_LIB/fleet.sh"

# ---------------------------------------------------------------------------

# The header comment above `set -euo pipefail` is the help text.
usage() {
  sed -n '2,/^[^#]/p' "${BASH_SOURCE[0]}" | sed -e '$d' -e 's/^# \{0,1\}//'
}

# What a command does to a deployment: `change` (it must name one), `read`
# (prod unless it names another) or `none` (the zone's, the organization's,
# help: it names none). Its first two words decide.
command_kind() {
  local group="$1" action="$2"
  case "$group" in
    help|-h|--help|github|zone|org) echo none ;;
    secrets) case "${action:-check}" in check) echo read ;; *) echo change ;; esac ;;
    stripe) case "$action" in check) echo read ;; *) echo change ;; esac ;;
    infra) case "${action:-plan}" in output|list) echo read ;; *) echo change ;; esac ;;
    app) case "${action:-status}" in status|releases|logs|images) echo read ;; *) echo change ;; esac ;;
    fleet) case "${action:-status}" in status) echo read ;; *) echo change ;; esac ;;
    backup) case "$action" in list) echo read ;; *) echo change ;; esac ;;
    aws|db|hosted) echo change ;;
    *) echo unknown ;;
  esac
}

main() {
  local dep=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --deployment) [ $# -ge 2 ] || die "--deployment needs prod or staging"; dep="$2"; shift 2 ;;
      --deployment=*) dep="${1#*=}"; shift ;;
      *) break ;;
    esac
  done
  local group="${1:-help}"
  shift || true
  local kind
  kind="$(command_kind "$group" "${1:-}")"
  case "$kind" in
    unknown) err "unknown command: $group"; usage; exit 1 ;;
    none)
      [ -z "$dep" ] || die "$group is no deployment's (it is the whole zone's or organization's): run it without --deployment" ;;
    change)
      [ -n "$dep" ] || die "'$group${1:+ $1}' changes a deployment, so it names one: ./deploy/run.sh --deployment staging $group ${*} (or --deployment prod). There is no default" ;;
    read)
      if [ -z "$dep" ]; then dep=prod; DEP_DEFAULTED=1; fi ;;
  esac
  mkdir -p "$SECRETS_DIR"
  if [ -n "$dep" ]; then
    set_deployment "$dep"
    banner "$group${1:+ $1}"
  fi
  case "$group" in
    secrets)   cmd_secrets "$@" ;;
    stripe)    cmd_stripe "$@" ;;
    infra)     cmd_infra "$@" ;;
    org)       cmd_org "$@" ;;
    zone)      cmd_zone "$@" ;;
    github)    cmd_github "$@" ;;
    aws)       cmd_aws "$@" ;;
    app)       cmd_app "$@" ;;
    db)        cmd_db "$@" ;;
    backup)    cmd_backup "$@" ;;
    fleet)     cmd_fleet "$@" ;;
    hosted)    cmd_hosted "$@" ;;
    help|-h|--help) usage ;;
    *) err "unknown command: $group"; usage; exit 1 ;;
  esac
}

# Run when executed. Sourced, it only defines the functions, so a local check
# can drive one against stubs (op, aws, terraform, docker).
if [ "${BASH_SOURCE[0]}" = "$0" ]; then
  main "$@"
fi
