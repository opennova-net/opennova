[Unit]
Description=OpenNova: converge the service instance to its deployment's release
After=network-online.target docker.service opennova-fence.service
Wants=network-online.target
Requires=docker.service opennova-fence.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/opennova-converge-boot
TimeoutStartSec=1500
# A boot that cannot converge (SSM or S3 not answering yet) tries again.
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target
