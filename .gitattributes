# Enforce LF line endings for all text files
* text=auto eol=lf

# Git LFS tracking for binary fixtures and assets
fixtures/** filter=lfs diff=lfs merge=lfs -text -eol
assets/** filter=lfs diff=lfs merge=lfs -text -eol
screenshots/** filter=lfs diff=lfs merge=lfs -text -eol

# Windows-style text configs that need CRLF preserved.
*.env text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.ENV text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Binary game assets — must come AFTER any *.ext text rules above so the
# subtree exception wins (gitattributes uses last-match precedence).
godot/game/assets/** -text -eol
godot/modtools/assets/** -text -eol
apps/novaworld_server/static/** -text -eol

# Deploy env files are read inside Linux containers — keep them LF, not the
# CRLF the *.env rule above would impose. Last-match precedence wins.
deploy/env/*.env text eol=lf

# Tracked Markdown docs + .gitignore under fixtures/ are plain text, not LFS
# binaries — last-match precedence pulls them back out of the fixtures/** LFS
# rule above (git must read .gitignore as text).
fixtures/**/*.md text eol=lf filter= diff= merge=
fixtures/**/.gitignore text eol=lf filter= diff= merge=

# Plain-text fixtures are plain git blobs so they diff and review normally;
# only binary fixtures ride LFS (scripts/lint/fixture_lint.py judges by
# content). They keep `-text -eol`, never eol=lf: the retail parsers are not
# LF-tolerant (see the assets/ block below) and the minted files are
# byte-guarded by their generators, so git must not normalise them in either
# direction. Last-match precedence: these must follow fixtures/** and *.env.
fixtures/**/*.adm -text -eol filter= diff= merge=
fixtures/**/*.def -text -eol filter= diff= merge=
fixtures/**/*.env -text -eol filter= diff= merge=
fixtures/**/*.hexcap -text -eol filter= diff= merge=
fixtures/**/*.ini -text -eol filter= diff= merge=
fixtures/**/*.mns -text -eol filter= diff= merge=
fixtures/**/*.mnu -text -eol filter= diff= merge=
fixtures/**/*.nwmsg -text -eol filter= diff= merge=
fixtures/**/*.ptl -text -eol filter= diff= merge=
fixtures/**/*.ptu -text -eol filter= diff= merge=
fixtures/**/*.trn -text -eol filter= diff= merge=
fixtures/**/*.txt -text -eol filter= diff= merge=
fixtures/**/*.wac -text -eol filter= diff= merge=

# The render-evidence manifests and READMEs under screenshots/ are plain text
# the docs link into — same exception as fixtures/ above, or GitHub renders
# three-line LFS pointer stubs where the evidence should be. NO eol
# conversion: the evidence records hash each other byte-exactly, and two
# CRLF-written manifests must keep their bytes (-text, not eol=lf).
screenshots/**/*.md -text filter= diff= merge=
screenshots/**/*.json -text filter= diff= merge=

# assets/ is the game's own authored asset tree. Binary assets stay in LFS via
# the assets/** rule above; the TEXT ones are plain files in git so they diff
# and review normally. They keep `-text -eol` rather than eol=lf because retail's
# parsers are NOT LF-tolerant and fail silently: a LF-only menu_style.mns
# dead-ends the menu shell before main.mnu (witnessed 2026-08-23), and a bare LF
# stops the .def parser after block 0. Their CRLF must survive a round trip on
# every platform, so git must not normalise them in either direction.
# Last-match precedence: this block has to stay at the END of the file to win
# over both assets/** and the *.env rule above.
assets/**/*.def -text -eol filter= diff= merge=
assets/**/*.mnu -text -eol filter= diff= merge=
assets/**/*.mns -text -eol filter= diff= merge=
assets/**/*.trn -text -eol filter= diff= merge=
assets/**/*.env -text -eol filter= diff= merge=
assets/**/*.wac -text -eol filter= diff= merge=
assets/**/*.txt -text -eol filter= diff= merge=
assets/**/*.md  text eol=lf filter= diff= merge=
# The allowlist protecting the game dir is ours, not a game file: it must be a
# real text blob on every checkout, LFS smudge or not (a pointer file ignores nothing).
assets/**/.gitignore text eol=lf filter= diff= merge=
# The authored .fx artifacts are SCR-wrapped binaries (minimal_fx_gen wraps the
# plaintext sources under tests/fixtures/fx/); plain blobs, never normalised —
# a CRLF fold would corrupt the container.
assets/**/*.fx -text -eol filter= diff= merge=
