# Tracked Markdown docs under fixtures/ are plain text, not LFS binaries —
# last-match precedence pulls them back out of the fixtures/** LFS rule above.
fixtures/**/*.md text eol=lf filter= diff= merge=

# Plain-text fixtures are plain git blobs so they diff and review normally;
# only binary fixtures ride LFS (scripts/lint/fixture_lint.py judges by
# content). They keep `-text -eol`, never eol=lf: the retail parsers are not
# LF-tolerant and the minted files are
# byte-guarded by their generators, so git must not normalise them in either
# direction. Last-match precedence: these must follow fixtures/**.
fixtures/**/*.adm -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.aip -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.cfg -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.def -text -eol filter= diff= merge=
fixtures/**/*.env -text -eol filter= diff= merge=
fixtures/**/*.grm -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.hexcap -text -eol filter= diff= merge=
fixtures/**/*.http -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.ini -text -eol filter= diff= merge=
fixtures/**/*.mns -text -eol filter= diff= merge= whitespace=cr-at-eol
fixtures/**/*.mnu -text -eol filter= diff= merge=
fixtures/**/*.nwmsg -text -eol filter= diff= merge=
fixtures/**/*.o3d -text -eol filter= diff= merge=
fixtures/**/*.ptl -text -eol filter= diff= merge=
fixtures/**/*.ptu -text -eol filter= diff= merge=
fixtures/**/*.trn -text -eol filter= diff= merge=
fixtures/**/*.txt -text -eol filter= diff= merge=
fixtures/**/*.wac -text -eol filter= diff= merge= whitespace=cr-at-eol

# The site's screenshots and video are plain blobs, stored byte-for-byte.
web/public/media/** -text -eol
