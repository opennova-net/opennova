# Enforce LF line endings for all text files
* text=auto eol=lf

# Git LFS tracking for binary fixtures and assets
fixtures/** filter=lfs diff=lfs merge=lfs -text -eol
assets/** filter=lfs diff=lfs merge=lfs -text -eol
godot/assets/** filter=lfs diff=lfs merge=lfs -text -eol
game/assets/** filter=lfs diff=lfs merge=lfs -text -eol
screenshots/** filter=lfs diff=lfs merge=lfs -text -eol

# Windows-style text configs that need CRLF preserved.
*.env text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
*.ENV text eol=crlf whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Binary game assets — must come AFTER any *.ext text rules above so the
# subtree exception wins (gitattributes uses last-match precedence).
godot/game/assets/** -text -eol
godot/modtools/assets/** -text -eol
apps/novaworld_server/static/** -text -eol

# Deploy env files are read inside Linux containers — keep them LF, not the
# CRLF the *.env rule above would impose. Last-match precedence wins.
deploy/env/*.env text eol=lf

# Tracked Markdown docs + .gitignore under fixtures/ are plain text, not LFS
# binaries — last-match precedence pulls them back out of the fixtures/** LFS
# rule above (git must read .gitignore as text).
fixtures/**/*.md text eol=lf filter= diff= merge=
fixtures/**/.gitignore text eol=lf filter= diff= merge=

# The render-evidence manifests and READMEs under screenshots/ are plain text
# the docs link into — same exception as fixtures/ above, or GitHub renders
# three-line LFS pointer stubs where the evidence should be. NO eol
# conversion: the evidence records hash each other byte-exactly, and two
# CRLF-written manifests must keep their bytes (-text, not eol=lf).
screenshots/**/*.md -text filter= diff= merge=
screenshots/**/*.json -text filter= diff= merge= whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
