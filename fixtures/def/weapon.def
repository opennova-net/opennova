weapon "WPN_KNIFE"
	category 1
	rank     0
	statid 100

	teamfilter	blue
	

	charfilter	medic
	charfilter	sniper
	charfilter	gunner
	charfilter	rifleman
	charfilter	engineer

	round_type  "AMMO_KNIFE01"
	clipsize    -1
	startrounds -1
	error 0 0 0 0 0 0
	targetpitchmax  85				
	targetpitchmin  85				
	targetyawrange  120				
	launchuserpoint bullet

	attack_anim	 1		
	special_hold 1		
	run_anim	 1		

	flags Underwater
	flags WhileSwimming

	crosshair coma20mm.tga
	hudicon H_knife.tga

	animadm m9k_1st

	gfx1 M9k_1st
	gfx1a armsG
	gfx1b armsGb
  	gfx3 M9K_3rd 
	pos  4 -5 -186 0 0 0

	action "idle"
		delayend		  auto
		anim		  anim_wpn_idle
		function      wpn_std_idle
	end	

	action "emptyidle"
		function			wpn_std_emptyidle
	end	

	action "fire"
		delaystart		0		
		delayend		0
		soundsetend		GS_KNIFE
		anim			anim_wpn_idle
		function		wpn_std_fire
	end

	action "recoil"
		delaystart	auto
		anim		  anim_wpn_fire
		function      wpn_std_recoil
	end

	action "reload"
		delayend		  auto
		anim		  anim_wpn_reload
		function      wpn_std_reload
	end

	action "empty"
		delaystart			0
		delayend			auto
		anim		  anim_wpn_empty
		function      wpn_std_empty
	end

	action "switchto"
		soundset	GF_KNIFE_ST
		delaystart		1
		delayend		1
		anim		  anim_wpn_switchto
		function      wpn_std_switchto
	end

	action "switchfrom"
		soundset		GF_KNIFE_SF
		delaystart		1
		delayend		1
		anim		  anim_wpn_switchfrom
		function      wpn_std_switchfrom
	end

	action "switchrank"
		delaystart		1
		delayend		1
		anim		  anim_wpn_switchrank
		function      wpn_std_switchrank
	end
end


