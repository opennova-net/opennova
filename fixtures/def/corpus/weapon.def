




ammoclass_max_carry CLASS_CORPUS_A			1000
ammoclass_max_carry CLASS_CORPUS_B		250

// Authored for the def writers' corpus legs (fixtures/README.md): weapon blocks that together use
// every key JO:CA's weapon.def and its jox01 expansion's use, each in the forms the two files write
// its values in (pos/tpos with and without commas, reals spelled 1.5 / 2.500 / .35 / -.574,
// `delayend 3 \\auto`, a SIGHTS row with its scale or slide flag), the stray `v` lines between two
// blocks the game reads nothing of, and the top-of-file ammoclass_max_carry rows. No value here is
// shipped data.

weapon "WPN_CORPUSKNIFE"
	category 1
	rank     0
	statid 120

	teamfilter	blue
	charfilter	medic
	charfilter	sniper
	charfilter	gunner
	charfilter	rifleman
	charfilter	engineer

	round_type  "AMMO_CORPUSBLADE"
	clipsize    -1
	startrounds -1
	error 0 0 0 0 0 0
	targetpitchmax  85
	targetpitchmin  85
	targetyawrange  120
	launchuserpoint bullet

	attack_anim	 1
	special_hold 1
	run_anim	 1

	flags Underwater
	flags WhileSwimming

	crosshair corpus01.tga
	hudicon H_cknife.tga

	animadm cknf_1st

	gfx1 Cknf_1st
	gfx1a armsC
	gfx1b armsCb
  	gfx3 CKNF_3rd
	pos  5 -6 -180 0 0 0

	action "idle"
		delayend		  auto
		anim		  anim_wpn_idle
		function      wpn_std_idle
	end

	action "fire"
		delaystart		0
		delayend		0
		soundsetend		GS_CKNIFE
		anim			anim_wpn_idle
		function		wpn_std_fire
	end

	action "recoil"
		delaystart	auto
		anim		  anim_wpn_fire
		function      wpn_std_recoil
	end
end


weapon "WPN_CORPUSRIFLE"
	category 3
	rank     1
	statid 320

	teamfilter	red
	teamfilter	blue

	charfilter	rifleman
	charfilter	medic

	loadout_selectable	1
	loadout_subclasses	1

	maxclips		8
	clipweight		1.25
	weaponweight	6.5

	loadout_menu_icon	M_crifle.tga
	loadout_menu_textid	WEAP_SHORT_CORPUS
	loadout_menu_ttdesc WEAP_DESC_CORPUS
	weapon_class	primary

	round_type		"AMMO_CORPUS_556"
	clipsize		30
	startrounds		240
	error 0.0125 0.15 0.2 0.0125 0.025 0.04
	targetpitchmax  22
	targetpitchmin  50
	targetyawrange  120
	ammoclass		CLASS_CORPUS_A 1
	ammobucket		1
	launchuserpoint bullet

	flags auto
	flags Sighted
	scope_max_mag	2
	scope_min_mag	1
	flags WhileSwimming
	flags LaserBeam

	sights  crpsaim.tga   112  0 889 768 blend
	sights  crpsgls.tga   112  0 896 774 multiplyat
	sights  crpsdot.tga    496  368 527 399 add		scale

	crosshair corpus02.tga
	hudicon H_crifle.tga
	hudclipgfx 	 0  0		H_cclip.tga
	hudrndgfx	 6  0 4 0 1	H_cround.tga

	animadm crfl_1st

	gfx1 Crfl_1st
	gfx1a armsC
	gfx1b armsCb
	gfx3 CRFL_3RD
  	pos  -20.55, 21.25, -160.00 2.500, 0.750, 356.750
	tpos -50.25, 38.50, -150.75, 1.250, 2.250, 0.250

	action "fire"
		delayend			3	\\auto
		soundsetend			GS_CRIFLE
		anim				anim_wpn_fire
		function			wpn_std_fire
		particle			Effect_CorpusMF
		particleuserpoint	mflash01
	end

	action "reload"
		delaystart			100
		delayend			auto
		soundset			GF_CRIFLE_RL
		anim				anim_wpn_reload
		function			wpn_std_reload
	end
end

