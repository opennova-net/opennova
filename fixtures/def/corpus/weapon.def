weapon "WPN_CORPUSMINIGUN"
	category 11
	rank     0
	statid 930

	round_type  "AMMO_CORPUS_762"
	clipsize    -1
	startrounds 3000
	error 0.07 0.07 0.07 0.07 0.07 0.07 0.07
	targetpitchmax  15
	targetpitchmin  45
	targetyawrange  180

	vmacrotoken gunn
	emplacedstance	5
	launchuserpoint camera

	heat_values 3,5
	heat_effect heat, .25, 20, 50

	soundfireloop LP_GS_CMINIGUN
	soundhead GS_CMINIHEAD
	soundtrailoff GS_CMINITAIL
	soundlockedtone TONE_CLOCK

	commandersX UiCGunner.tga
	attachtextid attach_corpusmini
	crosshair 50cal.tga
	hudicon h_cmini.tga

	farpinfo	3  2

	flags auto
	flags Emplaced
	flags ForceScoped
	flags ShowComander

	scope_max_zero   1  90 90 1
	scope_max_mag	8	2
	scope_paralax_distance		-.574
	Tpos  -18 0 -150 0 0 0
	pos  -60 0 -150 0 0 0

	action "fire"
		anim				anim_wpn_fire
		soundsetend			GS_CMINI
		delayend			auto
		function			wpn_std_fire
		particle			Effect_CorpusMiniMuz
		particleuserpoint	mflash01
		action_value		10
	end

	action "overheated"
		anim				anim_wpn_idle
		delaystart		1
		delayend		1
		function			wpn_std_emptyidle
		particleuserpoint	heat
		particle			fx_coverheat1
	end
end

