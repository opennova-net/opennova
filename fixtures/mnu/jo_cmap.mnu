				<APPEARANCE type="image" state="mouseover" map_state="1" height="26">btn15.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="26">btn15.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled" map_state="3" height="26">btn15.tga</APPEARANCE>
				<POSITION>
					<LEFT>400</LEFT>
					<RIGHT>556</RIGHT>
					<TOP>444</TOP>
					<BOTTOM>470</BOTTOM>
				</POSITION>
				<STRING type="id" justify="CENTER" vjustify="CENTER">STR_SHOWWAYPOINTS</STRING>
			</WINDOW>
			<WINDOW type="button" name="CLEAR_WAYPOINTS">
				<APPEARANCE type="image" state="default" map_state="0" height="20">clear_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="20">clear_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="20">clear_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled" map_state="3" height="20">clear_wp.tga</APPEARANCE>
				<POSITION>
					<LEFT>735</LEFT>
					<RIGHT>755</RIGHT>
					<TOP>5</TOP>
					<BOTTOM>25</BOTTOM>
				</POSITION>
			</WINDOW>
			<WINDOW type="checkbox" name="CREATE_WAYPOINTS">
				<APPEARANCE type="image" state="default" map_state="0" height="20">create_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="20">create_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="20">create_wp.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled" map_state="3" height="20">create_wp.tga</APPEARANCE>
				<POSITION>
					<LEFT>735</LEFT>
					<RIGHT>755</RIGHT>
					<TOP>30</TOP>
					<BOTTOM>50</BOTTOM>
				</POSITION>
			</WINDOW>
		</WINDOW>

		<WINDOW type="window" name="WAYPOINTNAME_DLG" HIDDEN MODAL DRAW_FRAME>
			<APPEARANCE type="color" state="default">%COLOR_BLACK%</APPEARANCE>
			<POSITION>
				<LEFT>0</LEFT>
				<RIGHT>200</RIGHT>
				<TOP>0</TOP>
				<BOTTOM>50</BOTTOM>
			</POSITION>
			<WINDOW type="edit" name="WPNAME">
				<APPEARANCE type="outline" state="default">%ITEM_SELECTED_BG%</APPEARANCE>
				<APPEARANCE type="outline" state="mouseover">%ITEM_SELECTED_BG%</APPEARANCE>
				<APPEARANCE type="outline" state="selected">%ITEM_SELECTED_BG%</APPEARANCE>
				<POSITION>
					<LEFT>2</LEFT>
					<TOP>2</TOP>
					<RIGHT>198</RIGHT>
					<BOTTOM>27</BOTTOM>
				</POSITION>
				<STRING justify="left" vjustify="top"></STRING>
			</WINDOW>
			<WINDOW type="button" name="WPNAME_CANCEL">
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<ACTION type="window" state="HIDE">WAYPOINTNAME_DLG</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<TOP>30</TOP>
				</POSITION>
				<STRING type="id" justify="left" vjustify="top">CANCEL</STRING>
			</WINDOW>
			<WINDOW type="button" name="WPNAME_OK">
				<HOTKEY VIRTUAL>VK_ENTER</HOTKEY>
				<ACTION type="window" state="HIDE">WAYPOINTNAME_DLG</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>195</LEFT>
					<TOP>30</TOP>
				</POSITION>
				<STRING type="id" justify="RIGHT" vjustify="top">ACCEPT</STRING>
			</WINDOW>
		</WINDOW>
		
		<WINDOW type="window" name="TAB_TEAM" HIDDEN>
			<POSITION>
				<LEFT>20</LEFT>
				<TOP>60</TOP>
			</POSITION>
			<WINDOW type="table" name="TEAMLIST">
				<POSITION>
					<TOP>0</TOP>
					<LEFT>0</LEFT>
					<RIGHT>700</RIGHT>
					<BOTTOM>400</BOTTOM>
				</POSITION>
				<COLUMN count="10" spacing="0">
					<HEADER justify="CENTER" vjustify="CENTER" column="0" sort="0" width="50" type="id">Recruit</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="1" sort="0" width="50" type="id">Join</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="2" sort="A" width="165" type="id">Name</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="3" sort="A" width="80" type="id">Class</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="4" sort="A" width="50" type="id">Map</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="5" sort="0" width="165" type="id">CO</HEADER>
					<HEADER justify="CENTER" vjustify="CENTER" column="6" sort="0" width="125" type="id">Fireteam</HEADER>
					
					<BODY justify="CENTER" vjustify="CENTER" column="0" CUSTOM_DRAW BITMAP_DRAW BITMAP_FLAGS="STANDARD_TRANSPARENT" SCALE_BITMAP></BODY>
					<BODY justify="CENTER" vjustify="CENTER" column="1" CUSTOM_DRAW BITMAP_DRAW BITMAP_FLAGS="STANDARD_TRANSPARENT" SCALE_BITMAP></BODY>
					<BODY justify="LEFT" vjustify="CENTER" column="2" CUSTOM_DRAW></BODY>
					<BODY justify="LEFT" vjustify="CENTER" column="3" CUSTOM_DRAW></BODY>
					<BODY justify="CENTER" vjustify="CENTER" column="4" CUSTOM_DRAW></BODY>
					<BODY justify="LEFT" vjustify="CENTER" column="5" CUSTOM_DRAW></BODY>
					<BODY justify="CENTER" vjustify="CENTER" column="6" CUSTOM_DRAW></BODY>
					
					<SUBST column="0" value="0" FILE>alphachk0.tga</SUBST>
					<SUBST column="0" value="1" FILE>alphachk1.tga</SUBST>
					<SUBST column="1" value="0" FILE>alphachk0.tga</SUBST>
					<SUBST column="1" value="1" FILE>alphachk1.tga</SUBST>
				</COLUMN>
				<ITEMS MULTISELECT>
					<APPEARANCE type="outline" state="default">%ITEM_SELECTED_BG%</APPEARANCE>
					<APPEARANCE type="color" state="selected">%ITEM_SELECTED_BG%</APPEARANCE>
				</ITEMS>
				<MIN_ITEM_HEIGHT>20</MIN_ITEM_HEIGHT>
				<SCROLLBAR>
					<APPEARANCE type="image" state="default">m_scrolV.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover">m_scrolV.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected">m_scrolV.tga</APPEARANCE>
					<SHUTTLE type="image" state="default">shuttlev.tga</SHUTTLE>
					<SHUTTLE type="image" state="mouseover">shuttlev.tga</SHUTTLE>
					<SHUTTLE type="image" state="selected">shuttlev.tga</SHUTTLE>
					<SCROLLUP type="image" state="default" map_state="0" height="24">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="mouseover" map_state="1" height="24">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="selected" map_state="2" height="24">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="disabled" map_state="3 height="24">up2arrw.tga</SCROLLUP>
					<SCROLLDOWN type="image" state="default" map_state="0" height="24">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="mouseover" map_state="1" height="24">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="selected" map_state="2" height="24">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="disabled" map_state="3" height="24">dn2arrw.tga</SCROLLDOWN>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
					<POSITION>
						<LEFT>710</LEFT>
						<TOP>0</TOP>
						<RIGHT>730</RIGHT>
						<BOTTOM>400</BOTTOM>
					</POSITION>
				</SCROLLBAR>
			</WINDOW>
			<WINDOW type="button" name="ADDTO_NO_FIRETEAM">
				<APPEARANCE type="image" state="default"   map_state="0" height="26">btn15.tga</APPEARANCE>
