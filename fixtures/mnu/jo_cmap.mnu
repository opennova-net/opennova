				<RIGHT>598</RIGHT>
				<TOP>20</TOP>
				<BOTTOM>52</BOTTOM>
			</POSITION>
			<STRING type="id" justify="CENTER" vjustify="CENTER">STR_CMAP_RULES</STRING>
		</WINDOW>

		<WINDOW type="window" name="TAB_MAP">
			<POSITION>
				<LEFT>20</LEFT>
				<TOP>60</TOP>
			</POSITION>
			<WINDOW type="button" name="MAP">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<APPEARANCE type="custom" state="mouseover"></APPEARANCE>
				<APPEARANCE type="custom" state="selected"></APPEARANCE>
				<APPEARANCE type="custom" state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<TOP>0</TOP>
					<RIGHT>730</RIGHT>
					<BOTTOM>440</BOTTOM>
				</POSITION>
			</WINDOW>
			<WINDOW type="button" name="ZOOMIN">
				<HOTKEY>=</HOTKEY>
				<APPEARANCE type="image" state="default"   map_state="0" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="26">btn14.tga</APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>36</RIGHT>
					<TOP>444</TOP>
					<BOTTOM>470</BOTTOM>
				</POSITION>
				<STRING justify="CENTER" vjustify="CENTER">+</STRING>
			</WINDOW>
			<WINDOW type="button" name="ZOOMOUT">
				<HOTKEY>-</HOTKEY>
				<APPEARANCE type="image" state="default"   map_state="0" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="26">btn14.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="26">btn14.tga</APPEARANCE>
				<POSITION>
					<LEFT>36</LEFT>
					<RIGHT>72</RIGHT>
					<TOP>444</TOP>
					<BOTTOM>470</BOTTOM>
				</POSITION>
				<STRING justify="CENTER" vjustify="CENTER">-</STRING>
			</WINDOW>
			<WINDOW type="checkbox" name="GRID" AS_BUTTON>
				<APPEARANCE type="image" state="default" map_state="0" height="26">btn15.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="26">btn15.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="26">btn15.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled" map_state="3" height="26">btn15.tga</APPEARANCE>
