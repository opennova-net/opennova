			<APPEARANCE type="image" state="mouseover" map_state="1" height="32">btn13.tga</APPEARANCE>
			<APPEARANCE type="image" state="selected" map_state="2" height="32">btn13.tga</APPEARANCE>
			<APPEARANCE type="image" state="disabled" map_state="3" height="32">btn13.tga</APPEARANCE>
			<POSITION>
				<LEFT>20</LEFT>
				<RIGHT>134</RIGHT>
				<TOP>20</TOP>
				<BOTTOM>52</BOTTOM>
			</POSITION>
			<STRING type="id" justify="CENTER" vjustify="CENTER">STR_CMAP_MAP</STRING>
