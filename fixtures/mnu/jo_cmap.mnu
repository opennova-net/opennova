<SCREEN>
	<NAME>CMAP</NAME>
	<MUSICVAR>2</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<FRAME>
			<STENCIL size="32">BORDER2.tga</STENCIL>
			<BRUSH>BOXTILE.tga</BRUSH>
			<MONOGRAM>MONOGRAM.tga</MONOGRAM>
		</FRAME>
		<APPEARANCE type="image" state="default">cmap_bkg.tga</APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>gametext.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>Arial20.fnt</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>

		<WINDOW type="radio" name="RADIO_TAB_MAP">
			<GROUP>1</GROUP>
			<ACTION type="window" state="SHOW">TAB_MAP</ACTION>
			<ACTION type="window" state="HIDE">TAB_TEAM</ACTION>
			<ACTION type="window" state="HIDE">TAB_RULES</ACTION>
			<ACTION type="window" state="HIDE">TAB_PLAYERS</ACTION>
			<ACTION type="window" state="HIDE">TAB_ORDERS</ACTION>
