		<WINDOW type="window" name="TAB_RULES" HIDDEN>
			<POSITION>
				<LEFT>20</LEFT>
				<TOP>60</TOP>
			</POSITION>
			<WINDOW type="multiline_edit" name="RULELIST" READONLY>
				<POSITION>
					<LEFT>0</LEFT>
					<TOP>0</TOP>
					<RIGHT>700</RIGHT>
					<BOTTOM>400</BOTTOM>
