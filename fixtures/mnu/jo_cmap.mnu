					<RIGHT>236</RIGHT>
					<TOP>444</TOP>
					<BOTTOM>470</BOTTOM>
				</POSITION>
				<STRING type="id" justify="CENTER" vjustify="CENTER">STR_SHOWGRID</STRING>
			</WINDOW>
			<WINDOW type="checkbox" name="TEXT" AS_BUTTON>
