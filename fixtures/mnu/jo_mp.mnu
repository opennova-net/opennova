					<LEFT>5</LEFT>
					<TOP>425</TOP>
				</POSITION>
				<STRING type="id" justify="LEFT">NAV_BACK</STRING>
			</WINDOW>
		</WINDOW>
	</WINDOW>
</SCREEN>

<SCREEN>
	<NAME>MULTI_PLAYER_HOST</NAME>
	<MUSICVAR>8</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<APPEARANCE type="image" state="default">letterbox.tga</APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>Gunpl20b.fnt</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>

		<WINDOW type="window" name="ALIGNMENT_WRAPPER">
			<POSITION>
				<TOP>75</TOP>
				<LEFT>0</LEFT>
			</POSITION>
	<!-- bink panels begin-->
			<WINDOW type="window" name="LOGO_SPLASH_HDR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>-75</TOP>
					<BOTTOM>0</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
			<WINDOW type="window" name="LOGO_SPLASH_FTR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>450</TOP>
					<BOTTOM>525</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
	<!-- bink panels end-->

			<WINDOW type="window" name="WRAPPER">
				<POSITION>
					<LEFT>0</LEFT>
					<TOP>-75</TOP>
				</POSITION>
				<WINDOW type="radio" name="RADIO_TAB_GENERAL">
					<GROUP>1</GROUP>
					<ACTION type="window" state="SHOW">TAB_GENERAL</ACTION>
					<ACTION type="window" state="HIDE">TAB_GAME</ACTION>
					<ACTION type="window" state="HIDE">TAB_WEAPON</ACTION>
					<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
					<POSITION>
						<LEFT>178</LEFT>
						<TOP>87</TOP>
						<BOTTOM>111</BOTTOM>
					</POSITION>
					<STRING type="ID" justify="CENTER" vjustify="CENTER">TAB_GENERAL</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="radio" name="RADIO_TAB_GAME">
					<GROUP>1</GROUP>
					<ACTION type="window" state="HIDE">TAB_GENERAL</ACTION>
					<ACTION type="window" state="SHOW">TAB_GAME</ACTION>
					<ACTION type="window" state="HIDE">TAB_WEAPON</ACTION>
					<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
					<POSITION>
						<LEFT>326</LEFT>
						<TOP>87</TOP>
						<BOTTOM>111</BOTTOM>
					</POSITION>
					<STRING type="ID" justify="CENTER" vjustify="CENTER">TAB_GAME</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="radio" name="RADIO_TAB_WEAPON">
					<GROUP>1</GROUP>
					<ACTION type="window" state="HIDE">TAB_GENERAL</ACTION>
					<ACTION type="window" state="HIDE">TAB_GAME</ACTION>
					<ACTION type="window" state="SHOW">TAB_WEAPON</ACTION>
					<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
					<POSITION>
						<LEFT>474</LEFT>
						<TOP>87</TOP>
						<BOTTOM>111</BOTTOM>
					</POSITION>
					<STRING type="ID" justify="CENTER" vjustify="CENTER">TAB_WEAPON</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="window">
					<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
					<POSITION>
						<TOP>110</TOP>
						<BOTTOM>110</BOTTOM>
						<LEFT>0</LEFT>
						<RIGHT>179</RIGHT>
					</POSITION>
				</WINDOW>
				<WINDOW type="window">
					<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
					<POSITION>
						<TOP>110</TOP>
						<BOTTOM>110</BOTTOM>
						<LEFT>621</LEFT>
						<RIGHT>801</RIGHT>
					</POSITION>
				</WINDOW>

				<WINDOW type="button" name="START_GAME">
					<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
					<APPEARANCE type="image" state="default" map_state="0" height="36">btn8.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="36">btn8.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="36">btn8.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="36">btn8.tga</APPEARANCE>
					<POSITION>
						<LEFT>510</LEFT>
						<TOP>486</TOP>
						<BOTTOM>522</BOTTOM>
					</POSITION>
					<STRING justify="CENTER" vjustify="CENTER" type="id">START_HOSTING</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_JOIN">menu.lwf</SOUND>
				</WINDOW>

				<WINDOW type="window" name="TAB_GENERAL">
					<POSITION>
						<LEFT>40</LEFT>
						<TOP>130</TOP>
					</POSITION>
					<WINDOW type="static" name="STATIC_GAME_NAME">
						<POSITION>
							<LEFT>0</LEFT>
							<RIGHT>100</RIGHT>
							<TOP>0</TOP>
							<BOTTOM>20</BOTTOM>
						</POSITION>
						<STRING justify="LEFT" vjustify="CENTER" type="id">HG_GAMENAME</STRING>
					</WINDOW>
					<WINDOW type="edit" name="GAME_NAME" MAXCHAR="31">
						<APPEARANCE type="image" state="default" map_state="0" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover" map_state="1" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected" map_state="2" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="disabled" map_state="3" height="20">btn1d.tga</APPEARANCE>
						<POSITION>
							<LEFT>102</LEFT>
							<RIGHT>302</RIGHT>
							<TOP>0</TOP>
							<BOTTOM>20</BOTTOM>
						</POSITION>
						<STRING type="id" edge="5" justify="LEFT" vjustify="CENTER">HG_GAMENAME</STRING>
						<SOUND state="mousein" trigger="MOVER_COMBO">menu.lwf</SOUND>
					</WINDOW>
					<WINDOW type="static" name="STATIC_PASSWORD">
						<POSITION>
							<LEFT>0</LEFT>
							<RIGHT>100</RIGHT>
							<TOP>30</TOP>
							<BOTTOM>50</BOTTOM>
						</POSITION>
						<STRING justify="LEFT" vjustify="CENTER" type="id">HG_PASSWORD</STRING>
					</WINDOW>
					<WINDOW type="edit" name="SERVER_PASSWORD" MAXCHAR="16">
						<APPEARANCE type="image" state="default" map_state="0" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover" map_state="1" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected" map_state="2" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="disabled" map_state="3" height="20">btn1d.tga</APPEARANCE>
						<POSITION>
							<LEFT>102</LEFT>
							<RIGHT>302</RIGHT>
							<TOP>30</TOP>
							<BOTTOM>50</BOTTOM>
						</POSITION>
						<STRING edge="5" justify="LEFT" vjustify="CENTER"></STRING>
						<SOUND state="mousein" trigger="MOVER_COMBO">menu.lwf</SOUND>
					</WINDOW>
					<WINDOW type="static" name="STATIC_SERVER_MESSAGE">
						<POSITION>
							<LEFT>0</LEFT>
							<RIGHT>100</RIGHT>
							<TOP>60</TOP>
							<BOTTOM>80</BOTTOM>
						</POSITION>
						<STRING justify="LEFT" vjustify="CENTER" type="id">HG_MESSAGE</STRING>
					</WINDOW>
					<WINDOW type="edit" name="SERVER_MESSAGE" MAXCHAR="128">
						<APPEARANCE type="image" state="default" map_state="0" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover" map_state="1" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected" map_state="2" height="20">btn1d.tga</APPEARANCE>
						<APPEARANCE type="image" state="disabled" map_state="3" height="20">btn1d.tga</APPEARANCE>
						<POSITION>
							<LEFT>102</LEFT>
							<RIGHT>302</RIGHT>
							<TOP>60</TOP>
							<BOTTOM>80</BOTTOM>
						</POSITION>
						<STRING edge="5" justify="LEFT" vjustify="CENTER" type="id">HG_WELCOME</STRING>
						<SOUND state="mousein" trigger="MOVER_COMBO">menu.lwf</SOUND>
					</WINDOW>
					<WINDOW type="static" name="STATIC_SERVER_PUNKBUSTER">
						<POSITION>
							<LEFT>350</LEFT>
							<RIGHT>500</RIGHT>
							<TOP>60</TOP>
							<BOTTOM>84</BOTTOM>
						</POSITION>
						<STRING justify="LEFT" vjustify="CENTER" type="id">SERVER_PUNKBUSTER</STRING>
					</WINDOW>
					<WINDOW type="spinlist" name="SERVER_PUNKBUSTER">
