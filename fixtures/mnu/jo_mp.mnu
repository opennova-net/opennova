<SCREEN>
	<NAME>LAN_MULTI_PLAYER</NAME>
	<MUSICVAR>5</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<APPEARANCE type="image" state="default">letterbox.tga</APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>%DEF_FONTNAME%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>

		<WINDOW type="window" name="ALIGNMENT_WRAPPER">
			<POSITION>
				<TOP>75</TOP>
				<LEFT>0</LEFT>
			</POSITION>

<!-- bink panels begin-->
			<WINDOW type="window" name="LOGO_SPLASH_HDR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>-75</TOP>
					<BOTTOM>0</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
			<WINDOW type="window" name="LOGO_SPLASH_FTR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>450</TOP>
					<BOTTOM>525</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
<!-- bink panels end-->
			
			<WINDOW type="window" name="LAN">
				<POSITION>
					<LEFT>70</LEFT>
					<TOP>45</TOP>
				</POSITION>
					<WINDOW type="button" name="LAN_SEARCH">
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn2.tga</APPEARANCE>
					<POSITION>
						<TOP>151</TOP>
						<BOTTOM>175</BOTTOM>
					</POSITION>
					<STRING justify="CENTER" vjustify="CENTER" type="id">MP_SEARCH</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="button" name="LAN_JOINGAME">
					<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn2.tga</APPEARANCE>
					<POSITION>
						<TOP>185</TOP>
						<BOTTOM>209</BOTTOM>
					</POSITION>
					<STRING justify="CENTER" vjustify="CENTER" type="id">MP_JOINGAME</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_JOIN">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="button" name="LAN_HOSTGAME">
					<ACTION type="SCREEN" file="mp.mnu">MULTI_PLAYER_HOST</ACTION>
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="24">btn2.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn2.tga</APPEARANCE>
					<POSITION>
						<TOP>219</TOP>
						<BOTTOM>243</BOTTOM>
					</POSITION>
					<STRING justify="CENTER" vjustify="CENTER" type="id">MP_HOSTGAME</STRING>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="list" name="LAN_GAME_LIST">
					<APPEARANCE type=image state="default">box_lan.tga</APPEARANCE>
					<POSITION>
						<LEFT>130</LEFT>
						<TOP>5</TOP>
						<RIGHT>530</RIGHT>
						<BOTTOM>380</BOTTOM>
					</POSITION>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
					<ITEMS justify="LEFT" vjustify="LEFT">
						<APPEARANCE type="color" state="selected">%ITEM_SELECTED_BG%</APPEARANCE>
					</ITEMS>
					<MIN_ITEM_HEIGHT>20</MIN_ITEM_HEIGHT>
					<SCROLLBAR>
						<APPEARANCE type="image" state="default">m_scrolV.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover">m_scrolV.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected">m_scrolV.tga</APPEARANCE>
						<SHUTTLE type="image" state="default">shuttlev.tga</SHUTTLE>
						<SHUTTLE type="image" state="mouseover">shuttlev.tga</SHUTTLE>
						<SHUTTLE type="image" state="selected">shuttlev.tga</SHUTTLE>
						<SCROLLUP type="image" state="default" map_state="0" height="24">up2arrw.tga</APPEARANCE>
						<SCROLLUP type="image" state="mouseover" map_state="1" height="24">up2arrw.tga</APPEARANCE>
						<SCROLLUP type="image" state="selected" map_state="2" height="24">up2arrw.tga</APPEARANCE>
						<SCROLLUP type="image" state="disabled" map_state="3 height="24">up2arrw.tga</APPEARANCE>
						<SCROLLDOWN type="image" state="default" map_state="0" height="24">dn2arrw.tga</APPEARANCE>
						<SCROLLDOWN type="image" state="mouseover" map_state="1" height="24">dn2arrw.tga</APPEARANCE>
						<SCROLLDOWN type="image" state="selected" map_state="2" height="24">dn2arrw.tga</APPEARANCE>
						<SCROLLDOWN type="image" state="disabled" map_state="3" height="24">dn2arrw.tga</APPEARANCE>
						<SOUND state="selected" trigger="CLICK_VALUE">menu.lwf</SOUND>
						<POSITION>
							<LEFT>408</LEFT>
							<TOP>0</TOP>
							<RIGHT>428</RIGHT>
							<BOTTOM>258</BOTTOM>
						</POSITION>
					</SCROLLBAR>
				</WINDOW>
			</WINDOW>
			
			<WINDOW type="button" name="BACK">
				<ACTION type="POP_SCREEN"></ACTION>
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<FONT>
					<NAME>%DEF_FONTNAME_LG%</NAME>
					<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
					<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
					<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
					<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
				</FONT>
				<POSITION>
					<LEFT>5</LEFT>
					<TOP>425</TOP>
				</POSITION>
				<STRING type="id" justify="LEFT">NAV_BACK</STRING>
			</WINDOW>
		</WINDOW>
	</WINDOW>
</SCREEN>

<SCREEN>
	<NAME>NW_MULTI_PLAYER</NAME>
	<MUSICVAR>6</MUSICVAR>
	<WINDOW type="window" name="OUTER_MAIN">
