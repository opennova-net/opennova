				<WINDOW type="static" name="STATIC_PARTICLES" HIDDEN>
					<POSITION>
						<TOP>60</TOP>
						<BOTTOM>80</BOTTOM>
					</POSITION>
					<STRING type="ID" vjustify="CENTER">OPT_ParticleDensity</STRING>
				</WINDOW>
				<WINDOW type="combobox" name="PARTICLES" HIDDEN>
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn1.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="24">btn1.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn1.tga</APPEARANCE>
