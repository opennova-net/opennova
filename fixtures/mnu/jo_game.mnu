						<TOP>30</TOP>
						<BOTTOM>50</BOTTOM>
					</POSITION>
					<STRING type="ID" vjustify="CENTER">OPT_ObjectDetail</STRING>
				</WINDOW>
				<WINDOW type="combobox" name="OBJECTDETAIL" HIDDEN>
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn1.tga</APPEARANCE>
