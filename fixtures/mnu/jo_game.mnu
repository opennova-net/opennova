<SCREEN>
	<NAME>INGAME</NAME>
	<MUSICVAR>4</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<FRAME>
			<STENCIL size="32">BORDER2.tga</STENCIL>
			<BRUSH>BOXTILE.tga</BRUSH>
			<MONOGRAM>MONOGRAM.tga</MONOGRAM>
		</FRAME>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>%DEF_FONTNAME%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>
		
		<WINDOW type="window" name="MAIN_WRAPPER" DRAW_FRAME>
			<POSITION>
				<LEFT>256</LEFT>
				<TOP>187</TOP>
				<RIGHT>544</RIGHT>
				<BOTTOM>335</BOTTOM>
			</POSITION>
			<FONT>
				<NAME>%IMPACT_FONTNAME%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<WINDOW type="button" name="OPTIONS">
				<ACTION type="window" state="SHOW">OPTIONS_WRAPPER</ACTION>
				<ACTION type="window" state="HIDE">MAIN_WRAPPER</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>288</RIGHT>
					<TOP>0</TOP>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_Options</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="button" name="RESTART">
<!--				<ACTION type="window" state="SHOW">CONFIRM_EXIT</ACTION> -->
<!--				<ACTION type="window" state="HIDE">MAIN_WRAPPER</ACTION> -->
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>288</RIGHT>
					<TOP>50</TOP>
				</POSITION>
				<STRING type="id" justify="CENTER">RESTART_MISSION</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_JOIN">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="button" name="ABORT">
				<ACTION type="window" state="SHOW">CONFIRM_EXIT</ACTION>
				<ACTION type="window" state="HIDE">MAIN_WRAPPER</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>288</RIGHT>
					<TOP>100</TOP>
				</POSITION>
				<STRING type="id" justify="CENTER">EXIT_MISSION</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="button" name="HIDDEN_BACK">
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>288</RIGHT>
					<TOP>150</TOP>
				</POSITION>
				<STRING></STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
		</WINDOW>

<!-- CONFIRM EXIT -->
		<WINDOW type="window" name="CONFIRM_EXIT" HIDDEN DRAW_FRAME>
			<POSITION>
				<LEFT>206</LEFT>
				<TOP>225</TOP>
				<RIGHT>562</RIGHT>
				<BOTTOM>345</BOTTOM>
			</POSITION>
			<FONT>
				<NAME>%IMPACT_FONTNAME%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<WINDOW type="static" name="STATIC_CONFIRM">
				<APPEARANCE state="default"></APPEARANCE>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>356</RIGHT>
					<TOP>5</TOP>
				</POSITION>
				<STRING type="id" justify="CENTER">ARE_YOU_SURE</STRING>
			</WINDOW>
			<WINDOW type="button" name="CONFIRM_YES">
				<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
				<ACTION type="window" state="SHOW">MAIN_WRAPPER</ACTION>
				<ACTION type="window" state="HIDE">CONFIRM_EXIT</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<POSITION>
					<LEFT>206</LEFT>
					<RIGHT>306</RIGHT>
					<TOP>65</TOP>
				</POSITION>
				<STRING type="id" justify="RIGHT">YES</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_JOIN">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="button" name="CONFIRM_NO">
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<ACTION type="window" state="SHOW">MAIN_WRAPPER</ACTION>
				<ACTION type="window" state="HIDE">CONFIRM_EXIT</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<POSITION>
					<LEFT>50</LEFT>
					<RIGHT>150</RIGHT>
					<TOP>65</TOP>
				</POSITION>
				<STRING type="id" justify="LEFT">NO</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
		</WINDOW>
		
<!-- OPTIONS -->
		<WINDOW type="window" name="OPTIONS_WRAPPER" HIDDEN DRAW_FRAME>
			<POSITION>
				<LEFT>50</LEFT>
				<TOP>50</TOP>
				<BOTTOM>550</BOTTOM>
				<RIGHT>750</RIGHT>
			</POSITION>
			
			<WINDOW type="radio" name="RADIO_TAB_VIDEO" CHECKED>
				<GROUP>1</GROUP>
				<ACTION type="window" state="SHOW">TAB_VIDEO</ACTION>
				<ACTION type="window" state="HIDE">TAB_AUDIO</ACTION>
				<ACTION type="window" state="HIDE">TAB_CONTROLS</ACTION>
				<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
				<POSITION>
					<LEFT>94</LEFT>
					<TOP>11</TOP>
					<BOTTOM>36</BOTTOM>
				</POSITION>
				<STRING type="id" justify="CENTER" vjustify="CENTER">OPT_Video</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="radio" name="RADIO_TAB_AUDIO">
				<GROUP>1</GROUP>
				<ACTION type="window" state="HIDE">TAB_VIDEO</ACTION>
				<ACTION type="window" state="SHOW">TAB_AUDIO</ACTION>
				<ACTION type="window" state="HIDE">TAB_CONTROLS</ACTION>
				<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
				<POSITION>
					<LEFT>242</LEFT>
					<TOP>11</TOP>
					<BOTTOM>36</BOTTOM>
				</POSITION>
				<STRING type="id" justify="CENTER" vjustify="CENTER">OPT_Audio</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="radio" name="RADIO_TAB_CONTROLS">
				<GROUP>1</GROUP>
				<ACTION type="window" state="HIDE">TAB_VIDEO</ACTION>
				<ACTION type="window" state="HIDE">TAB_AUDIO</ACTION>
				<ACTION type="window" state="SHOW">TAB_CONTROLS</ACTION>
				<APPEARANCE type="image" state="default"   map_state="0" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="25">tab_mid.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="25">tab_mid.tga</APPEARANCE>
				<POSITION>
					<LEFT>390</LEFT>
					<TOP>11</TOP>
					<BOTTOM>36</BOTTOM>
				</POSITION>
				<STRING type="id" justify="CENTER" vjustify="CENTER">OPT_Remap</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
			<WINDOW type="window">
				<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
				<POSITION>
					<TOP>35</TOP>
					<BOTTOM>35</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>95</RIGHT>
				</POSITION>
			</WINDOW>
			<WINDOW type="window">
				<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
				<POSITION>
					<TOP>35</TOP>
					<BOTTOM>35</BOTTOM>
					<LEFT>538</LEFT>
					<RIGHT>701</RIGHT>
				</POSITION>
			</WINDOW>
			
<!-- VIDEO -->
			<WINDOW type="window" name="TAB_VIDEO">
