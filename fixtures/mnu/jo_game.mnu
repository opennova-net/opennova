				<WINDOW type="static" name="STATIC_GAMMA">
					<POSITION>
						<LEFT>388</LEFT>
						<TOP>0</TOP>
						<BOTTOM>20</BOTTOM>
					</POSITION>
					<STRING type="ID" vjustify="CENTER">OPT_Gamma</STRING>
				</WINDOW>
				<WINDOW type="scroll" name="GAMMA">
					<POSITION>
						<TOP>0</TOP>
						<LEFT>455</LEFT>
						<RIGHT>612</RIGHT>
						<BOTTOM>20</BOTTOM>
					</POSITION>
					<ORIENTATION>HORIZONTAL</ORIENTATION>
