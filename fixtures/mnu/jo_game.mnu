					<SCROLLDOWN type="image" state="disabled" map_state="3" height="24">Rt_arrw.tga</SCROLLDOWN>
					<SOUND state="selected" trigger="CLICK_VALUE">menu.lwf</SOUND>
				</WINDOW>
				<WINDOW type="static" name="STATIC_OBJECTDETAIL" HIDDEN>
