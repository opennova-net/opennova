			<WINDOW type="button" name="ACCEPT">
				<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
				<APPEARANCE type="image" state="default" map_state="0" height="24">tmp4_btn.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="24">tmp4_btn.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="24">tmp4_btn.tga</APPEARANCE>
