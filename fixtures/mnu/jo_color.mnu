					<LEFT>0</LEFT>
					<RIGHT>100</RIGHT>
					<TOP>125</TOP>
					<BOTTOM>150</BOTTOM>
				</POSITION>
				<STRING justify="CENTER" vjustify="CENTER">Accept</STRING>
			</WINDOW>
			<WINDOW type="button" name="CANCEL">
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<APPEARANCE type="image" state="default" map_state="0" height="24">tmp4_btn.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="24">tmp4_btn.tga</APPEARANCE>
