<SCREEN>
	<NAME>VEHICLE</NAME>
	<MUSICVAR>13</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>arial18.fnt</NAME>
			<DEFAULT_FG>FFFFFF</DEFAULT_FG>
			<MOUSEOVER_FG>FFba58</MOUSEOVER_FG>
			<SELECTED_FG>e2900a</SELECTED_FG>
			<DISABLED_FG>746038</DISABLED_FG>
		</FONT>

		<WINDOW type="window" name="VEHICLE_ROOT">
			<POSITION>
				<LEFT>224</LEFT>
				<TOP>40</TOP>
			</POSITION>
			<WINDOW type="window" name="ITEM_DISPLAY">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<APPEARANCE type="custom" state="mouseover"></APPEARANCE>
				<APPEARANCE type="custom" state="selected"></APPEARANCE>
				<APPEARANCE type="custom" state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>20</LEFT>
					<RIGHT>320</RIGHT>
					<TOP>240</TOP>
					<BOTTOM>440</BOTTOM>
				</POSITION>
			</WINDOW>
			<WINDOW type="list" name="ITEM_LIST">
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>20</LEFT>
					<RIGHT>320</RIGHT>
					<TOP>40</TOP>
					<BOTTOM>240</BOTTOM>
				</POSITION>
				<ITEMS justify="LEFT" vjustify="CENTER">
					<APPEARANCE type="color" state="selected">7f7F0000</APPEARANCE>
				</ITEMS>
				<MIN_ITEM_HEIGHT>24</MIN_ITEM_HEIGHT>
				<SCROLLBAR>
					<SHUTTLE type="color" state="default">7fAF0000</SHUTTLE>
					<SHUTTLE type="color" state="mouseover">7f7F0000</SHUTTLE>
					<SHUTTLE type="color" state="selected">7fFF0000</SHUTTLE>
					<SCROLLUP type="image" state="default" map_state="0" height="14">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="mouseover" map_state="1" height="14">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="selected" map_state="2" height="14">up2arrw.tga</SCROLLUP>
					<SCROLLUP type="image" state="disabled" map_state="3 height="14">up2arrw.tga</SCROLLUP>
					<SCROLLDOWN type="image" state="default" map_state="0" height="14">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="mouseover" map_state="1" height="14">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="selected" map_state="2" height="14">dn2arrw.tga</SCROLLDOWN>
					<SCROLLDOWN type="image" state="disabled" map_state="3" height="14">dn2arrw.tga</SCROLLDOWN>
					<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
					<POSITION>
						<LEFT>300</LEFT>
						<TOP>0</TOP>
						<RIGHT>316</RIGHT>
						<BOTTOM>200</BOTTOM>
					</POSITION>
				</SCROLLBAR>
			</WINDOW>


<!-- ACCEPT -->
			<WINDOW type="button" name="ACCEPT">
				<HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>8</LEFT>
					<TOP>460</TOP>
				</POSITION>
				<STRING type="id">WD_ACCEPT</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>
<!-- CANCEL -->
			<WINDOW type="button" name="CANCEL">
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<POSITION>
					<LEFT>283</LEFT>
					<TOP>460</TOP>
				</POSITION>
				<STRING type="id">WD_CANCEL</STRING>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
			</WINDOW>

		
		</WINDOW>
	</WINDOW>
</SCREEN>

