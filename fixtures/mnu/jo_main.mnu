<SCREEN>
	<NAME>STARTUP</NAME>
	<MUSICVAR>1</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<APPEARANCE type="custom" state="default"></APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>75</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>525</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>

<!--- MOVIES -->
		<WINDOW type="window" name="LOGO_SPLASH_HDR">
			<APPEARANCE type="image" state="default">Main_hdr.tga</APPEARANCE>
			<POSITION>
				<TOP>-75</TOP>
				<BOTTOM>0</BOTTOM>
				<LEFT>0</LEFT>
				<RIGHT>801</RIGHT>
			</POSITION>
		</WINDOW>
		<WINDOW type="window" name="LOGO_SPLASH_FTR">
			<APPEARANCE type="image" state="default">Main_ftr.tga</APPEARANCE>
			<POSITION>
				<TOP>450</TOP>
				<BOTTOM>525</BOTTOM>
				<LEFT>0</LEFT>
				<RIGHT>801</RIGHT>
			</POSITION>
		</WINDOW>
<!--- MOVIES -->

		<WINDOW type="window" name="BUTTONS">
			<FONT>
				<NAME>%DEF_FONTNAME_LG%</NAME>
				<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
				<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
				<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
				<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
			</FONT>
			<POSITION>
				<LEFT>0</LEFT>
				<TOP>453</TOP>
			</POSITION>
			<WINDOW type="button" name="SINGLE_PLAYER">
				<ACTION type="screen" file="sp.mnu">SINGLE_PLAYER</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>40</LEFT>
					<RIGHT>150</RIGHT>
				</POSITION>
				<STRING type="id" justify="LEFT">MM_Singleplayer</STRING>
			</WINDOW>
			<!-- SPAGH<WINDOW type="button" name="NW_MULTI_PLAYER">
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>125</LEFT>
					<RIGHT>236</RIGHT>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_NWMultiplayer</STRING>
			</WINDOW>SPAGH-->
			<WINDOW type="button" name="LAN_MULTI_PLAYER">
				<ACTION type="screen" file="mp.mnu">LAN_MULTI_PLAYER</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>215</LEFT>
					<RIGHT>355</RIGHT>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_LANMultiplayer</STRING>
			</WINDOW>
			<WINDOW type="button" name="PLAYER_INFO">
				<ACTION type="screen" file="player.mnu">PLAYER_INFO</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>375</LEFT>
					<RIGHT>500</RIGHT>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_ChangePilot</STRING>
			</WINDOW>
			<WINDOW type="button" name="OPTIONS">
				<ACTION type="screen" file="options.mnu">OPTIONS</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>510</LEFT>
					<RIGHT>650</RIGHT>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_Options</STRING>
			</WINDOW>
			<WINDOW type="button" name="DATABASE" DISABLE HIDDEN>
				<ACTION type="screen" file="item_db.mnu">ITEM_DATABASE</ACTION>
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>600</LEFT>
					<RIGHT>699</RIGHT>
				</POSITION>
				<STRING type="id" justify="CENTER">MM_Database</STRING>
			</WINDOW>
			<WINDOW type="button" name="EXIT">
				<APPEARANCE state="default"></APPEARANCE>
				<APPEARANCE state="mouseover"></APPEARANCE>
				<APPEARANCE state="selected"></APPEARANCE>
				<APPEARANCE state="disabled"></APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>0</TOP>
					<LEFT>700</LEFT>
					<RIGHT>750</RIGHT>
				</POSITION>
				<STRING type="id" justify="RIGHT">MM_Exit</STRING>
			</WINDOW>
			<WINDOW type="static" name="VERSION">
				<FONT>
					<NAME>Arial12b.fnt</NAME>
					<DEFAULT_FG>c4c4c4</DEFAULT_FG>
					<DEFAULT_BG>000000</DEFAULT_BG>
					<DISABLED_FG>746038</DISABLED_FG>
					<DISABLED_BG>000000</DISABLED_BG>
					<SELECTED_FG>e2900a</SELECTED_FG>
					<SELECTED_BG>000000</SELECTED_BG>
					<MOUSEOVER_FG>FF0000</MOUSEOVER_FG>
					<MOUSEOVER_BG>000000</MOUSEOVER_BG>
				</FONT>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>775</RIGHT>
					<TOP>50</TOP>
				</POSITION>
				<STRING justify="RIGHT"></STRING>
			</WINDOW>
			<WINDOW type="static" name="VERSION">
				<FONT>
					<NAME>Arial12b.fnt</NAME>
					<DEFAULT_FG>c4c4c4</DEFAULT_FG>
					<DEFAULT_BG>000000</DEFAULT_BG>
					<DISABLED_FG>746038</DISABLED_FG>
					<DISABLED_BG>000000</DISABLED_BG>
					<SELECTED_FG>e2900a</SELECTED_FG>
					<SELECTED_BG>000000</SELECTED_BG>
					<MOUSEOVER_FG>FF0000</MOUSEOVER_FG>
					<MOUSEOVER_BG>000000</MOUSEOVER_BG>
				</FONT>
				<POSITION>
					<LEFT>25</LEFT>
					<RIGHT>775</RIGHT>
					<TOP>50</TOP>
				</POSITION>
				<STRING justify="LEFT">© 2004, NovaLogic, Inc.</STRING>
			</WINDOW>
			<WINDOW type="static" name="VERSION_EXP">
				<FONT>
					<NAME>Arial12b.fnt</NAME>
					<DEFAULT_FG>c4c4c4</DEFAULT_FG>
					<DEFAULT_BG>000000</DEFAULT_BG>
					<DISABLED_FG>746038</DISABLED_FG>
					<DISABLED_BG>000000</DISABLED_BG>
					<SELECTED_FG>e2900a</SELECTED_FG>
					<SELECTED_BG>000000</SELECTED_BG>
					<MOUSEOVER_FG>FF0000</MOUSEOVER_FG>
					<MOUSEOVER_BG>000000</MOUSEOVER_BG>
				</FONT>
				<POSITION>
					<LEFT>0</LEFT>
					<RIGHT>775</RIGHT>
					<TOP>60</TOP>
				</POSITION>
				<STRING justify="RIGHT">Escalation V1.3.0.0 </STRING>
			</WINDOW>
		</WINDOW>
	</WINDOW>
</SCREEN>

