<SCREEN>
	<NAME>WEAPON</NAME>
	<MUSICVAR>14</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<FRAME>
			<STENCIL size="32">BORDER2.tga</STENCIL>
			<BRUSH>BOXTILE.tga</BRUSH>
			<MONOGRAM>MONOGRAM.tga</MONOGRAM>
		</FRAME>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>%DEF_FONTNAME%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>

		<WINDOW type="window" name="WEAPON_FRAME" DRAW_FRAME>
			<POSITION>
				<LEFT>224</LEFT>
				<RIGHT>700</RIGHT>
				<TOP>40</TOP>
				<BOTTOM>560</BOTTOM>
			</POSITION>
		
			<WINDOW type="window" name="WEAPON_ROOT">
				<POSITION>
					<LEFT>10</LEFT>
					<TOP>10</TOP>
				</POSITION>

				<WINDOW type="static" name="STATIC_PLAYER_CLASS">
					<POSITION>
						<LEFT>69</LEFT>
						<TOP>30</TOP>
						<BOTTOM>55</BOTTOM>
					</POSITION>
					<STRING type="id" justify="LEFT">PLAYER_CHARTYPE</STRING>
				</WINDOW>
				<WINDOW type="spinlist" name="PLAYER_CLASS">
					<APPEARANCE type="image" state="default" map_state="0" height="24">btn7.tga</APPEARANCE>
					<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn7.tga</APPEARANCE>
					<APPEARANCE type="image" state="selected" map_state="2" height="24">btn7.tga</APPEARANCE>
					<APPEARANCE type="image" state="disabled" map_state="3" height="24">btn7.tga</APPEARANCE>
					<POSITION>
						<LEFT>219</LEFT>
						<RIGHT>375</RIGHT>
						<TOP>30</TOP>
						<BOTTOM>55</BOTTOM>
					</POSITION>
					<ITEMS justify="CENTER" vjustify="CENTER"></ITEMS>
					<SPINUP>
						<APPEARANCE type="image" state="default" map_state="0" height="24">Rt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover" map_state="1" height="24">Rt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected" map_state="2" height="24">Rt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="disabled" map_state="3" height="24">Rt_arrw.tga</APPEARANCE>
						<POSITION>
							<LEFT>157</LEFT>
							<RIGHT>173</RIGHT>
							<BOTTOM>25</BOTTOM>
						</POSITION>
					</SPINUP>
					<SPINDOWN>
						<APPEARANCE type="image" state="default" map_state="0" height="24">Lt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="mouseover" map_state="1" height="24">Lt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="selected" map_state="2" height="24">Lt_arrw.tga</APPEARANCE>
						<APPEARANCE type="image" state="disabled" map_state="3" height="24">Lt_arrw.tga</APPEARANCE>
						<POSITION>
							<LEFT>-17</LEFT>
							<RIGHT>-1</RIGHT>
							<BOTTOM>25</BOTTOM>
						</POSITION>
					</SPINDOWN>
					<SOUND state="mousein" trigger="MOVER_COMBO">menu.lwf</SOUND>
					<SOUND state="selected" trigger="CLICK_VALUE">menu.lwf</SOUND>
				</WINDOW>

