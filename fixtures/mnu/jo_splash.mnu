<SCREEN>
	<NAME>SPLASH</NAME>
	<WINDOW type="window" name="MAIN">
		<APPEARANCE type="image" state="default">Upsel4.tga</APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<WINDOW type="window" name="BUTTONS">
			<FONT>
				<NAME>Impact50.fnt</NAME>
				<DEFAULT_FG>c8c8c8</DEFAULT_FG>
				<MOUSEOVER_FG>e2900a</MOUSEOVER_FG>
				<SELECTED_FG>e2900a</SELECTED_FG>
				<DISABLED_FG>746038</DISABLED_FG>
			</FONT>
			<POSITION>
				<LEFT>0</LEFT>
				<TOP>0</TOP>
			</POSITION>
			<WINDOW type="button" name="PREORDER">
				<ACTION type="URL" EXTERNAL_BROWSER>www.novalogic.com/link.asp?ID=101</ACTION>
				<APPEARANCE type="image" state="default"   map_state="0" height="34">btn_buyn.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="34">btn_buyn.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="34">btn_buyn.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="34">btn_buyn.tga</APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>472</TOP>
					<LEFT>366</LEFT>
					<BOTTOM>505</BOTTOM>
				</POSITION>
			</WINDOW>
			<WINDOW type="button" name="NOVALOGIC">
				<ACTION type="URL" EXTERNAL_BROWSER>www.novalogic.com/link.asp?ID=102</ACTION>
				<APPEARANCE type="image" state="default"   map_state="0" height="24">btn_nls.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="24">btn_nls.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="24">btn_nls.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="24">btn_nls.tga</APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>472</TOP>
					<LEFT>524</LEFT>
					<BOTTOM>496</BOTTOM>
				</POSITION>
			</WINDOW>
			<WINDOW type="button" name="SPLASH_EXIT">
				<APPEARANCE type="image" state="default"   map_state="0" height="32">btn_exit.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="32">btn_exit.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected"  map_state="2" height="32">btn_exit.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled"  map_state="3" height="32">btn_exit.tga</APPEARANCE>
				<SOUND state="mousein" trigger="MOUSE_OVER">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_SELECT">menu.lwf</SOUND>
				<POSITION>
					<TOP>472</TOP>
					<LEFT>255</LEFT>
					<BOTTOM>505</BOTTOM>
				</POSITION>
				<HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
			</WINDOW>
		</WINDOW>
	</WINDOW>
</SCREEN>

