			<WINDOW type="static" name="STATIC_PLAYERCLASS">
				<POSITION>
					<LEFT>300</LEFT>
					<RIGHT>350</RIGHT>
					<TOP>27</TOP>
					<BOTTOM>47</BOTTOM>
				</POSITION>
				<STRING type="id" justify="LEFT">CLASS</STRING>
			</WINDOW>
			<WINDOW type="combobox" name="PLAYERCLASS">
				<APPEARANCE type="image" state="default" map_state="0" height="20">btn1b.tga</APPEARANCE>
				<APPEARANCE type="image" state="mouseover" map_state="1" height="20">btn1b.tga</APPEARANCE>
				<APPEARANCE type="image" state="selected" map_state="2" height="20">btn1b.tga</APPEARANCE>
				<APPEARANCE type="image" state="disabled" map_state="3" height="20">btn1b.tga</APPEARANCE>
				<POSITION>
					<LEFT>355</LEFT>
					<RIGHT>555</RIGHT>
					<TOP>27</TOP>
					<BOTTOM>47</BOTTOM>
				</POSITION>
				<LIST_BOX>
					<APPEARANCE type="outline" state="default">%TRIM_COLOR%</APPEARANCE>
					<APPEARANCE type="outline" state="mouseover">%TRIM_COLOR%</APPEARANCE>
					<APPEARANCE type="outline" state="selected">%TRIM_COLOR%</APPEARANCE>
					<APPEARANCE type="outline" state="disabled">%TRIM_COLOR%</APPEARANCE>
					<APPEARANCE type="color" state="default">%COLOR_BLACK%</APPEARANCE>
					<APPEARANCE type="color" state="mouseover">%COLOR_BLACK%</APPEARANCE>
					<APPEARANCE type="color" state="selected">%COLOR_BLACK%</APPEARANCE>
					<APPEARANCE type="color" state="disabled">%COLOR_BLACK%</APPEARANCE>
					<POSITION>
						<LEFT>0</LEFT>
						<RIGHT>200</RIGHT>
						<TOP>20</TOP>
						<BOTTOM>120</BOTTOM>
					</POSITION>
					<ITEMS justify="LEFT" vjustify="CENTER">
						<APPEARANCE type="color" state="selected">%ITEM_SELECTED_BG%</APPEARANCE>
						<ITEM type="ID" value="5">CHARTYPE_DELTA_MEDIC</ITEM>
						<ITEM type="ID" value="6">CHARTYPE_DELTA_SNIPER</ITEM>
						<ITEM type="ID" value="7">CHARTYPE_DELTA_GUNNER</ITEM>
						<ITEM type="ID" value="8">CHARTYPE_DELTA_RIFLEMAN</ITEM>
						<ITEM type="ID" value="9">CHARTYPE_DELTA_ENGINEER</ITEM>
					</ITEMS>
					<MIN_ITEM_HEIGHT>20</MIN_ITEM_HEIGHT>
					<STRING edge="5"></STRING>
				</LIST_BOX>
				<SOUND state="mousein" trigger="MOVER_COMBO">menu.lwf</SOUND>
				<SOUND state="selected" trigger="CLICK_VALUE">menu.lwf</SOUND>
			</WINDOW>
