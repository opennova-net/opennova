<SCREEN>
	<NAME>PLAYER_INFO</NAME>
	<MUSICVAR>10</MUSICVAR>
	<WINDOW type="window" name="MAIN">
		<FRAME>
			<STENCIL size="32">BORDER2.tga</STENCIL>
			<BRUSH>BOXTILE.tga</BRUSH>
			<MONOGRAM>MONOGRAM.tga</MONOGRAM>
		</FRAME>
		<APPEARANCE type="image" state="default">ltrbx_pl.tga</APPEARANCE>
		<POSITION>
			<LEFT>0</LEFT>
			<TOP>0</TOP>
			<RIGHT>800</RIGHT>
			<BOTTOM>600</BOTTOM>
		</POSITION>
		<TEXT_RSRC>menutxt.BIN</TEXT_RSRC>
		<CURSOR>
			<FILE>newarow1.tga</FILE>
			<FLAGS>STANDARD_TRANSPARENT</FLAGS>
		</CURSOR>
		<FONT>
			<NAME>%DEF_FONTNAME%</NAME>
			<DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
			<MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
			<SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
			<DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
		</FONT>

		<WINDOW type="window" name="ALIGNMENT_WRAPPER">
			<POSITION>
				<TOP>75</TOP>
				<LEFT>0</LEFT>
			</POSITION>
<!-- bink panels begin-->
			<WINDOW type="window" name="LOGO_SPLASH_HDR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>-75</TOP>
					<BOTTOM>0</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
			<WINDOW type="window" name="LOGO_SPLASH_FTR">
				<APPEARANCE type="custom" state="default"></APPEARANCE>
				<POSITION>
					<TOP>450</TOP>
					<BOTTOM>525</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
<!-- bink panels end-->

	<!-- PLAYER TABS -->
			<WINDOW type="static" name="STATIC_PLAYERPROFILE" HIDDEN>
				<POSITION>
					<LEFT>10</LEFT>
					<RIGHT>60</RIGHT>
					<TOP>0</TOP>
					<BOTTOM>20</BOTTOM>
				</POSITION>
				<STRING type="id" justify="LEFT">PROFILE</STRING>
			</WINDOW>
