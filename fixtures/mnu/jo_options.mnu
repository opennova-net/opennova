					<BOTTOM>525</BOTTOM>
					<LEFT>0</LEFT>
					<RIGHT>801</RIGHT>
				</POSITION>
			</WINDOW>
<!-- bink panels end-->

			<WINDOW type="radio" name="RADIO_TAB_GENERAL" CHECKED>
