o3d 2
# A small building (tests/threedi/o3d_cli_test.cpp --building): bldg LODs, a
# wall with a slot-2 detail texture on UV1, a register-driven luminous
# material, a part turning in a rotated MTRX frame, an omni and a spot light,
# a box occluder and a window whose planes the OED rule picks, a quoted user
# point name, a blink box and an empty LOD. Mission axes: x forward, y left,
# z up; triangles and collision faces counter-clockwise about the outward
# normal; occlusion faces too.
model BUILDING
uv1 1
register FLICKER
register DOOR_00
# frame 1: a quarter turn about up (mission axes, row-major, p' = p R)
mtrx 0 1 0 -1 0 0 0 0 1
material FF_MT_OP
texture wall.tga 1 0 0 0
texture wall_O.tga 2 0 0 0
material FF_ST_OP_LUM
texture bulb.tga
emissive 2
rgbgen 113 0 0 255 255 255 255 255 255
lod 200 bldg
part 0 0 0 0
mesh 0 0
# the wall at x = 2 facing +x; UV1 tiles the detail texture 4 times
v 2 -1 0 1 0 0 0 1 0 4
v 2 1 0 1 0 0 1 1 4 4
v 2 1 2 1 0 0 1 0 4 0
v 2 -1 2 1 0 0 0 0 0 0
t 0 1 2
t 0 2 3
part 0 1 0 1.5
mesh 1 0
# the bulb plate at z = 1.5 facing up
v 0.5 -0.5 1.5 0 0 1 0 0 0 0
v 1.5 -0.5 1.5 0 0 1 1 0 1 0
v 1.5 0.5 1.5 0 0 1 1 1 1 1
v 0.5 0.5 1.5 0 0 1 0 1 0 1
t 0 1 2
t 0 2 3
panm 0 0
panm 1 0 0x00000200 1
track rotx 113 DOOR_00 0 0 4096
lod 0 bldg
userpoint "ground A" 0 0 0 0 0 1 0 71
light 1 1 0 1.5 0 4 55 0.296875 0.5 255 0 34 240 235 230 0x40
light 0 0 1 2 0 6 24 0 0 255 255 255 0 0 0 0x48 0 0 -1 30
# an occluder box: the planes and each face's plane come from the OED rule
occ 0 0 0
ov 2 -1 0
ov 2 1 0
ov -2 -1 0
ov -2 1 0
ov 2 -1 2
ov 2 1 2
ov -2 -1 2
ov -2 1 2
of 0 2 3
of 3 1 0
of 4 5 7
of 7 6 4
of 0 1 5
of 5 4 0
of 1 3 7
of 7 5 1
of 3 2 6
of 6 7 3
of 2 0 4
of 4 6 2
# a window from section 1 out to the exterior, facing +x
occ 2 1 0
ov 2 -0.5 0.5
ov 2 0.5 0.5
ov 2 0.5 1.5
ov 2 -0.5 1.5
of 0 1 2
of 0 2 3
cobj 0 0 0 0
cv 2 -1 0
cv 2 1 0
cv 2 1 2
cv 2 -1 2
cf 0 1 2 12
cf 0 2 3 12
cvol 1 0 -2 -1 0 2 1 2
cobj 0 1 0 1.5
cvol 8 46 0.5 -0.5 1.4 1.5 0.5 1.6
