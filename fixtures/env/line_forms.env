;OpenNova authored environment: one of each line form the shipped .env files take
;a fixture for the env_shipped_forms ctest

enviro_name "Forms1"    // our own name
timeofday "Night"

envscale   1.0
iris_percent 15
iris_center 0.5

water_rgb         20,40,60              ;the water under the fog

sky_map1          cloud01.pcx           ;base layer - a cloud picture, square rooted
sky_map2          cloud01b.pcx          ;second layer, a modulation centered at 128
sky_height        175                   ;dome height in units
sky_speed         12                    ;layer drift

fog_level         900                  ;0=none 1=1000 units out.
fog_type          2                     ;0=off, 1=linear, 2=exp, 3=exp squared

cloud_rgb         128,128,128           ;tint of the clouds
terrain_rgb       200,200,200           ;1.0 is white light (255,255,255 is full)
vertex_rgb        128,128,128           ;1.0 is white light (255,255,255 is full)

lightning_rgb     80,80,96              ;flash colour (night only)
sun_3di           msun.3di              ;sun model
moon_3di          fmoon4.3di            ;moon model
glare_3di         mglare.3di            ;glare model
star_3di                                ;no star model / none drawn here

;indoor colours
ceiling_rgb       56,56,56              ;inside lit from above
;ceiling_rgb      90,90,90              ;inside lit from above
floor_rgb         24,24,24              ;inside, lit from below
;floor_rgb        70,70,70              ;inside, lit from below

curtime         1200
advanced_clouds    1

    ; the keyframes, two of them left open as two shipped files leave them
	; each block a time and its colours
tod_begin  0000
    sun_rgb            0,5,10
    moon_rgb           17,22,27
    sky_rgb            34,39,44
    ground_rgb         51,56,61
    skyfog_rgb         68,73,78
    fog_rgb            85,90,95
    skybase_rgb        102,107,112
    skybright_rgb      119,124,129
    skyhighlight_rgb   136,141,146
    cloudbase_rgb      153,158,163
    cloudhighlight_rgb 170,175,180
    cloudedge_rgb      187,192,197
tod_end

