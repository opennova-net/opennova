          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
        </FONT>
        <STRING justify="LEFT" vjustify="CENTER">NOVAWORLD</STRING>
      </WINDOW>
      <WINDOW type="static" name="NOVAWORLD_NOTE">
        <POSITION>
          <LEFT>42</LEFT>
          <TOP>90</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>114</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">Online play is not part of this game yet.</STRING>
      </WINDOW>
      <WINDOW type="window" name="NOVAWORLD">
        <POSITION>
          <LEFT>30</LEFT>
          <TOP>130</TOP>
          <RIGHT>770</RIGHT>
          <BOTTOM>530</BOTTOM>
        </POSITION>
      </WINDOW>
      <WINDOW type="button" name="BACK">
        <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
        <ACTION type="POP_SCREEN"></ACTION>
        <POSITION>
          <LEFT>30</LEFT>
          <TOP>548</TOP>
          <RIGHT>220</RIGHT>
          <BOTTOM>582</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <FONT>
          <NAME>%DEF_FONTNAME_LG%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
          <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
          <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
          <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">BACK</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
  </WINDOW>
</SCREEN>
<SCREEN>
  <NAME>MULTI_PLAYER_HOST</NAME>
  <MUSICVAR>8</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">%DEF_IMAGE_DEFAULT_BG%</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="static" name="TITLE">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>16</TOP>
        <RIGHT>600</RIGHT>
        <BOTTOM>72</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%IMPACT_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">HOST A GAME</STRING>
    </WINDOW>
    <WINDOW type="window" name="WRAPPER">
      <POSITION>
        <LEFT>30</LEFT>
        <TOP>76</TOP>
        <RIGHT>770</RIGHT>
        <BOTTOM>530</BOTTOM>
      </POSITION>
      <WINDOW type="radio" name="RADIO_TAB_GENERAL" CHECKED>
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="SHOW">TAB_GENERAL</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_GAME</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_WEAPON</ACTION>
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>0</TOP>
          <RIGHT>116</RIGHT>
          <BOTTOM>28</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">GAME</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="radio" name="RADIO_TAB_GAME">
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="HIDE">TAB_GENERAL</ACTION>
        <ACTION type="WINDOW" state="SHOW">TAB_GAME</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_WEAPON</ACTION>
        <POSITION>
          <LEFT>124</LEFT>
          <TOP>0</TOP>
          <RIGHT>240</RIGHT>
          <BOTTOM>28</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">RULES</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="radio" name="RADIO_TAB_WEAPON">
        <GROUP>1</GROUP>
        <ACTION type="WINDOW" state="HIDE">TAB_GENERAL</ACTION>
        <ACTION type="WINDOW" state="HIDE">TAB_GAME</ACTION>
        <ACTION type="WINDOW" state="SHOW">TAB_WEAPON</ACTION>
        <POSITION>
          <LEFT>248</LEFT>
          <TOP>0</TOP>
          <RIGHT>448</RIGHT>
          <BOTTOM>28</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">CLASSES AND WEAPONS</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="window" name="TAB_GENERAL">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>32</TOP>
          <RIGHT>740</RIGHT>
          <BOTTOM>448</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <WINDOW type="static" name="STATIC_GAME_NAME">
          <POSITION>
            <LEFT>16</LEFT>
            <TOP>12</TOP>
            <RIGHT>156</RIGHT>
