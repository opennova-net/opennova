<SCREEN>
  <NAME>LAN_MULTI_PLAYER</NAME>
  <MUSICVAR>5</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">%DEF_IMAGE_DEFAULT_BG%</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="static" name="TITLE">
      <POSITION>
        <LEFT>40</LEFT>
        <TOP>16</TOP>
        <RIGHT>600</RIGHT>
        <BOTTOM>64</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <FONT>
        <NAME>%IMPACT_FONTNAME%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      </FONT>
      <STRING justify="LEFT" vjustify="CENTER">MULTIPLAYER</STRING>
    </WINDOW>
    <WINDOW type="static" name="SUBTITLE">
      <POSITION>
        <LEFT>42</LEFT>
        <TOP>70</TOP>
        <RIGHT>600</RIGHT>
        <BOTTOM>94</BOTTOM>
      </POSITION>
      <APPEARANCE state="DEFAULT"></APPEARANCE>
      <STRING justify="LEFT" vjustify="CENTER">Play the missions together over your local network.</STRING>
    </WINDOW>
    <WINDOW type="window" name="LAN">
      <POSITION>
        <LEFT>30</LEFT>
        <TOP>110</TOP>
        <RIGHT>770</RIGHT>
        <BOTTOM>530</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="static" name="STATIC_PLAYERCHOICE">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>16</TOP>
          <RIGHT>120</RIGHT>
          <BOTTOM>40</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">PLAYER</STRING>
      </WINDOW>
      <WINDOW type="spinlist" name="PLAYERCHOICE">
        <POSITION>
          <LEFT>154</LEFT>
          <TOP>16</TOP>
          <RIGHT>380</RIGHT>
          <BOTTOM>40</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        <ITEMS justify="CENTER" vjustify="CENTER">
        </ITEMS>
        <SPINUP>
          <POSITION>
            <LEFT>228</LEFT>
            <TOP>0</TOP>
            <RIGHT>252</RIGHT>
            <BOTTOM>24</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">></STRING>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SPINUP>
        <SPINDOWN>
          <POSITION>
            <LEFT>-26</LEFT>
            <TOP>0</TOP>
            <RIGHT>-2</RIGHT>
            <BOTTOM>24</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">&lt;</STRING>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SPINDOWN>
      </WINDOW>
      <WINDOW type="static" name="STATIC_GAMES">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>56</TOP>
          <RIGHT>520</RIGHT>
          <BOTTOM>80</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">GAMES ON YOUR NETWORK</STRING>
      </WINDOW>
      <WINDOW type="list" name="LAN_GAME_LIST">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>84</TOP>
          <RIGHT>520</RIGHT>
          <BOTTOM>400</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        <ITEMS justify="LEFT" vjustify="CENTER">
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        </ITEMS>
        <MIN_ITEM_HEIGHT>26</MIN_ITEM_HEIGHT>
        <SCROLLBAR>
          <POSITION>
            <LEFT>484</LEFT>
            <TOP>0</TOP>
            <RIGHT>500</RIGHT>
            <BOTTOM>316</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <SHUTTLE type="COLOR" state="DEFAULT">%TRIM_COLOR%</SHUTTLE>
          <SHUTTLE type="COLOR" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</SHUTTLE>
          <SHUTTLE type="COLOR" state="SELECTED">%DEF_TEXT_SELECTED_FG%</SHUTTLE>
          <SCROLLUP type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLUP>
          <SCROLLUP type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLUP>
          <SCROLLDOWN type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</SCROLLDOWN>
          <SCROLLDOWN type="COLOR" state="MOUSEOVER">%TRIM_COLOR%</SCROLLDOWN>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SCROLLBAR>
      </WINDOW>
      <WINDOW type="button" name="LAN_SEARCH">
        <POSITION>
          <LEFT>540</LEFT>
          <TOP>84</TOP>
          <RIGHT>720</RIGHT>
          <BOTTOM>114</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">SEARCH</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="LAN_JOINGAME">
        <HOTKEY VIRTUAL>VK_RETURN</HOTKEY>
        <POSITION>
          <LEFT>540</LEFT>
          <TOP>124</TOP>
          <RIGHT>720</RIGHT>
          <BOTTOM>154</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">JOIN</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
      <WINDOW type="button" name="LAN_HOSTGAME">
        <ACTION type="SCREEN" file="mp.mnu">MULTI_PLAYER_HOST</ACTION>
        <POSITION>
          <LEFT>540</LEFT>
          <TOP>196</TOP>
          <RIGHT>720</RIGHT>
          <BOTTOM>226</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <STRING justify="CENTER" vjustify="CENTER">HOST A GAME</STRING>
        <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
      </WINDOW>
    </WINDOW>
    <WINDOW type="button" name="BACK">
      <HOTKEY VIRTUAL>VK_ESCAPE</HOTKEY>
      <ACTION type="POP_SCREEN"></ACTION>
      <POSITION>
        <LEFT>30</LEFT>
        <TOP>548</TOP>
        <RIGHT>220</RIGHT>
        <BOTTOM>582</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
      <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="SELECTED">%DEF_TEXT_SELECTED_FG%</APPEARANCE>
      <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
      <FONT>
        <NAME>%DEF_FONTNAME_LG%</NAME>
        <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
        <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
        <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
        <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
      </FONT>
      <STRING justify="CENTER" vjustify="CENTER">BACK</STRING>
      <SOUND state="MOUSEIN" trigger="MOUSE_OVER">menu.lwf</SOUND>
      <SOUND state="SELECTED" trigger="CLICK_SELECT">menu.lwf</SOUND>
    </WINDOW>
  </WINDOW>
</SCREEN>
<SCREEN>
  <NAME>NW_MULTI_PLAYER</NAME>
  <MUSICVAR>6</MUSICVAR>
  <WINDOW type="window" name="OUTER_MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="IMAGE" state="DEFAULT">%DEF_IMAGE_DEFAULT_BG%</APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="window" name="MAIN">
      <POSITION>
        <LEFT>0</LEFT>
        <TOP>0</TOP>
        <RIGHT>800</RIGHT>
        <BOTTOM>600</BOTTOM>
      </POSITION>
      <WINDOW type="static" name="TITLE">
        <POSITION>
          <LEFT>40</LEFT>
          <TOP>16</TOP>
          <RIGHT>600</RIGHT>
          <BOTTOM>72</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
