<SCREEN>
  <NAME>WEAPON</NAME>
  <MUSICVAR>14</MUSICVAR>
  <WINDOW type="window" name="MAIN">
    <POSITION>
      <LEFT>0</LEFT>
      <TOP>0</TOP>
      <RIGHT>800</RIGHT>
      <BOTTOM>600</BOTTOM>
    </POSITION>
    <APPEARANCE type="CUSTOM" state="DEFAULT"></APPEARANCE>
    <TEXT_RSRC>menutxt.bin</TEXT_RSRC>
    <CURSOR>
      <FILE>newarow1.tga</FILE>
    </CURSOR>
    <FONT>
      <NAME>%DEF_FONTNAME%</NAME>
      <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
      <MOUSEOVER_FG>%DEF_TEXT_MOUSEOVER_FG%</MOUSEOVER_FG>
      <SELECTED_FG>%DEF_TEXT_SELECTED_FG%</SELECTED_FG>
      <DISABLED_FG>%DEF_TEXT_DISABLED_FG%</DISABLED_FG>
    </FONT>
    <WINDOW type="window" name="WEAPON_FRAME">
      <POSITION>
        <LEFT>140</LEFT>
        <TOP>30</TOP>
        <RIGHT>660</RIGHT>
        <BOTTOM>570</BOTTOM>
      </POSITION>
      <APPEARANCE type="COLOR" state="DEFAULT">%COLOR_BLACK%</APPEARANCE>
      <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
      <WINDOW type="static" name="TITLE">
        <POSITION>
          <LEFT>0</LEFT>
          <TOP>6</TOP>
          <RIGHT>520</RIGHT>
          <BOTTOM>50</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <FONT>
          <NAME>%IMPACT_FONTNAME%</NAME>
          <DEFAULT_FG>%DEF_TEXT_FG%</DEFAULT_FG>
        </FONT>
        <STRING justify="CENTER" vjustify="CENTER">ARMORY</STRING>
      </WINDOW>
      <WINDOW type="static" name="STATIC_PLAYER_CLASS">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>50</TOP>
          <RIGHT>160</RIGHT>
          <BOTTOM>74</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">CLASS</STRING>
      </WINDOW>
      <WINDOW type="spinlist" name="PLAYER_CLASS">
        <POSITION>
          <LEFT>290</LEFT>
          <TOP>50</TOP>
          <RIGHT>474</RIGHT>
          <BOTTOM>74</BOTTOM>
        </POSITION>
        <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
        <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
        <APPEARANCE type="COLOR" state="DISABLED">%SEMIOPAQUE_BLACK%</APPEARANCE>
        <APPEARANCE type="OUTLINE" state="DISABLED">%TRIM_COLOR%</APPEARANCE>
        <SOUND state="MOUSEIN" trigger="MOVER_COMBO">menu.lwf</SOUND>
        <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        <ITEMS justify="CENTER" vjustify="CENTER">
        </ITEMS>
        <SPINUP>
          <POSITION>
            <LEFT>186</LEFT>
            <TOP>0</TOP>
            <RIGHT>210</RIGHT>
            <BOTTOM>24</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">></STRING>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SPINUP>
        <SPINDOWN>
          <POSITION>
            <LEFT>-26</LEFT>
            <TOP>0</TOP>
            <RIGHT>-2</RIGHT>
            <BOTTOM>24</BOTTOM>
          </POSITION>
          <APPEARANCE type="COLOR" state="DEFAULT">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="DEFAULT">%TRIM_COLOR%</APPEARANCE>
          <APPEARANCE type="COLOR" state="MOUSEOVER">%SEMIOPAQUE_BLACK%</APPEARANCE>
          <APPEARANCE type="OUTLINE" state="MOUSEOVER">%DEF_TEXT_MOUSEOVER_FG%</APPEARANCE>
          <APPEARANCE type="COLOR" state="SELECTED">%ITEM_SELECTED_BG%</APPEARANCE>
          <STRING justify="CENTER" vjustify="CENTER">&lt;</STRING>
          <SOUND state="SELECTED" trigger="CLICK_VALUE">menu.lwf</SOUND>
        </SPINDOWN>
      </WINDOW>
      <WINDOW type="static" name="STATIC_PRIMARY">
        <POSITION>
          <LEFT>20</LEFT>
          <TOP>80</TOP>
          <RIGHT>226</RIGHT>
          <BOTTOM>102</BOTTOM>
        </POSITION>
        <APPEARANCE state="DEFAULT"></APPEARANCE>
        <STRING justify="LEFT" vjustify="CENTER">PRIMARY</STRING>
