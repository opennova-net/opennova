IMPACT_FONTNAME				IMPACT50.fnt

DEF_TEXT_FG					FFFFFFFF
DEF_TEXT_MOUSEOVER_FG		FFFF0000
DEF_TEXT_SELECTED_FG		FFFF0000
DEF_TEXT_DISABLED_FG		FF545252

TRIM_COLOR					FF3870BF
ITEM_SELECTED_BG			7f1E6DF3

COLOR_BLACK					ff000000
SEMIOPAQUE_BLACK			2f000000

DEF_IMAGE_DEFAULT_BG		JO_EPIL.TGA