////////////////////////////////////////////////////////////////////////////////
//
// Avatars.def in JO's shape, authored for the avatars tests (fixtures/README.md)
//
////////////////////////////////////////////////////////////////////////////////
// voice (attached to heads)
//		1   BM1	=	first voice
//		2	BM2	=	second voice
//
// The constructs JO's table uses: banners, tab alignment, a comment after a
// header and after a value, quoted names holding blanks and a '-', ids
// spelled N00 / D00 / 001, a trailing "skipdemo" after a nationality's and a
// division's name, and a second set of parts below the good nationalities
// with the evil one under it.
////////////////////////////////////////////////////////////////////////////////


//////// heads ////////

define head		JO_HEAD_SEAL
{
	name		AV_BOONIEHAT
	graphic		Boonie.3di
	camo		0 0 0
	voice		1
	sex			m
}

define head		JO_HEAD_SEAL_CAMO_1
{
	name		AV_BOONIEHAT
	graphic		Boonie.3di
	camo		3 0 0
