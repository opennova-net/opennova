//////// nationalities ////////

nationality  N00  AV_NAT_UNITEDSTATES
{
	alignment	good

	division  D00  AV_DIV_SEAL skipdemo
	{
		combo	001		JO_HEAD_SEAL		JO_BODY_SEAL_1		JO_ARMS_US_1
		combo	002		JO_HEAD_SEAL_CAMO_1	JO_BODY_SEAL_2		JO_ARMS_US_1
		combo	003		JO_HEAD_MASK		JO_BODY_SEAL_1		JO_ARMS_US_2
		combo	004		JO_HEAD_COMBAT		JO_BODY_SEAL_2		JO_ARMS_BARE
	}
	division  D01  AV_DIV_DELTAFORCE skipdemo
	{
		combo	001		JO_HEAD_COMBAT		JO_BODY_SEAL_1		JO_ARMS_US_1
	}
	division  D02  AV_DIV_FORCERECON
	{
		combo	001		JO_HEAD_MASK		JO_BODY_SEAL_2		JO_ARMS_US_2
	}
	division  D03  AV_DIV_RANGER
	{
		combo	001		JO_HEAD_SEAL		JO_BODY_SEAL_2		JO_ARMS_US_1
	}
	division  D04  AV_DIV_GREENBERET skipdemo
	{
		combo	001		JO_HEAD_COMBAT		JO_BODY_SEAL_2		JO_ARMS_US_2
	}
	division  D05  AV_DIV_USMC skipdemo
	{
		combo	001		JO_HEAD_SEAL		JO_BODY_SEAL_1		JO_ARMS_BARE
	}
	division  D06  AV_DIV_ARMY
	{
		combo	001		JO_HEAD_MASK		JO_BODY_SEAL_1		JO_ARMS_US_1
	}
	division  D07  AV_DIV_PILOT skipdemo
	{
		combo	001		JO_HEAD_COMBAT		JO_BODY_SEAL_1		JO_ARMS_US_2
	}
	division  D08  AV_DIV_USAFCOMBATOP skipdemo
	{
		combo	001		JO_HEAD_FEMALE_BERET	JO_BODY_FEMALE_1	JO_ARMS_US_1
	}
}

nationality  N01  AV_NAT_GREATBRITAIN  skipdemo
{
	alignment	good

	division  D00  AV_DIV_SAS
	{
		combo	001		JO_HEAD_COMBAT		JO_BODY_SEAL_2		JO_ARMS_US_1
		combo	002		JO_HEAD_FEMALE_BERET	JO_BODY_FEMALE_1	JO_ARMS_BARE
	}
}

nationality  N04  AV_NAT_RUSSIA  skipdemo
{
	alignment	good

	division  D00  AV_DIV_SPETSNAZ
	{
		combo	001		JO_HEAD_MASK		JO_BODY_SEAL_2		JO_ARMS_US_2
	}
}


